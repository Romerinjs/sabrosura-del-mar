---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCard from '../components/home/ContactCard.astro';
import VenuesShowcase from '../components/home/VenuesShowcase.astro';
import { getEntry, getCollection } from 'astro:content';

const contacto = (await getEntry('landing', 'contacto'))?.data;
const sedes = await getCollection('sedes');
---

<BaseLayout
  title="Contacto y atención al cliente | La Sabrosura del Mar"
  description="Comunícate con La Sabrosura del Mar en Armenia. Teléfono, WhatsApp, domicilios y direcciones de nuestras sedes Centro y Norte."
  canonicalUrl="https://lasabrosuradelmar.com/contacto"
  activePage="inicio"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-sr data-sr-instant data-sr-delay="0.06">Canales de atención</span>
      <h1 data-sr data-sr-instant data-sr-delay="0.16">Contacto</h1>
      <p data-sr data-sr-instant data-sr-delay="0.26">Estamos disponibles para resolver tus dudas y atender tus pedidos en Armenia.</p>
    </div>
  </section>

  {contacto && (
    <ContactCard
      eyebrow={contacto.eyebrow}
      title={contacto.title}
      titleEmphasis={contacto.titleEmphasis}
      lead={contacto.lead}
      avisoReservas={contacto.avisoReservas}
    />
  )}

  <section class="section" id="sedes" style="padding-top:1rem">
    <div class="container">
      <div class="section-head section-head--center" data-sr data-sr-direction="up">
        <span class="eyebrow">Dónde encontrarnos</span>
        <h2>Direcciones de nuestras dos sedes</h2>
        <p>Visítanos en nuestras dos ubicaciones estratégicas en Armenia o comunícate directamente con la sede de tu preferencia.</p>
      </div>

      <div data-sr data-sr-delay="0.1">
        <VenuesShowcase sedes={sedes} />
      </div>
    </div>
  </section>
</BaseLayout>
