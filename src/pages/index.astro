---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Intro from '../components/home/Intro.astro';
import PlatosDestacadosCarousel from '../components/home/PlatosDestacadosCarousel.astro';
import Diferenciales from '../components/home/Diferenciales.astro';
import WaveDivider from '../components/home/WaveDivider.astro';
import Timeline from '../components/home/Timeline.astro';
import VenuesShowcase from '../components/home/VenuesShowcase.astro';
import ContactCard from '../components/home/ContactCard.astro';
import CtaAntojo from '../components/home/CtaAntojo.astro';

// Cargar módulos MDX
const site = (await getEntry('meta', 'site'))?.data;
const hero = (await getEntry('landing', 'hero'))?.data;
const intro = (await getEntry('landing', 'intro'))?.data;
const diferenciales = (await getEntry('landing', 'diferenciales'))?.data;
const historia = (await getEntry('landing', 'historia'))?.data;
const platosDestacados = (await getEntry('landing', 'platos-destacados'))?.data;
const contacto = (await getEntry('landing', 'contacto'))?.data;
const sedes = await getCollection('sedes');

// Schema.org Restaurant para ambas sedes
const schemaJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Restaurant',
      '@id': 'https://lasabrosuradelmar.com/#sede-centro',
      name: 'La Sabrosura del Mar — Sede Centro',
      servesCuisine: ['Comida de mar', 'Colombiana', 'Costeña'],
      priceRange: '$$',
      currenciesAccepted: 'COP',
      image: 'https://lasabrosuradelmar.com/assets/mojarra-frita.jpg',
      logo: 'https://lasabrosuradelmar.com/assets/logo.png',
      url: 'https://lasabrosuradelmar.com/',
      hasMenu: 'https://lasabrosuradelmar.com/carta',
      telephone: '+57 311 309 3429',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Cra. 13 #21-32',
        addressLocality: 'Armenia',
        addressRegion: 'Quindío',
        addressCountry: 'CO',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '11:00',
          closes: '17:00',
        },
      ],
      acceptsReservations: 'False',
      sameAs: [
        'https://www.instagram.com/lasabrosuradelmar',
        'https://www.facebook.com/lasabrosuradelmar',
        'https://www.tiktok.com/@lasabrosuradelmar',
      ],
    },
    {
      '@type': 'Restaurant',
      '@id': 'https://lasabrosuradelmar.com/#sede-norte',
      name: 'La Sabrosura del Mar — Sede Norte',
      servesCuisine: ['Comida de mar', 'Colombiana', 'Costeña'],
      priceRange: '$$',
      currenciesAccepted: 'COP',
      image: 'https://lasabrosuradelmar.com/assets/camarones-apanados.jpg',
      logo: 'https://lasabrosuradelmar.com/assets/logo.png',
      url: 'https://lasabrosuradelmar.com/',
      hasMenu: 'https://lasabrosuradelmar.com/carta',
      telephone: '+57 311 309 3429',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Cra. 19 #15 Norte-40, sector Proviteq',
        addressLocality: 'Armenia',
        addressRegion: 'Quindío',
        addressCountry: 'CO',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '11:00',
          closes: '17:00',
        },
      ],
      acceptsReservations: 'False',
      amenityFeature: [{ '@type': 'LocationFeatureSpecification', name: 'Parqueadero', value: true }],
    },
  ],
};
---

<BaseLayout
  title={site?.title}
  description={site?.description}
  ogImage={site?.ogImage}
  canonicalUrl={site?.canonicalUrl}
  activePage="inicio"
  jsonLd={schemaJsonLd}
>
  {hero && (
    <Hero
      eyebrow={hero.eyebrow}
      title={hero.title}
      subtitleLine1={hero.subtitleLine1}
      subtitleLine2={hero.subtitleLine2}
      subtitleEmphasis={hero.subtitleEmphasis}
      lead={hero.lead}
      image={hero.image}
      ctas={hero.ctas}
    />
  )}

  {intro && (
    <Intro
      figure={intro.figure}
      ctas={intro.ctas}
    />
  )}

  {platosDestacados && (
    <PlatosDestacadosCarousel
      eyebrow={platosDestacados.eyebrow}
      title={platosDestacados.title}
      lead={platosDestacados.lead}
      platos={platosDestacados.platos}
      cta={platosDestacados.cta}
    />
  )}

  {diferenciales && (
    <>
      <WaveDivider position="top" fill="#07192d" />
      <Diferenciales
        eyebrow={diferenciales.eyebrow}
        title={diferenciales.title}
        diferenciales={diferenciales.diferenciales}
      />
      <WaveDivider position="bottom" fill="#07192d" />
    </>
  )}

  {historia && (
    <Timeline
      eyebrow={historia.eyebrow}
      title={historia.title}
      lead={historia.lead}
      logo={historia.logo}
      timeline={historia.timeline}
      conclusion={historia.conclusion}
    />
  )}

  <section class="section" id="sedes">
    <div class="container">
      <div class="section-head section-head--center" data-sr data-sr-direction="up">
        <span class="eyebrow">Sedes</span>
        <h2>Dos sedes, el mismo sabor</h2>
        <p>Elige la sede más conveniente y disfruta nuestra carta de comida de mar en Armenia.</p>
      </div>

      <div data-sr data-sr-delay="0.1">
        <VenuesShowcase sedes={sedes} />
      </div>
    </div>
  </section>

  <!-- Sección Se Te Antojó (CTA Band con podio de 3 platos PNG) -->
  <CtaAntojo />

  {contacto && (
    <ContactCard
      eyebrow={contacto.eyebrow}
      title={contacto.title}
      titleEmphasis={contacto.titleEmphasis}
      lead={contacto.lead}
      avisoReservas={contacto.avisoReservas}
    />
  )}
</BaseLayout>
