---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import DishCard from '../components/home/DishCard.astro';
import { getEntry } from 'astro:content';

const platosDestacados = (await getEntry('landing', 'platos-destacados'))?.data;
const platosDomicilio = platosDestacados?.platos.slice(0, 4) || [];
---

<BaseLayout
  title="Pedir al restaurante | La Sabrosura del Mar — Armenia, Quindío"
  description="Comunícate directamente con La Sabrosura del Mar por WhatsApp para realizar tu pedido o consultar nuestra carta digital en Armenia, Quindío."
  canonicalUrl="https://lasabrosuradelmar.com/domicilios"
  activePage="carta"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-sr data-sr-instant data-sr-delay="0.06">Atención comercial y pedidos</span>
      <h1 data-sr data-sr-instant data-sr-delay="0.16">Comida de mar fresca y deliciosa en Armenia</h1>
      <p data-sr data-sr-instant data-sr-delay="0.26">Disfruta de nuestros pescados frescos, arroces marineros y cazuelas calientes comunicándote directamente con nosotros.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:900px">
      <div style="background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:clamp(1.5rem,4vw,2.5rem);box-shadow:var(--shadow)">
        <h2 style="font-size:var(--step-2);margin-bottom:1rem" data-sr data-sr-direction="up">Cómo pedir al restaurante</h2>
        
        <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));margin-bottom:2rem">
          <div style="background:var(--sand);padding:1.4rem;border-radius:var(--radius)" data-sr data-sr-direction="zoom" data-sr-delay="0.1">
            <strong style="display:block;font-size:1.1rem;color:var(--navy-900);margin-bottom:.4rem">1. Elige tu plato</strong>
            <p style="font-size:.9rem;color:var(--ink-soft);margin:0">Consulta nuestra carta digital completa con precios y fotos actualizadas.</p>
          </div>
          <div style="background:var(--sand);padding:1.4rem;border-radius:var(--radius)" data-sr data-sr-direction="zoom" data-sr-delay="0.2">
            <strong style="display:block;font-size:1.1rem;color:var(--navy-900);margin-bottom:.4rem">2. Escríbenos por WhatsApp</strong>
            <p style="font-size:.9rem;color:var(--ink-soft);margin:0">Envía un mensaje rápido con tu pedido o consulta directamente al asesor.</p>
          </div>
          <div style="background:var(--sand);padding:1.4rem;border-radius:var(--radius)" data-sr data-sr-direction="zoom" data-sr-delay="0.3">
            <strong style="display:block;font-size:1.1rem;color:var(--navy-900);margin-bottom:.4rem">3. Confirmación y disfrute</strong>
            <p style="font-size:.9rem;color:var(--ink-soft);margin:0">Te confirmamos en minutos la preparación para llevar o entrega.</p>
          </div>
        </div>

        <div style="background:var(--teal-100);border:1px solid rgba(14,90,114,0.2);padding:1.2rem 1.5rem;border-radius:var(--radius);margin-bottom:2rem" data-sr data-sr-delay="0.25">
          <h3 style="color:var(--teal-700);margin:0 0 .5rem;font-size:1.1rem">Líneas de atención directa:</h3>
          <p style="margin:0;font-size:1.05rem">
            📲 WhatsApp & Celular: <a href="https://wa.me/573113093429?text=Hola%2C%20estoy%20interesado%20en%20pedir%20al%20restaurante" target="_blank" rel="noopener" style="font-weight:700;color:var(--teal-700)">311 309 3429</a><br />
            ☎️ Teléfono fijo: <a href="tel:+576067477424" style="font-weight:700;color:var(--teal-700)">606 747 7424</a>
          </p>
        </div>

        <div class="btn-row btn-row--center" data-sr data-sr-delay="0.3">
          <a class="btn btn--primary" href="https://wa.me/573113093429?text=Hola%2C%20estoy%20interesado%20en%20pedir%20al%20restaurante" target="_blank" rel="noopener" data-track-event="whatsapp_click" data-track-location="landing_domicilios">
            <Icon name="whatsapp" size={20} />
            Pedir al restaurante por WhatsApp
          </a>
          <a class="btn btn--navy" href="/carta">
            <Icon name="book-open" size={18} />
            Explorar la carta completa
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Platos favoritos -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head section-head--center" data-sr data-sr-direction="up">
        <span class="eyebrow">Los más pedidos</span>
        <h2>Favoritos de nuestra carta</h2>
      </div>

      <div class="dish-grid">
        {platosDomicilio.map((plato: any, idx: number) => (
          <div
            data-sr
            data-sr-direction="zoom"
            data-sr-delay={`${(0.08 + (idx * 0.12)).toFixed(2)}`}
            style="height: 100%; display: flex; flex-direction: column;"
          >
            <DishCard {...plato} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
