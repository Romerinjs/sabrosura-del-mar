---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import MobileNav from '../components/layout/MobileNav.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import MarineWatermark from '../components/common/MarineWatermark.astro';
import '../styles/global.css';
import '../styles/scroll-reveal.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  activePage?: 'inicio' | 'carta' | 'sedes' | 'historia' | 'contacto' | string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const siteOrigin = Astro.site?.origin || 'https://lasabrosuradelmar.com';

const {
  title = "La Sabrosura del Mar | Restaurante de comida de mar en Armenia, Quindío",
  description = "Auténtica comida de mar en Armenia: pescados, cazuelas, ceviches, arroces marineros, camarones y langostinos. Porciones generosas y sabor costeño. Dos sedes: Centro y Norte.",
  ogImage = "/assets/og-image.jpg",
  canonicalUrl = Astro.url.href,
  activePage = 'inicio',
  jsonLd,
} = Astro.props;

// Asegurar URLs absolutas completas para Open Graph (Requisito estricto de WhatsApp, Facebook y Twitter)
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteOrigin).toString();

const absoluteOgImageSquare = new URL('/assets/og-image-square.jpg', siteOrigin).toString();

const absoluteCanonical = canonicalUrl.startsWith('http')
  ? canonicalUrl
  : new URL(canonicalUrl, siteOrigin).toString();

const isPng = ogImage.toLowerCase().endsWith('.png');
const imageMimeType = isPng ? 'image/png' : 'image/jpeg';
---

<!DOCTYPE html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="La Sabrosura del Mar" />
    <meta name="theme-color" content="#0a2540" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="canonical" href={absoluteCanonical} />

    <!-- Open Graph / Facebook / WhatsApp / Telegram -->
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:site_name" content="La Sabrosura del Mar" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteCanonical} />
    
    <!-- Imagen Principal de Alta Resolución (1200x630) -->
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content={imageMimeType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La Sabrosura del Mar - Auténtico sabor costeño en Armenia, Quindío" />

    <!-- Imagen Alternativa Cuadrada para WhatsApp y Miniaturas Móviles (800x800) -->
    <meta property="og:image" content={absoluteOgImageSquare} />
    <meta property="og:image:secure_url" content={absoluteOgImageSquare} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="La Sabrosura del Mar - Restaurante en Armenia" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="La Sabrosura del Mar - Restaurante de comida de mar en Armenia, Quindío" />

    <!-- Metadatos de Negocio / Restaurante (Facebook Graph API) -->
    <meta property="restaurant:contact_info:street_address" content="Cra. 13 #21-32" />
    <meta property="restaurant:contact_info:locality" content="Armenia" />
    <meta property="restaurant:contact_info:region" content="Quindío" />
    <meta property="restaurant:contact_info:postal_code" content="630001" />
    <meta property="restaurant:contact_info:country_name" content="Colombia" />
    <meta property="restaurant:contact_info:phone_number" content="+573113093429" />
    <meta property="restaurant:contact_info:website" content="https://lasabrosuradelmar.com" />
    <meta property="place:location:latitude" content="4.5350" />
    <meta property="place:location:longitude" content="-75.6757" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Preload tipografías locales críticas -->
    <link rel="preload" href="/assets/fonts/fraunces-latin-full-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <Header activePage={activePage} />
    <MobileNav activePage={activePage} />

    <main id="contenido" style="position:relative">
      <MarineWatermark />
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />

    <!-- Script de interactividad ligero y compatible con ClientRouter -->
    <script>
      import { initScrollReveal } from '../utils/scroll-reveal';

      function initLayoutInteractions() {
        // Header scrolled & mobile nav toggle
        const header = document.getElementById('site-header');
        const toggle = document.getElementById('nav-toggle');
        const mobileNav = document.getElementById('mobile-nav');

        const backdrop = document.getElementById('mobile-nav-backdrop');
        const closeBtn = document.getElementById('mobile-nav-close');

        const closeMobileMenu = () => {
          mobileNav?.classList.remove('is-open');
          backdrop?.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };

        const openMobileMenu = () => {
          mobileNav?.classList.add('is-open');
          backdrop?.classList.add('is-open');
          toggle?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };

        if (toggle && mobileNav) {
          const newToggle = toggle.cloneNode(true) as HTMLElement;
          toggle.parentNode?.replaceChild(newToggle, toggle);

          newToggle.addEventListener('click', () => {
            if (mobileNav.classList.contains('is-open')) {
              closeMobileMenu();
            } else {
              openMobileMenu();
            }
          });

          backdrop?.addEventListener('click', closeMobileMenu);
          closeBtn?.addEventListener('click', closeMobileMenu);

          mobileNav.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMobileMenu);
          });
        }

        // Sticky header background transition (scrolling past Hero)
        const updateHeader = () => {
          if (!header) return;
          const hero = document.querySelector('.hero') as HTMLElement | null;
          const threshold = hero ? hero.offsetHeight - 90 : 20;
          if (window.scrollY > threshold) {
            header.classList.add('is-scrolled');
          } else {
            header.classList.remove('is-scrolled');
          }
        };
        window.removeEventListener('scroll', updateHeader);
        window.addEventListener('scroll', updateHeader, { passive: true });
        updateHeader();

        // Efecto 1: Motor Scroll Reveal Universal (data-sr, data-animate, reveal)
        initScrollReveal();

        // Efecto 3: Contador Numérico Animado On-Scroll
        if ('IntersectionObserver' in window) {
          const counters = document.querySelectorAll<HTMLElement>('[data-counter]:not(.counted)');
          const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const targetNum = parseInt(el.getAttribute('data-number') || '0', 10);
                const duration = parseInt(el.getAttribute('data-speed') || '1400', 10);

                if (!el.classList.contains('counted')) {
                  el.classList.add('counted');
                  let startTimestamp: number | null = null;

                  const step = (timestamp: number) => {
                    if (!startTimestamp) startTimestamp = timestamp;
                    const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                    // Curva de desaceleración suave (easeOutQuad)
                    const easeOutProgress = 1 - (1 - progress) * (1 - progress);
                    const currentNum = Math.floor(easeOutProgress * targetNum);

                    el.innerText = currentNum.toString();

                    if (progress < 1) {
                      window.requestAnimationFrame(step);
                    } else {
                      el.innerText = targetNum.toString();
                    }
                  };

                  window.requestAnimationFrame(step);
                }
                counterObserver.unobserve(el);
              }
            });
          }, { threshold: 0.25 });

          counters.forEach((el) => counterObserver.observe(el));
        }

        // Efecto 4: Parallax Ligero a 60fps con requestAnimationFrame
        const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
        if (parallaxEls.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          let ticking = false;
          const handleParallax = () => {
            if (!ticking) {
              window.requestAnimationFrame(() => {
                const scrollY = window.scrollY;
                parallaxEls.forEach((el) => {
                  const speed = parseFloat(el.getAttribute('data-parallax-speed') || '15');
                  const translateY = scrollY * (speed / 1000);
                  el.style.transform = `translate3d(0, ${translateY}px, 0)`;
                });
                ticking = false;
              });
              ticking = true;
            }
          };
          window.removeEventListener('scroll', handleParallax);
          window.addEventListener('scroll', handleParallax, { passive: true });
        }
      }

      // Tracking nativo global para Marketing (GTM / GA4 / Meta Pixel)
      function initTrackingListener() {
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement | null)?.closest('[data-track-event]');
          if (target) {
            const eventName = target.getAttribute('data-track-event');
            const location = target.getAttribute('data-track-location');
            const category = target.getAttribute('data-track-category');
            const product = target.getAttribute('data-track-product');

            const payload = {
              event: eventName,
              trackLocation: location || undefined,
              trackCategory: category || undefined,
              trackProduct: product || undefined,
              timestamp: new Date().toISOString(),
              page: window.location.pathname,
            };

            const win = window as any;
            win.dataLayer = win.dataLayer || [];
            win.dataLayer.push(payload);
          }
        });
      }

      // Inicialización en primera carga y en cada navegación de ClientRouter
      initLayoutInteractions();
      initTrackingListener();
      document.addEventListener('astro:page-load', initLayoutInteractions);
    </script>
  </body>
</html>
