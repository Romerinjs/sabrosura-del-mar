---
import Icon from '../icons/Icon.astro';

interface Props {
  id?: string;
  nombre: string;
  badge?: {
    texto: string;
    tipo: 'gold' | 'teal';
  };
  descripcion?: string;
  direccion: string;
  sector?: string;
  ciudad: string;
  horario?: {
    texto: string;
    detalle: string;
  };
  telefonos?: Array<{
    numero: string;
    tipo: string;
    href: string;
  }>;
  domicilios: boolean;
  parqueadero?: boolean;
  detalleParqueadero?: string;
  mapsUrl: string;
  whatsapp: {
    phone: string;
    mensaje: string;
  };
  imagen?: string;
}

const {
  id,
  nombre,
  direccion,
  sector,
  ciudad,
  domicilios,
  mapsUrl,
  whatsapp,
  imagen = (nombre.toLowerCase().includes('norte') ? '/assets/sede-norte.jpg' : '/assets/sede-centro.jpg'),
} = Astro.props;

const sedeSlug = id ? id.replace('sede-', '') : (nombre.toLowerCase().includes('norte') ? 'norte' : 'centro');
const sedeUrl = `/sedes/${sedeSlug}`;
const waUrl = `https://wa.me/${whatsapp.phone}?text=${encodeURIComponent(whatsapp.mensaje)}`;
---

<article
  class="venue venue--clickable venue--immersive"
  data-venue-card
  data-venue-name={nombre}
  data-venue-url={sedeUrl}
  data-venue-img={imagen}
  tabindex="0"
  role="button"
  aria-label={`Visitar ${nombre}`}
>
  <!-- Foto de fondo inmersiva -->
  <div class="venue__media" aria-hidden="true">
    <img
      src={imagen}
      alt=""
      class="venue__bg-img"
      loading="lazy"
      width="900"
      height="600"
    />
    <div class="venue__overlay"></div>
  </div>

  <!-- Contenido elegante, minimalista y armonioso -->
  <div class="venue__content">
    <!-- Fila superior: Ubicación y flecha indicadora -->
    <div class="venue__top">
      <span class="venue__location-tag">
        <Icon name="map-pin" size={13} />
        {ciudad}
      </span>
      <span class="venue__arrow" aria-hidden="true" title="Visitar sede">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </div>

    <!-- Fila inferior: Título de la sede, dirección y botones rápidos -->
    <div class="venue__bottom">
      <div class="venue__title-group">
        <h3 class="venue__title">{nombre}</h3>
        <p class="venue__address">{direccion} {sector ? `· ${sector}` : ''}</p>
      </div>

      <p class="venue__summary">
        {domicilios
          ? 'Atención en mesa y servicio a domicilio en Armenia · 11:00 a. m. a 5:00 p. m.'
          : 'Atención en mesa · Parqueadero propio vigilado · 11:00 a. m. a 5:00 p. m.'}
      </p>

      <div class="venue__cta-row">
        <span class="venue__btn-visit">
          Visitar sede &rarr;
        </span>
        <a
          class="venue__btn-wa venue-inner-link"
          href={waUrl}
          target="_blank"
          rel="noopener"
          title={domicilios ? 'Pedir a domicilio por WhatsApp' : 'Contactar por WhatsApp'}
        >
          <Icon name="whatsapp" size={15} />
          <span>{domicilios ? 'Pedir a domicilio' : 'WhatsApp'}</span>
        </a>
        <a
          class="venue__link-maps venue-inner-link"
          href={mapsUrl}
          target="_blank"
          rel="noopener"
          title="Ver cómo llegar en Google Maps"
        >
          <Icon name="map-pin" size={14} />
          <span>Cómo llegar</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .venue--immersive {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 12px 35px rgba(5, 20, 35, 0.25);
    display: flex;
    flex-direction: column;
    min-height: 420px;
    background: #07192b;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .venue--clickable:focus-visible {
    outline: 3px solid var(--gold-400);
    outline-offset: 3px;
  }

  /* Capa de fondo con imagen */
  .venue__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .venue__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.01);
    transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .venue:hover .venue__bg-img {
    transform: scale(1.05);
  }

  /* Escudo degradado continuo para alta armonía y legibilidad */
  .venue__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 20, 35, 0.22) 0%,
      rgba(5, 20, 35, 0.42) 38%,
      rgba(5, 20, 35, 0.82) 75%,
      rgba(5, 20, 35, 0.95) 100%
    );
    transition: background 0.45s ease;
  }

  .venue:hover .venue__overlay {
    background: linear-gradient(
      180deg,
      rgba(5, 20, 35, 0.14) 0%,
      rgba(5, 20, 35, 0.35) 38%,
      rgba(5, 20, 35, 0.76) 75%,
      rgba(5, 20, 35, 0.92) 100%
    );
  }

  /* Capa de contenido */
  .venue__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: clamp(1.25rem, 2.8vw, 1.8rem);
  }

  .venue__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .venue__location-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: #e2e8f0;
    background: rgba(5, 20, 35, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .venue__location-tag :global(svg) {
    color: var(--gold-400);
  }

  .venue__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(5, 20, 35, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
  }

  .venue:hover .venue__arrow {
    transform: translateX(4px);
    background: var(--gold-500);
    color: var(--navy-950);
    border-color: var(--gold-400);
  }

  .venue__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .venue__title-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .venue__title {
    font-family: var(--font-display, serif);
    font-size: clamp(1.6rem, 2.8vw, 2.15rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.15;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
  }

  .venue__address {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--gold-300);
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  .venue__summary {
    font-size: 0.86rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.4;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  .venue__cta-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.35rem;
    flex-wrap: wrap;
  }

  .venue__btn-visit {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--gold-500);
    color: var(--navy-950);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 750;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(217, 154, 63, 0.35);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .venue:hover .venue__btn-visit {
    transform: translateX(2px);
    background: #fbb034;
  }

  .venue__btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(37, 211, 102, 0.22);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(37, 211, 102, 0.45);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .venue__btn-wa:hover {
    background: rgba(37, 211, 102, 0.95);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .venue__link-maps {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #cbd5e1;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    transition: color 0.18s ease;
  }

  .venue__link-maps:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 880px) {
    .venue--immersive {
      min-height: 380px;
    }
  }
</style>
