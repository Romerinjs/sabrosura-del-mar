---
interface Props {
  eyebrow: string;
  title: string;
  subtitleLine1?: string;
  subtitleLine2?: string;
  subtitleEmphasis?: string;
  lead: string;
  ctas: {
    primary: { label: string; href: string };
    secondary: { label: string; href: string };
  };
}

const {
  eyebrow,
  title,
  subtitleLine1 = "Auténtica comida",
  subtitleLine2 = "de mar en",
  subtitleEmphasis = "Armenia",
  lead,
  ctas,
} = Astro.props;

// Imágenes del slider principal: espacios, equipo y platos destacados
const heroSlides = [
  { src: "/espacios/espacios-13.webp", alt: "Instalaciones de La Sabrosura del Mar" },
  { src: "/espacios/espacios-18.webp", alt: "Ambiente y espacios de La Sabrosura del Mar" },
  { src: "/equipo/equipo-9.webp", alt: "Ambiente y espacios de La Sabrosura del Mar" },
  { src: "/carta/cazuela-de-mariscos/plato-90.webp", alt: "Cazuela de mariscos tradicional" },
  { src: "/espacios/espacios-10.webp", alt: "Ambiente acogedor de nuestro restaurante" },
  { src: "/carta/mojarra-frita/plato-85.webp", alt: "Pescado frito crujiente de la casa" },
  { src: "/equipo/equipo.webp", alt: "Tradición y calidez en el servicio" },
  { src: "/espacios/espacios-23.webp", alt: "Ambiente cálido e iluminado del restaurante" },
];
---

<section class="hero" id="hero-slider">
  <!-- Fondo cinemático con Slider de 6 imágenes (2 de carta, 2 de espacios, 2 de equipo) -->
  <div class="hero__media">
    {heroSlides.map((slide, idx) => (
      <img
        src={slide.src}
        alt={slide.alt}
        width="1400"
        height="933"
        loading={idx === 0 ? "eager" : "lazy"}
        fetchpriority={idx === 0 ? "high" : "low"}
        class={`hero__bg-img ${idx === 0 ? 'is-active' : ''}`}
        data-hero-slide={idx}
      />
    ))}
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="container">
    <div class="hero__inner">
      <span class="hero__eyebrow" data-sr data-sr-instant data-sr-delay="0.05">{eyebrow}</span>
      <h1 class="hero__title" data-sr data-sr-instant data-sr-delay="0.12">
        {title}
      </h1>
      <div class="hero__subtitle" data-sr data-sr-instant data-sr-delay="0.2">
        <span>{subtitleLine1}</span>
        <span>{subtitleLine2} <em>{subtitleEmphasis}</em></span>
      </div>
      <p class="hero__lead" data-sr data-sr-instant data-sr-delay="0.28">{lead}</p>
      <div class="hero__btn-row" data-sr data-sr-instant data-sr-delay="0.36">
        <a class="btn-hero-primary" href={ctas.primary.href}>
          {ctas.primary.label}
        </a>
        <a class="btn-hero-secondary" href={ctas.secondary.href}>
          {ctas.secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: calc(var(--header-main-h, 74px) + 2.5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
    background: #071a22;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.06);
    filter: brightness(0.85) contrast(1.08);
    transition: opacity 0.6s ease-in-out, transform 4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__bg-img.is-active {
    opacity: 1;
    transform: scale(1.01);
  }

  /* Overlay de viñeta con el nuevo azul institucional (#1b5d76) y bordes abisales más oscuros */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse at center, rgba(27, 93, 118, 0.35) 0%, rgba(7, 26, 34, 0.82) 100%),
      linear-gradient(to top, rgba(4, 13, 18, 0.88) 0%, rgba(27, 93, 118, 0.18) 50%, rgba(4, 13, 18, 0.72) 100%);
  }

  .hero__inner {
    max-width: 68rem;
    margin: 0 auto;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__eyebrow {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    font-weight: 500;
    color: var(--gold-300, #f2b866);
    letter-spacing: 0.16em;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.75);
  }

  .hero__title {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(2rem, 5.2vw, 4.6rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.2rem;
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.9);
    white-space: nowrap;
    width: 100%;
    text-align: center;
  }

  @media (max-width: 540px) {
    .hero__title {
      white-space: normal;
      font-size: clamp(1.8rem, 8.5vw, 2.6rem);
    }
  }

  .hero__subtitle {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(1.2rem, 2.5vw, 1.95rem);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.25;
    margin-bottom: 0;
    text-shadow: 0 3px 20px rgba(0, 0, 0, 0.75);
  }

  .hero__subtitle em {
    font-style: normal;
    color: var(--gold-300, #f2b866);
    text-shadow: 0 0 24px rgba(242, 184, 102, 0.4);
  }

  .hero__lead {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: clamp(0.82rem, 1.25vw, 0.95rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.88);
    max-width: 34rem;
    margin: clamp(2rem, 4.5vw, 3.8rem) auto 1.35rem auto;
    line-height: 1.6;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .hero__btn-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #1b5d76;
    color: #ffffff !important;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.74rem 2.25rem;
    border-radius: 999px;
    border: none;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(27, 93, 118, 0.45);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    background: #134659;
    box-shadow: 0 8px 24px rgba(238, 152, 14, 0.4);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ee980e;
    border: 1.5px solid #ee980e;
    color: #ffffff !important;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.74rem 2.25rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(238, 152, 14, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-secondary:hover {
    background: #cb8008;
    border-color: #cb8008;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(203, 128, 8, 0.45);
  }

  @media (max-width: 600px) {
    .hero__btn-row {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }
    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
    }
  }
</style>

<script>
  function setupHeroSlider() {
    const slides = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
    if (!slides.length) return;

    let currentIndex = 0;
    let timer: any = null;

    function goToSlide(index: number) {
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      currentIndex = index;
    }

    function nextSlide() {
      const next = (currentIndex + 1) % slides.length;
      goToSlide(next);
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(nextSlide, 3000);
    }

    startTimer();
  }

  setupHeroSlider();
  document.addEventListener('DOMContentLoaded', setupHeroSlider);
  document.addEventListener('astro:page-load', setupHeroSlider);
</script>
