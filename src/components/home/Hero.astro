---
interface HeroImage {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitleLine1?: string;
  subtitleLine2?: string;
  subtitleEmphasis?: string;
  lead: string;
  image?: HeroImage;
  ctas: {
    primary: { label: string; href: string };
    secondary: { label: string; href: string };
  };
}

const {
  eyebrow,
  title,
  subtitleLine1 = "Auténtica comida",
  subtitleLine2 = "de mar en",
  subtitleEmphasis = "Armenia",
  lead,
  image = { src: "/assets/hero-paella.jpg", alt: "La Sabrosura del Mar" },
  ctas,
} = Astro.props;
---

<section class="hero">
  <!-- Fondo cinemático con imagen paella de mariscos -->
  <div class="hero__media">
    <img
      src={image.src}
      alt={image.alt || title}
      width={image.width || 1400}
      height={image.height || 933}
      fetchpriority="high"
      loading="eager"
      class="hero__bg-img"
    />
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="container">
    <div class="hero__inner">
      <span class="hero__eyebrow" data-sr data-sr-instant data-sr-delay="0.05">{eyebrow}</span>
      <h1 class="hero__title" data-sr data-sr-instant data-sr-delay="0.12">
        {title}
      </h1>
      <div class="hero__subtitle" data-sr data-sr-instant data-sr-delay="0.2">
        <span>{subtitleLine1}</span>
        <span>{subtitleLine2} <em>{subtitleEmphasis}</em></span>
      </div>
      <p class="hero__lead" data-sr data-sr-instant data-sr-delay="0.28">{lead}</p>
      <div class="hero__btn-row" data-sr data-sr-instant data-sr-delay="0.36">
        <a class="btn-hero-primary" href={ctas.primary.href}>
          {ctas.primary.label}
        </a>
        <a class="btn-hero-secondary" href={ctas.secondary.href}>
          {ctas.secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: calc(var(--header-main-h, 74px) + 2.5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
    background: #051423;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.04);
    filter: brightness(0.9) contrast(1.08);
    transition: transform 6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero:hover .hero__bg-img {
    transform: scale(1);
  }

  /* Overlay de viñeta oscura para legibilidad impecable del texto centrado */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse at center, rgba(10, 37, 64, 0.35) 0%, rgba(5, 18, 32, 0.78) 100%),
      linear-gradient(to top, rgba(5, 18, 32, 0.85) 0%, rgba(5, 18, 32, 0.25) 50%, rgba(5, 18, 32, 0.65) 100%);
  }

  .hero__inner {
    max-width: 68rem;
    margin: 0 auto;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__eyebrow {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    font-weight: 500;
    color: var(--gold-300, #f2b866);
    letter-spacing: 0.16em;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.75);
  }

  .hero__title {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(2rem, 5.2vw, 4.6rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.2rem;
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.9);
    white-space: nowrap;
    width: 100%;
    text-align: center;
  }

  @media (max-width: 540px) {
    .hero__title {
      white-space: normal;
      font-size: clamp(1.8rem, 8.5vw, 2.6rem);
    }
  }

  .hero__subtitle {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(1.2rem, 2.5vw, 1.95rem);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.25;
    margin-bottom: 0;
    text-shadow: 0 3px 20px rgba(0, 0, 0, 0.75);
  }

  .hero__subtitle em {
    font-style: normal;
    color: var(--gold-300, #f2b866);
    text-shadow: 0 0 24px rgba(242, 184, 102, 0.4);
  }

  .hero__lead {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: clamp(0.82rem, 1.25vw, 0.95rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.88);
    max-width: 34rem;
    margin: clamp(2.5rem, 5.5vw, 4.8rem) auto 1.35rem auto;
    line-height: 1.6;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .hero__btn-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    color: #0a2540 !important;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.74rem 2.25rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    background: #fbfbfb;
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.3);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(118, 30, 24, 0.45);
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    color: #ffffff !important;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.74rem 2.25rem;
    border-radius: 999px;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-secondary:hover {
    background: rgba(148, 40, 30, 0.75);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .hero__btn-row {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }
    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
    }
  }
</style>
