---
interface Props {
  position: 'top' | 'bottom';
  fill?: string;
  height?: string;
}

const { position, fill = '#0a2540', height = '70px' } = Astro.props;
---

{position === 'top' ? (
  <svg class="wave-divider wave-divider--top" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" style={`height:${height}`}>
    <path fill={fill} d="M0,45 C240,95 480,0 720,25 C960,50 1200,95 1440,55 L1440,90 L0,90 Z"></path>
  </svg>
) : (
  <svg class="wave-divider wave-divider--bottom" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" style={`height:${height}`}>
    <path fill={fill} d="M0,0 L1440,0 L1440,35 C1200,-5 960,60 720,45 C480,30 240,0 0,45 Z"></path>
  </svg>
)}
