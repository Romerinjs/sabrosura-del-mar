---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  eyebrow = "¿Se te antojó?",
  title = "Nuestras Especialidades Estrella",
  subtitle = "Selecciona cualquier plato de la baraja para explorar su sabor auténtico.",
} = Astro.props;

const cards = [
  {
    id: 'ceviche',
    title: 'Ceviche de Camarón',
    img: '/carta/ceviche-de-camaron/plato-54.webp',
    alt: 'Ceviche de camarón fresco',
    link: '/carta/entradas',
  },
  {
    id: 'mojarra',
    title: 'Mojarra Frita Dorada',
    img: '/carta/mojarra-frita/plato-85.webp',
    alt: 'Mojarra frita crujiente',
    link: '/carta/pescados',
  },
  {
    id: 'cazuela',
    title: 'Cazuela de Mariscos',
    img: '/carta/cazuela-de-mariscos/plato-90.webp',
    alt: 'Cazuela de mariscos en cuenco de hierro',
    link: '/carta/cazuelas',
  },
];
---

<section class="cta-antojo-section" id="se-te-antojo">
  <!-- Fondo cinemático ambiental -->
  <div class="cta-antojo__bg" aria-hidden="true">
    <img
      src="/espacios/espacios-10.webp"
      alt=""
      role="presentation"
      width="1920"
      height="1080"
      loading="lazy"
      class="cta-antojo__bg-img"
    />
    <div class="cta-antojo__overlay"></div>
  </div>

  <div class="antojo-container">
    <!-- Encabezado -->
    <div class="cta-antojo__header" data-sr data-sr-direction="up">
      <span class="cta-antojo__eyebrow">{eyebrow}</span>
      <h2 class="cta-antojo__title">{title}</h2>
      <p class="cta-antojo__subtitle">{subtitle}</p>
    </div>

    <!-- Baraja Interactivas de Cartas (Deck of Cards) -->
    <div class="antojo-deck-wrapper" data-sr data-sr-direction="up" data-sr-delay="0.15">
      <div class="antojo-deck" id="antojoDeck">
        {cards.map((card, index) => (
          <article
            class={`deck-card ${index === 1 ? 'is-active' : index === 0 ? 'is-left' : 'is-right'}`}
            data-index={index}
            tabindex="0"
            role="button"
            aria-label={`Ver ${card.title}`}
          >
            <!-- Imagen superior del plato original -->
            <div class="deck-card__img-box">
              <img
                src={card.img}
                alt={card.alt}
                width="400"
                height="300"
                loading="lazy"
                class="deck-card__img"
              />
            </div>

            <!-- Contenido de la carta -->
            <div class="deck-card__body">
              <div class="deck-card__header">
                <h3 class="deck-card__title">{card.title}</h3>
              </div>
              
              <div class="deck-card__footer">
                <a href={card.link} class="deck-card__btn">
                  <span>Explorar plato</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Indicadores de punto -->
      <div class="deck-hint">
        <span class="deck-hint__dot" data-dot="0"></span>
        <span class="deck-hint__dot is-active" data-dot="1"></span>
        <span class="deck-hint__dot" data-dot="2"></span>
      </div>
    </div>

    <!-- Botones de Acción Global -->
    <div class="cta-antojo__btn-row" data-sr data-sr-direction="up" data-sr-delay="0.25">
      <a class="btn-antojo-primary" href="/carta">
        Ver Carta Completa
      </a>
      <a
        class="btn-antojo-whatsapp"
        href="https://wa.me/573113093429?text=Hola%2C%20quisiera%20pedir%20un%20domicilio%20de%20comida%20de%20mar"
        target="_blank"
        rel="noopener"
        data-track-event="whatsapp_click"
        data-track-location="cta_antojo"
      >
        Pedir por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  function initDeck() {
    const deck = document.getElementById('antojoDeck');
    if (!deck) return;

    const cards = Array.from(deck.querySelectorAll('.deck-card'));
    const dots = Array.from(document.querySelectorAll('.deck-hint__dot'));

    function updateDeck(activeIndex: number) {
      const total = cards.length;
      cards.forEach((card, idx) => {
        card.classList.remove('is-active', 'is-left', 'is-right');

        if (idx === activeIndex) {
          card.classList.add('is-active');
        } else if (idx === (activeIndex - 1 + total) % total) {
          card.classList.add('is-left');
        } else {
          card.classList.add('is-right');
        }
      });

      dots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === activeIndex);
      });
    }

    cards.forEach((card, index) => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.deck-card__btn')) {
          return;
        }
        updateDeck(index);
      });

      card.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          const target = ke.target as HTMLElement;
          if (target.closest('.deck-card__btn')) return;
          ke.preventDefault();
          updateDeck(index);
        }
      });
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        updateDeck(index);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDeck);
  } else {
    initDeck();
  }
  document.addEventListener('astro:page-load', initDeck);
</script>

<style>
  .cta-antojo-section {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3.5rem, 5.5vw, 5rem);
    padding-bottom: clamp(3.5rem, 5.5vw, 5rem);
    background: #040d18;
    color: #ffffff;
    isolation: isolate;
  }

  /* Fondo cinemático ambiental del restaurante */
  .cta-antojo__bg {
    position: absolute;
    inset: 0;
    z-index: -5;
    overflow: hidden;
  }

  .cta-antojo__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 36%;
    filter: brightness(0.85) contrast(1.05);
  }

  .cta-antojo__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(4, 13, 24, 0.35) 0%, rgba(4, 13, 24, 0.65) 85%);
  }

  .antojo-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: clamp(1rem, 2.5vw, 2rem);
    position: relative;
    z-index: 10;
  }

  /* Encabezado */
  .cta-antojo__header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto clamp(2rem, 3.5vw, 2.8rem);
  }

  .cta-antojo__eyebrow {
    display: block;
    font-family: var(--font-display, "Fraunces", Georgia, serif);
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-style: italic;
    font-weight: 500;
    color: var(--gold-300, #d9993c);
    margin-bottom: 0.3rem;
    text-shadow: 0 2px 10px rgba(217, 153, 60, 0.3);
  }

  .cta-antojo__title {
    font-family: var(--font-display, "Fraunces", Georgia, serif);
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 0.6rem 0;
    letter-spacing: -0.01em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.7);
  }

  .cta-antojo__subtitle {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: clamp(0.95rem, 1.3vw, 1.08rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  /* -------------------------------------------------------------
     BARAJA DE CARTAS (DECK OF CARDS INTERACTIVE STACK)
     ------------------------------------------------------------- */
  .antojo-deck-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .antojo-deck {
    position: relative;
    width: 100%;
    max-width: 960px;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
  }

  /* Tarjeta Individual de la Baraja */
  .deck-card {
    position: absolute;
    width: clamp(280px, 28vw, 330px);
    background: linear-gradient(165deg, rgba(16, 32, 54, 0.95) 0%, rgba(7, 16, 28, 0.98) 100%);
    border: 1px solid rgba(217, 153, 60, 0.3);
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75);
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    outline: none;
    transition: transform 0.5s cubic-bezier(0.34, 1.3, 0.64, 1),
                z-index 0.5s ease,
                box-shadow 0.4s ease,
                border-color 0.4s ease,
                opacity 0.4s ease;
  }

  .deck-card:focus-visible {
    border-color: var(--gold-300, #d9993c);
    box-shadow: 0 0 0 3px rgba(217, 153, 60, 0.5);
  }

  /* ESTADO: CARTA ACTIVA (AL FRENTE EN EL CENTRO) */
  .deck-card.is-active {
    z-index: 20;
    transform: translateX(0) translateY(-10px) scale(1.06) rotate(0deg);
    border-color: var(--gold-300, #d9993c);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.88), 0 0 30px rgba(217, 153, 60, 0.25);
    opacity: 1;
  }

  /* ESTADO: CARTA IZQUIERDA (INCLINADA Y DETRÁS) */
  .deck-card.is-left {
    z-index: 10;
    transform: translateX(-54%) translateY(12px) scale(0.92) rotate(-9deg);
    border-color: rgba(255, 255, 255, 0.15);
    opacity: 0.86;
  }

  .deck-card.is-left:hover {
    transform: translateX(-56%) translateY(2px) scale(0.95) rotate(-6deg);
    opacity: 0.98;
    z-index: 15;
  }

  /* ESTADO: CARTA DERECHA (INCLINADA Y DETRÁS) */
  .deck-card.is-right {
    z-index: 10;
    transform: translateX(54%) translateY(12px) scale(0.92) rotate(9deg);
    border-color: rgba(255, 255, 255, 0.15);
    opacity: 0.86;
  }

  .deck-card.is-right:hover {
    transform: translateX(56%) translateY(2px) scale(0.95) rotate(6deg);
    opacity: 0.98;
    z-index: 15;
  }

  /* Cabecera / Imagen de la tarjeta */
  .deck-card__img-box {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #081524;
  }

  .deck-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .deck-card.is-active .deck-card__img {
    transform: scale(1.05);
  }

  /* Cuerpo de la tarjeta */
  .deck-card__body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .deck-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .deck-card__title {
    font-family: var(--font-display, "Fraunces", Georgia, serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .deck-card__footer {
    margin-top: 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .deck-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--gold-300, #d9993c);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .deck-card__btn:hover {
    color: #ffffff;
    transform: translateX(3px);
  }

  /* Indicador interactivo inferior */
  .deck-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    cursor: pointer;
  }

  .deck-hint__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .deck-hint__dot.is-active {
    width: 24px;
    border-radius: 4px;
    background: var(--gold-300, #d9993c);
  }

  /* Botones de Acción Global */
  .cta-antojo__btn-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-antojo-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #d38e32 0%, #b87522 100%);
    color: #ffffff !important;
    font-family: var(--font-display, "Fraunces", Georgia, serif);
    font-size: 1.05rem;
    font-weight: 500;
    padding: 0.72rem 2.4rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(182, 115, 35, 0.4);
    transition: all 0.25s ease;
  }

  .btn-antojo-primary:hover {
    background: linear-gradient(180deg, #e0983a 0%, #c47e2b 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(182, 115, 35, 0.55);
  }

  .btn-antojo-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 22, 36, 0.35);
    border: 1.8px solid #ffffff;
    color: #ffffff !important;
    font-family: var(--font-display, "Fraunces", Georgia, serif);
    font-size: 1.05rem;
    font-weight: 500;
    padding: 0.7rem 2.4rem;
    border-radius: 999px;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.25s ease;
  }

  .btn-antojo-whatsapp:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  /* Responsive Móvil */
  @media (max-width: 640px) {
    .antojo-deck {
      height: 360px;
    }

    .deck-card {
      width: clamp(260px, 82vw, 300px);
    }

    .deck-card.is-left {
      transform: translateX(-40%) translateY(14px) scale(0.88) rotate(-7deg);
    }

    .deck-card.is-right {
      transform: translateX(40%) translateY(14px) scale(0.88) rotate(7deg);
    }

    .deck-card.is-active {
      transform: translateX(0) translateY(-6px) scale(1.02) rotate(0deg);
    }
  }
</style>

