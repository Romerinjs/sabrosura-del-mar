---
import Icon from '../icons/Icon.astro';

interface Diferencial {
  id: string;
  icono: string;
  titulo: string;
  descripcion: string;
}

interface Props {
  eyebrow: string;
  title: string;
  diferenciales: Diferencial[];
}

const { eyebrow, title, diferenciales } = Astro.props;
---

<section class="section section--navy" style="padding-top:.5rem;padding-bottom:clamp(2rem,4vw,3rem)">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>

    <div class="feature-grid reveal">
      {diferenciales.map((d) => (
        <div class="feature">
          <div class="feature__icon">
            <Icon name={d.icono} size={24} />
          </div>
          <h3>{d.titulo}</h3>
          <p>{d.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>
