---
interface Props {
  eyebrow?: string;
  title?: string;
  figure: {
    src: string;
    alt: string;
    caption?: string;
    width?: number;
    height?: number;
  };
  ctas: {
    primary: { label: string; href: string };
    secondary: { label: string; href: string };
  };
}

const { figure, ctas } = Astro.props;
---

<section class="intro-section" id="bienvenidos">
  <div class="container">
    <!-- Párrafo centrado superior -->
    <div class="intro-header" data-sr data-sr-direction="up">
      <p class="intro-lead-top">
        En <strong>La Sabrosura del Mar</strong> encuentras una carta llena de sabores:<br class="hidden sm:inline" />
        Pescados, cazuelas, ceviches, arroces marineros, camarones, langostinos, pastas y especialidades de la casa.
      </p>
    </div>

    <!-- Cuadrícula de 2 columnas: imagen circular izquierda y declaración con botones derecha -->
    <div class="intro-grid">
      <div class="intro-visual" data-sr data-sr-direction="right" data-sr-delay="0.1">
        <div class="intro-visual__frame">
          <img
            src={figure.src}
            alt={figure.alt}
            width={figure.width || 600}
            height={figure.height || 600}
            loading="lazy"
          />
        </div>
      </div>

      <div class="intro-content" data-sr data-sr-direction="left" data-sr-delay="0.15">
        <h2 class="intro-statement">
          Cada plato combina ingredientes de calidad, pescado fresco y el auténtico sabor costeño para ofrecerte una experiencia auténtica, abundante y llena de sabor.
        </h2>
        <div class="intro-actions">
          <a class="btn-intro-primary" href={ctas.primary.href}>
            {ctas.primary.label}
          </a>
          <a class="btn-intro-secondary" href={ctas.secondary.href}>
            {ctas.secondary.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .intro-section {
    background: #fcf8f2;
    padding-top: clamp(1.8rem, 3.5vw, 3rem);
    padding-bottom: clamp(0.2rem, 1vw, 0.8rem);
    color: #1a2b3c;
    position: relative;
    overflow: hidden;
  }

  .intro-header {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto clamp(0.2rem, 0.6vw, 0.5rem);
  }

  .intro-lead-top {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.6;
    color: #213547;
    margin: 0;
  }

  .intro-lead-top strong {
    font-weight: 700;
    color: #0a2540;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .intro-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .intro-visual__frame {
    width: 100%;
    max-width: 500px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
  }

  .intro-visual__frame img {
    width: 135%;
    max-width: 135%;
    height: auto;
    max-height: 720px;
    object-fit: contain;
    display: block;
    transform: scale(1.32);
    transform-origin: center center;
    filter: drop-shadow(0 26px 44px rgba(12, 13, 23, 0.18));
  }

  .intro-content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .intro-statement {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(1.45rem, 2.6vw, 2.35rem);
    font-weight: 500;
    line-height: 1.35;
    color: #0a2540;
    margin: 0 0 2.2rem 0;
  }

  .intro-actions {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .btn-intro-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #1b5d76;
    color: #ffffff !important;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.96rem;
    font-weight: 600;
    padding: 0.72rem 2.2rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(27, 93, 118, 0.3);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-intro-primary:hover {
    background: #134659;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(27, 93, 118, 0.4);
  }

  .btn-intro-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ee980e;
    border: 1.5px solid #ee980e;
    color: #ffffff !important;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.96rem;
    font-weight: 600;
    padding: 0.72rem 2.2rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(238, 152, 14, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-intro-secondary:hover {
    background: #cb8008;
    border-color: #cb8008;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(203, 128, 8, 0.45);
  }

  @media (max-width: 880px) {
    .intro-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
    }
    .intro-content {
      align-items: center;
      text-align: center;
    }
    .intro-statement {
      text-align: center;
    }
    .intro-actions {
      justify-content: center;
    }
  }
</style>
