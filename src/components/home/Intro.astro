---
interface Props {
  eyebrow: string;
  title: string;
  figure: {
    src: string;
    alt: string;
    caption: string;
    width: number;
    height: number;
  };
  ctas: {
    primary: { label: string; href: string };
    secondary: { label: string; href: string };
  };
}

const { eyebrow, title, figure, ctas } = Astro.props;
---

<section class="section section--sand">
  <div class="container">
    <div class="intro-grid">
      <div data-sr data-sr-direction="left">
        <span class="eyebrow">{eyebrow}</span>
        <h2 style="font-size:var(--step-3)">{title}</h2>
        <slot />
        <div class="btn-row" style="margin-top:1.6rem">
          <a class="btn btn--navy" href={ctas.primary.href}>{ctas.primary.label}</a>
          <a class="btn btn--outline" href={ctas.secondary.href}>{ctas.secondary.label}</a>
        </div>
      </div>
      <figure class="intro-figure" data-sr data-sr-direction="right" data-sr-delay="0.15" style="margin:0">
        <img src={figure.src} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" />
        <figcaption>{figure.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>
