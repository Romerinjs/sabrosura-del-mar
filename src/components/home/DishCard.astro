---
import Icon from '../icons/Icon.astro';

interface Props {
  nombre: string;
  descripcion: string;
  precio: number;
  precioAlt?: number;
  notaPrecio?: string;
  imagen?: string | null;
  alt?: string;
  wide?: boolean;
  destacado?: boolean;
}

const {
  nombre,
  descripcion,
  precio,
  precioAlt,
  notaPrecio,
  imagen,
  alt = '',
  wide = false,
  destacado = false,
} = Astro.props;

const formatMoney = (n: number) => '$' + n.toLocaleString('es-CO');
---

<article class:list={['dish', { 'dish--wide': wide }]}>
  {destacado && wide && <span class="dish__tag">Favorito</span>}

  {imagen ? (
    <div class="dish__media">
      <img src={imagen} alt={alt || nombre} width="800" height="533" loading="lazy" />
    </div>
  ) : (
    <div class="dish__media dish__media--placeholder">
      <div class="ph-inner">
        <Icon name="camera" size={34} />
        <b>{nombre}</b>
        <small>Foto pendiente</small>
      </div>
    </div>
  )}

  <div class="dish__body">
    <h3>{nombre}</h3>
    <p>{descripcion}</p>
    <div class="dish__action-row">
      <div class="dish__price">
        <span>{formatMoney(precio)}</span>
        {precioAlt && (
          <span class="dish__price-alt">
            {notaPrecio ? `${notaPrecio}: ${formatMoney(precioAlt)}` : `Especial: ${formatMoney(precioAlt)}`}
          </span>
        )}
        {!precioAlt && notaPrecio && (
          <span class="dish__price-alt">
            {notaPrecio}
          </span>
        )}
      </div>


      <a
        class="dish__more-link"
        href="/carta"
        title={`Ver ${nombre} en la carta digital`}
        aria-label={`Ver ${nombre} en la carta digital`}
      >
        <span>Ver plato</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .dish {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
  }

  .dish__media {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    background: var(--navy-900);
    overflow: hidden;
    flex-shrink: 0;
  }

  .dish__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .dish:hover .dish__media img {
    transform: scale(1.06);
    filter: brightness(1.025);
  }

  .dish__media--placeholder {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1.25rem;
    aspect-ratio: 4 / 3 !important;
    width: 100% !important;
    height: auto !important;
    flex-shrink: 0 !important;
    background: radial-gradient(120% 120% at 25% 10%, var(--navy-800) 0%, var(--navy-950) 72%);
    color: rgba(255, 255, 255, 0.9);
  }

  .dish__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 1.25rem 1.35rem 1.35rem;
  }

  .dish__body h3 {
    font-size: 1.2rem;
    color: var(--navy-900);
    margin-bottom: 0.45rem;
    line-height: 1.25;
    min-height: 2.85rem;
    display: flex;
    align-items: flex-start;
  }

  .dish__body p {
    flex: 1 1 auto;
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin-bottom: 1.15rem;
  }

  .dish__action-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.65rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line);
    min-height: 50px;
  }

  .dish__price {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 800;
    color: var(--teal-700);
    line-height: 1.1;
    min-width: 0;
    flex: 1 1 auto;
  }

  .dish__price-alt {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.2;
  }

  .dish__more-link {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.35rem !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 650;
    color: var(--navy-900);
    background: var(--sand);
    border: 1px solid var(--line);
    padding: 0.44rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dish__more-link:hover {
    background: var(--navy-900);
    color: #ffffff;
    border-color: var(--navy-900);
    transform: translateX(2px);
  }

  .dish__more-link svg {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .dish__more-link:hover svg {
    transform: translateX(2px);
  }
</style>


