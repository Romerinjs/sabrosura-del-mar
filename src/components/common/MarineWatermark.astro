---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<!-- Estampado náutico / marino sutil de fondo (Watermark Wallpaper SVG) -->
<div class:list={['marine-watermark-bg', className]} aria-hidden="true">
  <!-- Lateral Izquierdo: Siluetas Marinas en contorno ultra fino -->
  <div class="marine-watermark-side marine-watermark-side--left">
    <!-- Pescado Lineal -->
    <svg class="marine-svg-icon icon-fish-1" viewBox="0 0 100 60" fill="none" stroke="currentColor">
      <path d="M10,30 C25,12 60,8 85,30 C60,52 25,48 10,30 Z" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M85,30 L98,16 L94,30 L98,44 Z" stroke-width="1.2" stroke-linejoin="round"/>
      <circle cx="26" cy="27" r="2" fill="currentColor"/>
      <path d="M42,20 C46,26 46,34 42,40" stroke-width="1.1" stroke-linecap="round"/>
      <path d="M52,22 C56,27 56,33 52,38" stroke-width="1.1" stroke-linecap="round"/>
    </svg>

    <!-- Olas Estilizadas -->
    <svg class="marine-svg-icon icon-waves-1" viewBox="0 0 120 40" fill="none" stroke="currentColor">
      <path d="M5,15 C20,5 35,25 50,15 C65,5 80,25 95,15 C105,8 115,12 118,15" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M5,28 C20,18 35,38 50,28 C65,18 80,38 95,28 C105,21 115,25 118,28" stroke-width="1.2" stroke-linecap="round"/>
    </svg>

    <!-- Camarón / Langostino Lineal -->
    <svg class="marine-svg-icon icon-shrimp-1" viewBox="0 0 80 80" fill="none" stroke="currentColor">
      <path d="M55,15 C68,26 65,48 48,60 C32,70 18,65 14,56 C10,48 15,38 25,32 C35,26 48,28 50,34 C52,40 45,46 38,44" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M60,18 C65,12 72,10 76,8 M58,22 C64,20 70,20 75,22" stroke-width="1" stroke-linecap="round"/>
      <path d="M22,62 C16,66 12,68 8,72 M28,60 C25,66 22,70 20,75" stroke-width="1.1" stroke-linecap="round"/>
      <circle cx="56" cy="24" r="1.5" fill="currentColor"/>
    </svg>

    <!-- Concha Marina / Ostra -->
    <svg class="marine-svg-icon icon-shell-1" viewBox="0 0 80 80" fill="none" stroke="currentColor">
      <path d="M40,68 C18,68 12,48 18,30 C24,12 56,12 62,30 C68,48 62,68 40,68 Z" stroke-width="1.2"/>
      <path d="M40,68 L40,16 M40,68 L28,20 M40,68 L52,20 M40,68 L20,32 M40,68 L60,32" stroke-width="1" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- Lateral Derecho: Siluetas Marinas complementarias -->
  <div class="marine-watermark-side marine-watermark-side--right">
    <!-- Cazuela Marina / Taza con vapor -->
    <svg class="marine-svg-icon icon-cazuela" viewBox="0 0 90 70" fill="none" stroke="currentColor">
      <path d="M15,34 C15,55 75,55 75,34 L15,34 Z" stroke-width="1.2"/>
      <path d="M10,34 L80,34" stroke-width="1.3" stroke-linecap="round"/>
      <path d="M8,37 C4,37 4,44 11,44 M82,37 C86,37 86,44 79,44" stroke-width="1.2" stroke-linecap="round"/>
      <!-- Vapor suave -->
      <path d="M32,24 C30,19 34,16 32,10" stroke-width="1.1" stroke-linecap="round"/>
      <path d="M45,26 C43,20 47,15 45,8" stroke-width="1.1" stroke-linecap="round"/>
      <path d="M58,24 C56,19 60,16 58,10" stroke-width="1.1" stroke-linecap="round"/>
    </svg>

    <!-- Pescado 2 nadando en diagonal -->
    <svg class="marine-svg-icon icon-fish-2" viewBox="0 0 100 60" fill="none" stroke="currentColor">
      <path d="M90,30 C75,12 40,8 15,30 C40,52 75,48 90,30 Z" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M15,30 L2,16 L6,30 L2,44 Z" stroke-width="1.2" stroke-linejoin="round"/>
      <circle cx="74" cy="27" r="2" fill="currentColor"/>
      <path d="M58,20 C54,26 54,34 58,40" stroke-width="1.1" stroke-linecap="round"/>
    </svg>

    <!-- Cangrejo estilizado -->
    <svg class="marine-svg-icon icon-crab" viewBox="0 0 80 60" fill="none" stroke="currentColor">
      <ellipse cx="40" cy="36" rx="18" ry="12" stroke-width="1.2"/>
      <!-- Tenazas -->
      <path d="M26,30 C20,20 12,24 16,14 C24,14 26,24 30,28" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M54,30 C60,20 68,24 64,14 C56,14 54,24 50,28" stroke-width="1.2" stroke-linecap="round"/>
      <!-- Patas -->
      <path d="M24,38 C16,42 12,50 14,54 M26,42 C20,48 18,54 22,56" stroke-width="1" stroke-linecap="round"/>
      <path d="M56,38 C64,42 68,50 66,54 M54,42 C60,48 62,54 58,56" stroke-width="1" stroke-linecap="round"/>
      <circle cx="34" cy="28" r="1.5" fill="currentColor"/>
      <circle cx="46" cy="28" r="1.5" fill="currentColor"/>
    </svg>

    <!-- Ancla o timón náutico sutil -->
    <svg class="marine-svg-icon icon-waves-2" viewBox="0 0 120 40" fill="none" stroke="currentColor">
      <path d="M8,18 C23,8 38,28 53,18 C68,8 83,28 98,18 C108,12 116,16 118,18" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M8,28 C23,18 38,38 53,28 C68,18 83,38 98,28 C108,22 116,26 118,28" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  </div>
</div>

<style>
  .marine-watermark-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
    z-index: 0; /* Asegurado detrás del contenido */
  }

  .marine-watermark-side {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(70px, 12vw, 150px);
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
    padding-block: clamp(3rem, 8vh, 6rem);
    color: var(--navy-900);
    opacity: 0.055; /* Estampado sutil de filigrana que no compite con el texto */
    transition: opacity 0.5s ease;
  }

  .marine-watermark-side--left {
    left: clamp(0.2rem, 1.8vw, 2.5rem);
  }

  .marine-watermark-side--right {
    right: clamp(0.2rem, 1.8vw, 2.5rem);
  }

  .marine-svg-icon {
    width: clamp(52px, 6.5vw, 84px);
    height: auto;
    filter: drop-shadow(0 2px 4px rgba(10, 37, 64, 0.04));
    transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
  }

  /* Rotaciones asimétricas orgánicas para aspecto artesanal */
  .icon-fish-1 { transform: rotate(-8deg); }
  .icon-waves-1 { transform: rotate(4deg); }
  .icon-shrimp-1 { transform: rotate(12deg); }
  .icon-shell-1 { transform: rotate(-6deg); }
  .icon-cazuela { transform: rotate(5deg); }
  .icon-fish-2 { transform: rotate(10deg); }
  .icon-crab { transform: rotate(-7deg); }
  .icon-waves-2 { transform: rotate(-3deg); }

  /* En móviles se oculta o se reduce la opacidad para priorizar lectura limpia */
  @media (max-width: 900px) {
    .marine-watermark-side {
      width: 50px;
      opacity: 0.035;
    }
    .marine-svg-icon {
      width: 42px;
    }
  }

  @media (max-width: 600px) {
    .marine-watermark-bg {
      display: none; /* Cero distracciones en pantallas ultra pequeñas */
    }
  }
</style>
