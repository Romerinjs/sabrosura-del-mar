---
interface Props {
  activePage?: 'inicio' | 'carta' | string;
}

const { activePage = 'inicio' } = Astro.props;
const isHome = activePage === 'inicio';
---

<header class:list={['site-header', { 'site-header--home': isHome }]} id="site-header">
  <div class="site-header__main">
    <div class="container site-header__container">
      <a class="brand" href="/" aria-label="La Sabrosura del Mar — inicio">
        <img src="/assets/logo-sm.png" alt="La Sabrosura del Mar" width="160" height="166" />
        <span class="brand__text">La Sabrosura del Mar<span>Armenia, Quindío</span></span>
      </a>

      <nav class="nav" aria-label="Navegación principal">
        <a href="/" aria-current={activePage === 'inicio' ? 'page' : undefined}>Inicio</a>
        <a href="/carta" aria-current={activePage === 'carta' ? 'page' : undefined}>Carta</a>
        <a href="/sedes" aria-current={activePage === 'sedes' ? 'page' : undefined}>Sedes</a>
        <a href="/historia" aria-current={activePage === 'historia' ? 'page' : undefined}>Historia</a>
        <a href="/contacto" aria-current={activePage === 'contacto' ? 'page' : undefined}>Contacto</a>
      </nav>

      <div class="header-actions">
        <a
          class="btn-pide-ya"
          href="https://wa.me/573113093429?text=Hola%2C%20estoy%20interesado%20en%20pedir%20al%20restaurante"
          target="_blank"
          rel="noopener"
          data-track-event="whatsapp_click"
          data-track-location="header_action"
        >
          Pide ya!
        </a>
        <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú">
          <span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    background: rgba(7, 24, 42, 0.96);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }

  /* Estilo de tono claro semi-transparente sobre el Hero (estilo exacto a Imagen 2) */
  .site-header--home {
    background: rgba(168, 155, 138, 0.68);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .site-header--home .nav a {
    color: #ffffff;
    font-weight: 600;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  .site-header--home .btn-pide-ya {
    background: #68230b;
    box-shadow: 0 4px 14px rgba(104, 35, 11, 0.4);
  }

  .site-header--home .btn-pide-ya:hover {
    background: #7d2c0f;
  }

  /* Al hacer scroll pasando el Hero -> Se convierte en el azul oscuro actual */
  .site-header.is-scrolled {
    background: rgba(7, 24, 42, 0.96) !important;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.32);
  }

  .site-header.is-scrolled .nav a {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: none;
  }

  .site-header.is-scrolled .btn-pide-ya {
    background: #944d1e;
    box-shadow: 0 4px 14px rgba(148, 77, 30, 0.35);
  }

  .site-header.is-scrolled .btn-pide-ya:hover {
    background: #aa5b25;
  }

  .site-header__main {
    height: var(--header-main-h, 74px);
    display: flex;
    align-items: center;
    width: 100%;
  }

  .site-header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #ffffff;
    flex-shrink: 0;
  }

  .brand img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 50%;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display, "Fraunces", serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.15;
    color: #ffffff;
  }

  .brand__text span {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--gold-300, #f2b866);
    letter-spacing: 0.04em;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex: 1;
  }

  .nav a {
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: #ffffff;
  }

  .nav a[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold-400, #d99a3f);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  /* Botón Pide ya! estilo referencia */
  .btn-pide-ya {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #944d1e;
    color: #ffffff !important;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.52rem 1.45rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(148, 77, 30, 0.35);
    transition: all 0.25s ease;
  }

  .btn-pide-ya:hover {
    background: #aa5b25;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(148, 77, 30, 0.45);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle span,
  .nav-toggle span::before,
  .nav-toggle span::after {
    display: block;
    width: 24px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  .nav-toggle span {
    position: relative;
  }

  .nav-toggle span::before,
  .nav-toggle span::after {
    content: '';
    position: absolute;
  }

  .nav-toggle span::before {
    top: -7px;
  }

  .nav-toggle span::after {
    bottom: -7px;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
    .brand__text span {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .site-header__main {
      height: 64px;
    }
    .btn-pide-ya {
      padding: 0.42rem 1.1rem;
      font-size: 0.85rem;
    }
  }
</style>
