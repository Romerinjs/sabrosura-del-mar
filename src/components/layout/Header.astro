---
interface Props {
  activePage?: 'inicio' | 'carta' | string;
}

const { activePage = 'inicio' } = Astro.props;
const isHome = activePage === 'inicio';
---

<header class:list={['site-header', { 'site-header--home': isHome }]} id="site-header">
  <div class="site-header__main">
    <div class="container site-header__container">
      <a class="brand" href="/" aria-label="La Sabrosura del Mar — inicio">
        <div class="brand__logo-wrapper">
          <img
            src="/assets/logo.png"
            alt="La Sabrosura del Mar"
            width="160"
            height="166"
            class="brand__logo brand__logo--color"
          />
          <img
            src="/assets/logo-blanco.png"
            alt="La Sabrosura del Mar"
            width="160"
            height="166"
            class="brand__logo brand__logo--white"
          />
        </div>
        <span class="brand__text">La Sabrosura del Mar<span>Armenia, Quindío</span></span>
      </a>

      <nav class="nav" aria-label="Navegación principal">
        <a href="/" aria-current={activePage === 'inicio' ? 'page' : undefined}>Inicio</a>
        <a href="/carta" aria-current={activePage === 'carta' ? 'page' : undefined}>Carta</a>
        <a href="/sedes" aria-current={activePage === 'sedes' ? 'page' : undefined}>Sedes</a>
        <a href="/historia" aria-current={activePage === 'historia' ? 'page' : undefined}>Historia</a>
        <a href="/contacto" aria-current={activePage === 'contacto' ? 'page' : undefined}>Contacto</a>
      </nav>

      <div class="header-actions">
        <a
          class="btn-pide-ya"
          href="https://wa.me/573113093429?text=Hola%2C%20estoy%20interesado%20en%20pedir%20al%20restaurante"
          target="_blank"
          rel="noopener"
          data-track-event="whatsapp_click"
          data-track-location="header_action"
        >
          Pide ya!
        </a>
        <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú">
          <span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    background: rgba(27, 93, 118, 0.96);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    transition: background-color 0.8s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.8s ease, border-color 0.8s ease, color 0.8s ease;
  }

  /* Estilo inicial del header en el Hero de la Home (fondo claro de baja opacidad) */
  .site-header--home:not(.is-scrolled) {
    background: rgba(254, 254, 254, 0.85) !important;
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid rgba(12, 13, 23, 0.12);
    box-shadow: 0 4px 20px rgba(12, 13, 23, 0.08);
  }

  .site-header--home:not(.is-scrolled) .brand__text {
    color: #0c0d17;
  }

  .site-header--home:not(.is-scrolled) .brand__text span {
    color: #cb8008;
  }

  .site-header--home:not(.is-scrolled) .nav a {
    color: #0c0d17;
    font-weight: 600;
    text-shadow: none;
  }

  .site-header--home:not(.is-scrolled) .nav a:hover,
  .site-header--home:not(.is-scrolled) .nav a[aria-current="page"] {
    color: #ee980e;
  }

  .site-header--home:not(.is-scrolled) .btn-pide-ya {
    background: #ee980e;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(238, 152, 14, 0.35);
  }

  .site-header--home:not(.is-scrolled) .btn-pide-ya:hover {
    background: #cb8008;
    color: #ffffff !important;
  }

  .site-header--home:not(.is-scrolled) .nav-toggle span,
  .site-header--home:not(.is-scrolled) .nav-toggle span::before,
  .site-header--home:not(.is-scrolled) .nav-toggle span::after {
    background: #0c0d17;
  }

  /* Al pasar del hero o en otras páginas -> se vuelve del color azul petróleo */
  .site-header.is-scrolled,
  .site-header:not(.site-header--home) {
    background: rgba(27, 93, 118, 0.98) !important;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 24px rgba(12, 13, 23, 0.3);
  }

  .site-header.is-scrolled .brand__text,
  .site-header:not(.site-header--home) .brand__text {
    color: #ffffff;
  }

  .site-header.is-scrolled .brand__text span,
  .site-header:not(.site-header--home) .brand__text span {
    color: var(--gold-300, #ee980e);
  }

  .site-header.is-scrolled .nav a,
  .site-header:not(.site-header--home) .nav a {
    color: rgba(255, 255, 255, 0.95);
    text-shadow: none;
  }

  .site-header.is-scrolled .nav a:hover,
  .site-header:not(.site-header--home) .nav a:hover,
  .site-header.is-scrolled .nav a[aria-current="page"],
  .site-header:not(.site-header--home) .nav a[aria-current="page"] {
    color: #ffffff;
  }

  .site-header.is-scrolled .btn-pide-ya,
  .site-header:not(.site-header--home) .btn-pide-ya {
    background: #ee980e;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(238, 152, 14, 0.4);
  }

  .site-header.is-scrolled .btn-pide-ya:hover,
  .site-header:not(.site-header--home) .btn-pide-ya:hover {
    background: #cb8008;
    color: #ffffff !important;
  }

  .site-header.is-scrolled .nav-toggle span,
  .site-header.is-scrolled .nav-toggle span::before,
  .site-header.is-scrolled .nav-toggle span::after,
  .site-header:not(.site-header--home) .nav-toggle span,
  .site-header:not(.site-header--home) .nav-toggle span::before,
  .site-header:not(.site-header--home) .nav-toggle span::after {
    background: #ffffff;
  }

  .site-header__main {
    height: var(--header-main-h, 74px);
    display: flex;
    align-items: center;
    width: 100%;
  }

  .site-header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #ffffff;
    flex-shrink: 0;
  }

  /* Wrapper del Logo con transición de opacidad de 0.8 seg */
  .brand__logo-wrapper {
    position: relative;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .brand__logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
    transition: opacity 0.8s ease-in-out;
  }

  /* En estado transparente claro (Hero Home no scrolleado): Logo a color activo */
  .site-header--home:not(.is-scrolled) .brand__logo--color {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .site-header--home:not(.is-scrolled) .brand__logo--white {
    opacity: 0 !important;
  }

  /* En estado azul (Scrolleado en Home o páginas secundarias): Logo blanco activo */
  .site-header.is-scrolled .brand__logo--color,
  .site-header:not(.site-header--home) .brand__logo--color {
    opacity: 0 !important;
  }

  .site-header.is-scrolled .brand__logo--white,
  .site-header:not(.site-header--home) .brand__logo--white {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display, "Fraunces", serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.15;
    transition: color 0.8s ease;
  }

  .brand__text span {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: color 0.8s ease;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex: 1;
  }

  .nav a {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.4s ease;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav a[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold-400, #d99a3f);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  /* Botón Pide ya! */
  .btn-pide-ya {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.52rem 1.45rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-pide-ya:hover {
    transform: translateY(-1px);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle span,
  .nav-toggle span::before,
  .nav-toggle span::after {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  .nav-toggle span {
    position: relative;
  }

  .nav-toggle span::before,
  .nav-toggle span::after {
    content: '';
    position: absolute;
  }

  .nav-toggle span::before {
    top: -7px;
  }

  .nav-toggle span::after {
    bottom: -7px;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
    .brand__text span {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .site-header__main {
      height: 64px;
    }
    .btn-pide-ya {
      padding: 0.42rem 1.1rem;
      font-size: 0.85rem;
    }
  }
</style>
