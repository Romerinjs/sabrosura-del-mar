---
interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = "573113093429",
  message = "Hola, quiero hacer un pedido en La Sabrosura del Mar"
} = Astro.props;

const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

