---
interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = "573113093429",
  message = "Hola, estoy interesado en pedir al restaurante"
} = Astro.props;

const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<div class="wa-float-wrap">
  <a class="wa-float" href={url} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" title="Escríbenos directamente por WhatsApp" data-track-event="whatsapp_click" data-track-location="floating_button">
    <span class="wa-float-tooltip">
      <strong>¿Deseas pedir?</strong> Escríbenos
    </span>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.85c0 1.9.5 3.7 1.45 5.3L2 22l4.98-1.6a9.8 9.8 0 0 0 5.06 1.4h.01c5.44 0 9.85-4.4 9.85-9.85C21.9 6.4 17.5 2 12.04 2Zm5.77 14.06c-.24.68-1.4 1.3-1.94 1.35-.5.05-.95.24-3.2-.67-2.7-1.06-4.4-3.8-4.53-3.98-.13-.18-1.08-1.43-1.08-2.73 0-1.3.68-1.94.92-2.2.24-.27.53-.33.7-.33h.5c.16 0 .38-.06.6.46.23.55.78 1.9.85 2.03.07.14.11.3.02.48-.09.18-.14.29-.27.45-.14.16-.29.35-.41.47-.14.13-.28.28-.12.55.16.27.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.27.14.43.11.59-.07.16-.18.68-.79.86-1.06.18-.27.36-.23.6-.14.25.09 1.58.75 1.85.88.27.14.45.2.52.32.07.11.07.65-.17 1.32Z"/>
    </svg>
  </a>
</div>

<style>
  .wa-float-wrap {
    position: fixed;
    right: clamp(1.2rem, 3vw, 2rem);
    bottom: clamp(1.2rem, 3vw, 2rem);
    z-index: 95;
    pointer-events: none;
  }

  .wa-float-wrap .wa-float {
    pointer-events: auto;
    position: static;
  }

  .wa-float-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: #051423;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 4px 14px rgba(5, 20, 35, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wa-float-tooltip strong {
    color: var(--gold-400, #f59e0b);
    font-weight: 700;
  }

  .wa-float-tooltip::after {
    content: "";
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent transparent #051423;
  }

  .wa-float-wrap:hover .wa-float-tooltip,
  .wa-float-wrap.has-hint .wa-float-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 768px) {
    .wa-float-tooltip {
      display: none;
    }
  }
</style>

<script>
  // Mostrar suavemente el tooltip tras 3.5s de navegación para invitar sin molestar
  setTimeout(() => {
    const wrap = document.querySelector('.wa-float-wrap');
    if (wrap) {
      wrap.classList.add('has-hint');
      setTimeout(() => {
        wrap.classList.remove('has-hint');
      }, 6000);
    }
  }, 3500);
</script>
