---
import type { CategoriaMenu, MenuItem as MenuItemType } from '../../types/menu';
import MenuItem from './MenuItem.astro';
import MenuFeature from './MenuFeature.astro';
import CategoryBanner from './CategoryBanner.astro';

interface Props {
  categoria: CategoriaMenu;
  index?: number;
}

const CATEGORY_IMAGES: Record<string, string> = {
  entradas: '/menu-secciones/ceviche.webp',
  arroces: '/menu-secciones/arroces.webp',
  cazuelas: '/menu-secciones/cazuela.webp',
  pescados: '/menu-secciones/pescados.webp',
  salmon: '/menu-secciones/salmon.webp',
  camarones: '/menu-secciones/camarones-y-langostinos.webp',
  pastas: '/menu-secciones/pasta-a-la-marinera.webp',
  especialidades: '/menu-secciones/langosta-rellena.webp',
  ejecutivos: '/menu-secciones/ejecutivos.webp',
  bebidas: '/menu-secciones/bebidas.webp',
};

const { categoria: c, index = 0 } = Astro.props;
const categoryImg = CATEGORY_IMAGES[c.id];
const isEven = index % 2 === 0;
const imageSide = isEven ? 'left' : 'right';

function splitItems(items: MenuItemType[] = []) {
  const mid = Math.ceil(items.length / 2);
  return [items.slice(0, mid), items.slice(mid)];
}
---

<section class="menu-section" id={c.id}>
  {categoryImg && (
    <div
      class:list={[
        'menu-section__bg-wrap',
        `menu-section__bg-wrap--${imageSide}`
      ]}
      aria-hidden="true"
    >
      <img
        src={categoryImg}
        alt=""
        class="menu-section__bg-img"
        loading="lazy"
        decoding="async"
        width="400"
        height="400"
      />
    </div>
  )}

  <div class="container">
    <div class="menu-section__head">
      <CategoryBanner title={c.nombre} />
      {c.resumen && (
        <span class:list={['menu-section__resumen', { 'menu-section__resumen--bold-accent': c.id === 'adicionales' }]}>
          {c.resumen}
        </span>
      )}
    </div>

    {c.destacado && (
      <div data-sr data-sr-direction="zoom" data-sr-delay="0.1">
        <MenuFeature feature={c.destacado} />
      </div>
    )}

    {c.subgrupos ? (
      c.subgrupos.map((sg) => {
        const [col1, col2] = splitItems(sg.items);
        const isSingle = col2.length === 0;
        return (
          <div class="menu-subgroup">
            <h3
              style="font-size:1.12rem;margin:1.6rem 0 .4rem;color:var(--teal-700);font-family:var(--font-display)"
              data-sr
              data-sr-direction="up"
            >
              {sg.nombre}
            </h3>
            <div class:list={['menu-columns', { 'menu-columns--single': isSingle }]}>
              <ul class="menu-col">
                {col1.map((it, idx) => (
                  <MenuItem {...it} index={idx} />
                ))}
              </ul>
              {!isSingle && (
                <ul class="menu-col">
                  {col2.map((it, idx) => (
                    <MenuItem {...it} index={col1.length + idx} />
                  ))}
                </ul>
              )}
            </div>
          </div>
        );
      })
    ) : (
      (() => {
        const [col1, col2] = splitItems(c.items || []);
        const isSingle = col2.length === 0;
        return (
          <div class:list={['menu-columns', { 'menu-columns--single': isSingle }]}>
            <ul class="menu-col">
              {col1.map((it, idx) => (
                <MenuItem {...it} index={idx} />
              ))}
            </ul>
            {!isSingle && (
              <ul class="menu-col">
                {col2.map((it, idx) => (
                  <MenuItem {...it} index={col1.length + idx} />
                ))}
              </ul>
            )}
          </div>
        );
      })()
    )}

    {c.notaFinal && (
      <div class="menu-section__footer-note">
        <div class="menu-section__note-card">
          <svg
            class="menu-section__note-icon"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
          <p class="menu-section__note-text">
            <strong>Nota:</strong> {c.notaFinal}
          </p>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .menu-section {
    position: relative;
    overflow: hidden;
    padding: 3rem 0;
  }

  .menu-section__footer-note {
    width: 100%;
    margin-top: 2.2rem;
    display: flex;
    justify-content: center;
  }

  .menu-section__note-card {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(14, 90, 114, 0.18);
    border-radius: 999px;
    padding: 0.6rem 1.4rem;
    box-shadow: 0 4px 16px rgba(10, 37, 64, 0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    max-width: min(92vw, 640px);
    box-sizing: border-box;
  }

  .menu-section:nth-of-type(even) .menu-section__note-card {
    background: rgba(248, 244, 237, 0.96);
    border-color: rgba(217, 154, 63, 0.35);
  }

  .menu-section__note-icon {
    flex-shrink: 0;
    color: var(--teal-600, #14738f);
  }

  .menu-section:nth-of-type(even) .menu-section__note-icon {
    color: var(--gold-600, #b45309);
  }

  .menu-section__note-text {
    margin: 0;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.86rem;
    color: var(--navy-950, #071f38);
    line-height: 1.45;
    text-align: left;
  }

  .menu-section__note-text strong {
    color: var(--teal-800, #0a3d4d);
    font-weight: 700;
  }

  .menu-section:nth-of-type(even) .menu-section__note-text strong {
    color: var(--gold-700, #92400e);
  }

  @media (max-width: 640px) {
    .menu-section__note-card {
      border-radius: 12px;
      padding: 0.75rem 1rem;
      align-items: flex-start;
    }

    .menu-section__note-icon {
      margin-top: 2px;
    }

    .menu-section__note-text {
      font-size: 0.82rem;
    }
  }

  .menu-section__resumen--bold-accent {
    font-family: var(--font-body, "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: clamp(0.95rem, 2.3vw, 1.2rem);
    font-weight: 800;
    color: #0b5b6d;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.35;
    max-width: 460px;
    margin: 0.2rem auto 0;
  }

  .menu-section .container {
    position: relative;
    z-index: 2;
  }

  /* Imagen de fondo decorativa: suave y tenue como marca de agua lateral */
  .menu-section__bg-wrap {
    position: absolute;
    top: 50%;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    width: clamp(520px, 52vw, 850px);
    height: auto;
    opacity: 0.35;
    filter: drop-shadow(0 20px 40px rgba(10, 37, 64, 0.14));
  }

  .menu-section__bg-wrap--left {
    left: 0;
    transform: translate(-38%, -50%);
  }

  .menu-section__bg-wrap--right {
    right: 0;
    transform: translate(38%, -50%);
  }

  .menu-section__bg-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .menu-section {
      padding: 2.2rem 0;
    }

    .menu-section__bg-wrap {
      width: clamp(380px, 92vw, 580px);
      opacity: 0.32;
    }

    .menu-section__bg-wrap--left {
      transform: translate(-58%, -50%);
    }

    .menu-section__bg-wrap--right {
      transform: translate(58%, -50%);
    }
  }
</style>
