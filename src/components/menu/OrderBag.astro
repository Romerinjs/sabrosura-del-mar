---
import Icon from '../icons/Icon.astro';
---

<!-- Trigger flotante centrado en la parte inferior con letras blancas y entrada suave (Item 4) -->
<div class="order-bag-trigger-wrap" id="order-bag-trigger-wrap">
  <button type="button" id="open-order-btn" aria-label="Ver mi pedido seleccionado" class="order-bag-floating-btn">
    <span class="order-bag-badge" id="order-bag-count">0</span>
    <span class="order-bag-info">
      <span class="order-bag-title">Mi Pedido</span>
      <span class="order-bag-dot" aria-hidden="true">&bull;</span>
      <span class="order-bag-subtotal" id="order-bag-subtotal">$0</span>
    </span>
    <span class="order-bag-action">Ver pedido &rarr;</span>
  </button>
</div>

<!-- Drawer lateral deslizable de la bolsa de pedido -->
<div class="order-drawer-backdrop" id="order-drawer-backdrop" aria-hidden="true">
  <div class="order-drawer" id="order-drawer" role="dialog" aria-modal="true" aria-labelledby="order-drawer-title">
    <!-- Encabezado del Drawer -->
    <div class="order-drawer__head">
      <div>
        <span class="order-drawer__eyebrow">TU SELECCI&Oacute;N &bull; LA SABROSURA DEL MAR</span>
        <h2 id="order-drawer-title" class="order-drawer__heading">Platos en tu pedido</h2>
      </div>
      <button type="button" id="close-order-btn" class="order-drawer__close" aria-label="Cerrar bolsa de pedido">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Cuerpo con scroll interno de platos (Compacto - Item 6) -->
    <div class="order-drawer__body" id="order-drawer-items">
      <!-- Items renderizados dinámicamente -->
    </div>

    <!-- Pie del drawer fijo/sticky con el botón de WhatsApp -->
    <div class="order-drawer__footer">
      <!-- Encabezado de Subtotal interactivo como Acordeón (Inicia abierto / Up por defecto) -->
      <div
        id="summary-accordion-header"
        class="summary-accordion-header is-open"
        role="button"
        tabindex="0"
        aria-expanded="true"
        title="Toca para plegar o desplegar el formulario"
      >
        <div class="summary-accordion-left">
          <span class="summary-label">Subtotal estimado en carta:</span>
          <!-- Tooltip de sugerencia temporal de 3 segundos -->
          <span id="accordion-hint-tooltip" class="accordion-hint-tooltip">
            Ocultar
          </span>
        </div>

        <div class="summary-accordion-right">
          <strong id="order-drawer-total" class="summary-total">$0</strong>
          <span class="summary-chevron-pill" aria-hidden="true">
            <svg class="summary-chevron-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </span>
        </div>
      </div>

      <p class="summary-disclaimer">
        * El precio final, costo de env&iacute;o y disponibilidad ser&aacute;n liquidados directamente por el asesor en WhatsApp.
      </p>

      <!-- Contenedor plegable de datos (Inicia visible / abierto por defecto) -->
      <div class="order-drawer__fields" id="order-drawer-fields">
        <!-- Selector corregido: Solo 'Entrega a domicilio en Armenia' sin 'Sede Centro' (Item 5) -->
        <label class="order-form-group">
          <span class="order-label-text">&iquest;D&oacute;nde lo necesitas?</span>
          <select id="order-field-sede" class="order-input order-select">
            <option value="Entrega a domicilio en Armenia">Entrega a domicilio en Armenia</option>
            <option value="Para recoger en Sede Centro (Cra. 13 #14-22)">Para recoger en Sede Centro (Cra. 13 #14-22)</option>
            <option value="Para recoger en Sede Norte (Proviteq / Cra. 14)">Para recoger en Sede Norte (Proviteq / Cra. 14)</option>
          </select>
        </label>

        <label class="order-form-group">
          <span class="order-label-text">Tu nombre (opcional)</span>
          <input type="text" id="order-field-nombre" class="order-input" placeholder="Ej: Carlos G&oacute;mez" autocomplete="name" />
        </label>

        <div class="order-form-group" id="group-field-direccion">
          <label for="order-field-direccion" class="order-label-text">Direcci&oacute;n / Barrio (opcional)</label>
          <input type="text" id="order-field-direccion" class="order-input" placeholder="Ej: Cra. 14 #10-25, Barrio Granada" autocomplete="street-address" />
          
          <input type="hidden" id="order-field-lat" value="" />
          <input type="hidden" id="order-field-lng" value="" />

          <!-- Contenedor dedicado debajo de los inputs de dirección -->
          <div class="order-map-card" id="order-map-card">
            <div class="order-map-card__bar">
              <div class="order-map-card__info">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Fijar ruta en Google Maps</span>
              </div>
              <div class="order-map-card__actions">
                <button type="button" id="btn-toggle-inline-map" class="btn-map-action" title="Abrir mapa para fijar punto de entrega">
                  <span id="btn-toggle-map-icon">🗺️</span>
                  <span id="btn-toggle-map-text">Fijar en mapa</span>
                </button>
                <button type="button" id="btn-inline-gps" class="btn-map-action btn-map-action--gps" title="Ubicarme con el GPS">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="22" y1="12" x2="18" y2="12"></line>
                    <line x1="6" y1="12" x2="2" y2="12"></line>
                    <line x1="12" y1="6" x2="12" y2="2"></line>
                    <line x1="12" y1="22" x2="12" y2="18"></line>
                  </svg>
                  <span>Mi GPS</span>
                </button>
              </div>
            </div>

            <!-- Badge verde cuando hay coordenadas fijadas -->
            <div id="order-map-badge" class="order-map-badge" style="display: none;">
              <div class="order-map-badge__info">
                <span class="order-map-badge__dot"></span>
                <div class="order-map-badge__texts">
                  <strong class="order-map-badge__title">📍 Ubicaci&oacute;n fijada en Maps</strong>
                  <span id="order-map-badge-coords" class="order-map-badge__coords"></span>
                </div>
              </div>
              <div class="order-map-badge__actions">
                <button type="button" id="order-map-reopen-btn" class="order-map-badge__btn" title="Modificar punto">Cambiar</button>
                <button type="button" id="order-map-clear-btn" class="order-map-badge__clear" title="Quitar punto GPS">&times;</button>
              </div>
            </div>

            <!-- Contenedor del mapa integrado (se despliega debajo de los inputs) -->
            <div id="inline-map-wrapper" class="inline-map-wrapper" style="display: none;">
              <div class="inline-map-search-row">
                <input
                  type="text"
                  id="inline-map-search-input"
                  class="inline-map-search-input"
                  placeholder="Buscar barrio o carrera en Armenia..."
                  autocomplete="off"
                />
                <button type="button" id="inline-map-search-btn" class="inline-map-search-btn">Buscar</button>
              </div>

              <div class="inline-map-canvas-wrap">
                <div id="inline-leaflet-map" class="inline-map-canvas"></div>
                <div class="inline-map-hint">
                  <span>Arrastra el puntero rojo o toca el mapa</span>
                </div>
              </div>

              <div class="inline-map-footer">
                <div class="inline-map-detected">
                  <span class="inline-map-detected-tag">DIRECCI&Oacute;N:</span>
                  <span id="inline-map-detected-text" class="inline-map-detected-text">Apuntando al mapa de Armenia...</span>
                </div>
                <button type="button" id="inline-map-confirm-btn" class="btn-confirm-inline-map">
                  ✓ Confirmar este punto
                </button>
              </div>
            </div>
          </div>
        </div>

        <label class="order-form-group">
          <span class="order-label-text">Observaciones o cambios (opcional)</span>
          <input
            type="text"
            id="order-field-nota"
            class="order-input"
            placeholder="Ej: Sin salsa, sin cilantro, patac&oacute;n bien tostado..."
          />
        </label>
      </div>

      <button type="button" id="send-whatsapp-order-btn" class="btn-whatsapp-cta">
        <Icon name="whatsapp" size={20} />
        <span>Enviar pedido a WhatsApp</span>
      </button>
    </div>
  </div>
</div>

<style>
  /* -------------------------------------------------------------
     1. Botón Flotante Central con Letras Blancas y Entrada Suave (Smooth Move)
     ------------------------------------------------------------- */
  .order-bag-trigger-wrap {
    position: fixed;
    bottom: clamp(1rem, 3vw, 1.8rem);
    left: 50%;
    transform: translateX(-50%) translateY(32px) scale(0.9);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 95;
    max-width: calc(100vw - 2.5rem);
    width: max-content;
    transition: transform 0.42s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.35s ease, visibility 0.35s ease;
  }

  .order-bag-trigger-wrap.is-visible {
    transform: translateX(-50%) translateY(0) scale(1);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .order-bag-floating-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: linear-gradient(135deg, #071f38 0%, #0a2e52 48%, #0e5a72 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 750;
    padding: 0.72rem 1.45rem;
    border-radius: 999px;
    border: 2px solid var(--gold-400);
    box-shadow: 0 10px 30px rgba(5, 20, 35, 0.4), 0 0 16px rgba(226, 168, 66, 0.35);
    cursor: pointer;
    transition: transform 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.22s ease;
    white-space: nowrap;
    text-decoration: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .order-bag-floating-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 14px 38px rgba(5, 20, 35, 0.5), 0 0 22px rgba(226, 168, 66, 0.5);
  }

  .order-bag-floating-btn:active {
    transform: translateY(-1px) scale(0.99);
  }

  .order-bag-badge {
    background: var(--gold-500);
    color: #051423;
    border: 1.5px solid #ffffff;
    font-weight: 900;
    font-size: 0.82rem;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .order-bag-info {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .order-bag-title {
    color: #ffffff;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .order-bag-dot {
    color: rgba(255, 255, 255, 0.55);
    font-weight: 900;
  }

  .order-bag-subtotal {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: #ffffff;
  }

  .order-bag-action {
    font-size: 0.82rem;
    font-weight: 750;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    margin-left: 0.2rem;
  }

  @media (max-width: 480px) {
    .order-bag-action {
      display: none;
    }
    .order-bag-floating-btn {
      padding: 0.65rem 1.15rem;
      gap: 0.6rem;
      font-size: 0.88rem;
    }
  }

  /* -------------------------------------------------------------
     2. Modal Backdrop & Drawer Deslizable con Transición Suave (Smooth Move)
     ------------------------------------------------------------- */
  .order-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(5, 20, 35, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s ease;
    display: flex;
    justify-content: flex-end;
  }

  .order-drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .order-drawer {
    width: 100%;
    max-width: min(460px, 100vw);
    height: 100%;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.44s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -12px 0 45px rgba(5, 20, 35, 0.35);
    overflow: hidden;
  }

  .order-drawer-backdrop.is-open .order-drawer {
    transform: translateX(0);
  }

  /* Encabezado del Drawer */
  .order-drawer__head {
    padding: 1rem 1.3rem;
    background: #051423;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    border-bottom: 2px solid var(--gold-500);
  }

  .order-drawer__eyebrow {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    color: var(--gold-400);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.2rem;
  }

  .order-drawer__heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.15;
  }

  .order-drawer__close {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all 0.18s ease;
    flex-shrink: 0;
    padding: 0;
  }

  .order-drawer__close:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.08);
  }

  /* Cuerpo del Drawer (Más compacto - Item 6) */
  .order-drawer__body {
    flex: 1 1 auto;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.85rem 1.1rem;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 0;
  }

  /* Estado vacío del Drawer */
  :global(.order-empty-state) {
    text-align: center !important;
    padding: 3.5rem 1.2rem !important;
    color: #64748b !important;
    margin: auto !important;
  }

  :global(.order-empty-icon) {
    font-size: 2.6rem !important;
    margin-bottom: 0.8rem !important;
    opacity: 0.85 !important;
  }

  :global(.order-empty-state h3) {
    font-family: var(--font-display) !important;
    font-size: 1.25rem !important;
    color: #0a2540 !important;
    margin: 0 0 0.4rem !important;
    font-weight: 700 !important;
  }

  :global(.order-empty-state p) {
    font-size: 0.88rem !important;
    line-height: 1.5 !important;
    margin: 0 !important;
    color: #64748b !important;
  }

  /* -------------------------------------------------------------
     3. Pie Sticky del Drawer
     ------------------------------------------------------------- */
  .order-drawer__footer {
    flex-shrink: 0;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    padding: 0.65rem 1rem;
    box-shadow: 0 -6px 20px rgba(5, 20, 35, 0.07);
    z-index: 10;
  }

  /* -------------------------------------------------------------
     Encabezado de Subtotal con función de Acordeón interactivo
     ------------------------------------------------------------- */
  .summary-accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.5rem;
    margin: -0.2rem -0.4rem 0.15rem;
    border-radius: 8px;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.18s ease;
  }

  .summary-accordion-header:hover {
    background-color: #f1f5f9;
  }

  .summary-accordion-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .summary-label {
    font-size: 0.79rem;
    font-weight: 650;
    color: #0a2540;
    white-space: nowrap;
  }

  /* Tooltip sugerencia temporal de 3 segundos */
  .accordion-hint-tooltip {
    display: inline-flex;
    align-items: center;
    background: rgba(14, 90, 114, 0.12);
    color: var(--teal-700, #0e5a72);
    font-size: 0.64rem;
    font-weight: 750;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
    white-space: nowrap;
  }

  .accordion-hint-tooltip.is-hidden {
    opacity: 0;
    transform: translateY(-3px);
  }

  .summary-accordion-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .summary-total {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: #0e5a72;
    font-variant-numeric: tabular-nums;
  }

  .summary-chevron-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #f1f5f9;
    color: #64748b;
    transition: background-color 0.2s ease, transform 0.25s ease, color 0.2s ease;
  }

  .summary-accordion-header:hover .summary-chevron-pill {
    background: #e2e8f0;
    color: #0a2540;
  }

  .summary-chevron-icon {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Cuando está cerrado, el chevron rota a 180deg (abajo) */
  .summary-accordion-header:not(.is-open) .summary-chevron-icon {
    transform: rotate(180deg);
  }

  .summary-accordion-header:not(.is-open) {
    background: rgba(14, 90, 114, 0.05);
  }

  /* Disclaimer más pequeño y discreto (solicitado por usuario) */
  .summary-disclaimer {
    font-size: 0.64rem;
    color: #64748b;
    margin: 0.05rem 0 0.35rem;
    line-height: 1.25;
    font-style: italic;
  }

  .order-drawer__fields {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.45rem;
    max-height: 48vh;
    overflow-y: auto;
    padding-right: 0.15rem;
    animation: fieldsUnfold 0.22s ease-out;
  }

  @keyframes fieldsUnfold {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .order-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    margin-bottom: 0.25rem;
  }

  .order-label-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: #0a2540;
  }

  .order-input {
    width: 100%;
    padding: 0.38rem 0.65rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 7px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    background: #f8fafc;
    color: #051423;
    transition: border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .order-input:focus {
    outline: none;
    border-color: #0e5a72;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(14, 90, 114, 0.14);
  }

  .order-select {
    cursor: pointer;
    font-weight: 600;
  }

  /* Botón CTA Enviar a WhatsApp */
  .btn-whatsapp-cta {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 750;
    padding: 0.85rem 1.2rem;
    border: none;
    border-radius: 11px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .btn-whatsapp-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.45);
  }

  .btn-whatsapp-cta:active {
    transform: translateY(0);
  }

  .btn-whatsapp-cta--disabled,
  .btn-whatsapp-cta[disabled] {
    background: #94a3b8 !important;
    box-shadow: none !important;
    cursor: not-allowed !important;
    transform: none !important;
    opacity: 0.82;
  }

  /* -------------------------------------------------------------
     Contenedor Dedicado de Ubicación en Mapa (Debajo de los inputs)
     ------------------------------------------------------------- */
  .order-map-card {
    margin-top: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.65rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.2s ease;
  }

  .order-map-card:focus-within {
    border-color: rgba(14, 90, 114, 0.35);
  }

  .order-map-card__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    flex-wrap: wrap;
    width: 100%;
    box-sizing: border-box;
  }

  .order-map-card__info {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--navy-900, #071f38);
  }

  .order-map-card__info svg {
    color: var(--teal-700, #0e5a72);
    flex-shrink: 0;
  }

  .order-map-card__actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
