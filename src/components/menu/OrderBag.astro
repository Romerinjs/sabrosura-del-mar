</style>

<script>
  interface CartItem {
    nombre: string;
    precio: number;
    cantidad: number;
  }

  const STORAGE_KEY = 'sabrosura_cart_v1';

  function getCart(): CartItem[] {
    try {
      const stored = sessionStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    } catch {}
  }

  function formatMoney(n: number): string {
    return '$' + n.toLocaleString('es-CO');
  }

  function addToCart(nombre: string, precio: number) {
    const cart = getCart();
    const existing = cart.find((it) => it.nombre.toLowerCase().trim() === nombre.toLowerCase().trim());
    if (existing) {
      existing.cantidad += 1;
    } else {
      cart.push({ nombre, precio, cantidad: 1 });
    }
    saveCart(cart);
    renderCartUI();
    pulseBagTrigger();
  }

  function updateQty(index: number, delta: number) {
    const cart = getCart();
    if (index >= 0 && index < cart.length) {
      cart[index].cantidad += delta;
      if (cart[index].cantidad <= 0) {
        cart.splice(index, 1);
      }
      saveCart(cart);
      renderCartUI();
    }
  }

  function removeItem(index: number) {
    const cart = getCart();
    if (index >= 0 && index < cart.length) {
      cart.splice(index, 1);
      saveCart(cart);
      renderCartUI();
    }
  }

  function pulseBagTrigger() {
    const trigger = document.getElementById('open-order-btn');
    if (trigger) {
      trigger.animate(
        [
          { transform: 'scale(1)' },
          { transform: 'scale(1.08)' },
          { transform: 'scale(1)' },
        ],
        { duration: 260, easing: 'ease-out' }
      );
    }
  }

  function renderCartUI() {
    const cart = getCart();
    const triggerWrap = document.getElementById('order-bag-trigger-wrap');
    const countEl = document.getElementById('order-bag-count');
    const subtotalEl = document.getElementById('order-bag-subtotal');
    const drawerTotalEl = document.getElementById('order-drawer-total');
    const itemsContainer = document.getElementById('order-drawer-items');

    const totalCount = cart.reduce((acc, it) => acc + it.cantidad, 0);
    const totalMonto = cart.reduce((acc, it) => acc + it.precio * it.cantidad, 0);

    if (triggerWrap) {
      triggerWrap.classList.toggle('is-visible', totalCount > 0);
    }

    // Marca en body para desplazar suavemente el botón de WhatsApp en móviles y evitar solapamiento
    if (totalCount > 0) {
      document.body.classList.add('has-order-items');
    } else {
      document.body.classList.remove('has-order-items');
    }

    if (countEl) countEl.textContent = String(totalCount);
    if (subtotalEl) subtotalEl.textContent = formatMoney(totalMonto);
    if (drawerTotalEl) drawerTotalEl.textContent = formatMoney(totalMonto);

    // Estado del botón WhatsApp según horario configurado
    const waBtn = document.getElementById('send-whatsapp-order-btn') as HTMLButtonElement | null;
    if (waBtn) {
      const open = isRestaurantOpen();
      if (ENABLE_BUSINESS_HOURS_RESTRICTION && !open) {
        waBtn.classList.add('btn-whatsapp-cta--disabled');
        waBtn.setAttribute('disabled', 'true');
        waBtn.setAttribute('title', 'Horario de pedidos finalizado por hoy (11:00 AM - 5:00 PM)');
        const span = waBtn.querySelector('span');
        if (span) span.textContent = 'Fuera de horario (Abre a las 11:00 AM)';
      } else {
        waBtn.classList.remove('btn-whatsapp-cta--disabled');
        waBtn.removeAttribute('disabled');
        waBtn.removeAttribute('title');
        const span = waBtn.querySelector('span');
        if (span) span.textContent = 'Enviar pedido a WhatsApp';
      }
    }

    if (itemsContainer) {
      if (cart.length === 0) {
        itemsContainer.innerHTML = `
          <div class="order-empty-state">
            <div class="order-empty-icon">&#127860;</div>
            <h3>Tu pedido est&aacute; vac&iacute;o</h3>
            <p>Haz clic en el bot&oacute;n <strong>+</strong> junto a cualquier plato de la carta para agregarlo.</p>
          </div>
        `;
      } else {
        itemsContainer.innerHTML = cart
          .map(
            (item, idx) => `
          <div class="order-item-card">
            <div class="order-item-card__top">
              <div class="order-item-card__title">${item.nombre}</div>
              <button type="button" class="order-item-card__del" data-cart-action="remove" data-cart-index="${idx}" title="Eliminar ${item.nombre}" aria-label="Eliminar ${item.nombre}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </div>
            <div class="order-item-card__bottom">
              <div class="order-item-card__unitprice">
                ${item.precio ? formatMoney(item.precio) + ' c/u' : 'Por cotizar'}
              </div>
              <div class="order-item-card__controls">
                <div class="order-item-stepper">
                  <button type="button" class="order-item-stepper__btn" data-cart-action="minus" data-cart-index="${idx}" aria-label="Restar 1">&minus;</button>
                  <span class="order-item-stepper__num">${item.cantidad}</span>
                  <button type="button" class="order-item-stepper__btn" data-cart-action="plus" data-cart-index="${idx}" aria-label="Sumar 1">&plus;</button>
                </div>
                <div class="order-item-card__rowtotal">
                  ${item.precio ? formatMoney(item.precio * item.cantidad) : ''}
                </div>
              </div>
            </div>
          </div>
        `
          )
          .join('');
      }
    }
  }

  // -------------------------------------------------------------
  // RESTRICCIÓN DE HORARIO DE ATENCIÓN (11:00 AM a 5:00 PM Colombia)
  // CONFIGURACIÓN DE PRODUCCIÓN:
  // - true (ACTIVO): Deshabilita el botón de pedidos y bloquea envíos fuera de horario.
  // -------------------------------------------------------------
  const ENABLE_BUSINESS_HOURS_RESTRICTION = true;

  function isRestaurantOpen(): boolean {
    try {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'America/Bogota',
        hour: 'numeric',
        minute: 'numeric',
        hour12: false,
      };
      const formatter = new Intl.DateTimeFormat('en-US', options);
      const parts = formatter.formatToParts(now);

      const hourStr = parts.find((p) => p.type === 'hour')?.value || '0';
      const minuteStr = parts.find((p) => p.type === 'minute')?.value || '0';
      const hour = parseInt(hourStr, 10);
      const minute = parseInt(minuteStr, 10);
      const currentMin = hour * 60 + minute;

      const openMin = 11 * 60; // 11:00 AM
      const closeMin = 17 * 60; // 5:00 PM

      return currentMin >= openMin && currentMin < closeMin;
    } catch {
      return true;
    }
  }

  // -------------------------------------------------------------
  // MANEJO DE ACORDEÓN EN SUB-TOTAL Y SUGGEST TOOLTIP DE 3 SEGUNDOS
  // -------------------------------------------------------------
  let tooltipTimer: any = null;

  function triggerAccordionSuggestTooltip(forceShow = true) {
    const tooltip = document.getElementById('accordion-hint-tooltip');
    const header = document.getElementById('summary-accordion-header');
    if (!tooltip) return;

    const isOpen = header ? header.classList.contains('is-open') : true;
    tooltip.textContent = isOpen ? 'Ocultar' : 'Mostrar';

    clearTimeout(tooltipTimer);

    if (forceShow) {
      tooltip.classList.remove('is-hidden');
      tooltipTimer = setTimeout(() => {
        tooltip.classList.add('is-hidden');
      }, 3000);
    } else {
      tooltip.classList.add('is-hidden');
    }
  }

  function toggleSummaryAccordion() {
    const fields = document.getElementById('order-drawer-fields');
    const header = document.getElementById('summary-accordion-header');
    if (!fields || !header) return;

    const isCurrentlyOpen = header.classList.contains('is-open');
    if (isCurrentlyOpen) {
      fields.style.display = 'none';
      header.classList.remove('is-open');
      header.setAttribute('aria-expanded', 'false');
    } else {
      fields.style.display = 'flex';
      header.classList.add('is-open');
      header.setAttribute('aria-expanded', 'true');
    }

    triggerAccordionSuggestTooltip(true);
  }

  import 'leaflet/dist/leaflet.css';

  // Coordenadas fijas por defecto: Armenia, Quindío (Plaza Bolívar)
  const DEFAULT_LAT = 4.538889;
  const DEFAULT_LNG = -75.6725;
  const DEFAULT_ZOOM = 15;

  let inlineMap: any = null;
  let inlineMarker: any = null;
  let LModule: any = null;
  let inlineSelectedLat = DEFAULT_LAT;
  let inlineSelectedLng = DEFAULT_LNG;
  let inlineSelectedAddress = 'Armenia, Quindío';
  let inlineGeocodeTimer: any = null;

  function createInlinePinIcon(L: any) {
    return L.divIcon({
      className: 'custom-pin-marker',
      html: `
        <div class="pin-svg-wrapper">
          <div class="pin-pulse-base"></div>
          <svg width="38" height="48" viewBox="0 0 38 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="pinGradOrder" x1="19" y1="0" x2="19" y2="48" gradientUnits="userSpaceOnUse">
                <stop stop-color="#ef4444" />
                <stop offset="1" stop-color="#b91c1c" />
              </linearGradient>
              <filter id="pinShadowOrder" x="-20%" y="-10%" width="140%" height="130%">
                <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#000000" flood-opacity="0.35"/>
              </filter>
            </defs>
            <path filter="url(#pinShadowOrder)" d="M19 0C8.506 0 0 8.506 0 19C0 32.5 19 48 19 48C19 48 38 32.5 38 19C38 8.506 29.494 0 19 0Z" fill="url(#pinGradOrder)"/>
            <circle cx="19" cy="18" r="7.5" fill="#ffffff"/>
            <circle cx="19" cy="18" r="4" fill="#b91c1c"/>
          </svg>
        </div>
      `,
      iconSize: [38, 48],
      iconAnchor: [19, 48],
    });
  }

  async function reverseGeocodeInline(lat: number, lng: number) {
    const textEl = document.getElementById('inline-map-detected-text');
    if (textEl) {
      textEl.textContent = 'Detectando dirección...';
    }

    clearTimeout(inlineGeocodeTimer);
    inlineGeocodeTimer = setTimeout(async () => {
      try {
        const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&accept-language=es`;
        const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) throw new Error('Geocoding error');
        const data = await res.json();

        const addr = data.address || {};
        const road = addr.road || addr.pedestrian || addr.street || addr.footway || '';
        const houseNumber = addr.house_number ? `#${addr.house_number}` : '';
        const neighbourhood = addr.neighbourhood || addr.suburb || addr.residential || addr.quarter || '';
        const city = addr.city || addr.town || addr.municipality || 'Armenia';

        const parts: string[] = [];
        if (road) {
          parts.push(houseNumber ? `${road} ${houseNumber}` : road);
        }
        if (neighbourhood) {
          parts.push(`Barrio ${neighbourhood}`);
        }
        parts.push(city);

        const formatted = parts.length > 0 ? parts.join(', ') : (data.display_name?.split(',').slice(0, 3).join(',') || `Ubicación (${lat.toFixed(4)}, ${lng.toFixed(4)})`);
        inlineSelectedAddress = formatted;

        if (textEl) {
          textEl.textContent = formatted;
        }
      } catch {
        inlineSelectedAddress = `Ubicación GPS (${lat.toFixed(5)}, ${lng.toFixed(5)})`;
        if (textEl) {
          textEl.textContent = inlineSelectedAddress;
        }
      }
    }, 320);
  }

  async function initInlineMap(initialLat = DEFAULT_LAT, initialLng = DEFAULT_LNG) {
    const container = document.getElementById('inline-leaflet-map');
    if (!container) return;

    if (!LModule) {
      LModule = (await import('leaflet')).default;
    }
    const L = LModule;

    if (!inlineMap) {
      inlineMap = L.map('inline-leaflet-map', {
        center: [initialLat, initialLng],
        zoom: DEFAULT_ZOOM,
        zoomControl: true,
      });

      // OPENSTREETMAP OFICIAL: 100% GRATIS, SIN WATERMARK, NUNCA PIDE API KEY
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      }).addTo(inlineMap);

      const pinIcon = createInlinePinIcon(L);
      inlineMarker = L.marker([initialLat, initialLng], {
        icon: pinIcon,
        draggable: true,
      }).addTo(inlineMap);

      inlineMarker.on('dragend', (e: any) => {
        const pos = e.target.getLatLng();
        inlineSelectedLat = pos.lat;
        inlineSelectedLng = pos.lng;
        reverseGeocodeInline(inlineSelectedLat, inlineSelectedLng);
      });

      inlineMap.on('click', (e: any) => {
        const pos = e.latlng;
        inlineSelectedLat = pos.lat;
        inlineSelectedLng = pos.lng;
        inlineMarker.setLatLng(pos);
        reverseGeocodeInline(inlineSelectedLat, inlineSelectedLng);
      });
    } else {
      inlineMap.setView([initialLat, initialLng], DEFAULT_ZOOM);
      inlineMarker.setLatLng([initialLat, initialLng]);
    }

    inlineSelectedLat = initialLat;
    inlineSelectedLng = initialLng;
    reverseGeocodeInline(initialLat, initialLng);

    setTimeout(() => {
      inlineMap?.invalidateSize();
    }, 180);
  }

  async function searchInlineMap(query: string) {
    if (!query.trim() || !inlineMap) return;
    const btn = document.getElementById('inline-map-search-btn');
    if (btn) btn.textContent = '...';

    try {
      const q = `${query.trim()}, Armenia, Quindio, Colombia`;
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}&limit=1`);
      const data = await res.json();
      if (data && data.length > 0) {
        const lat = parseFloat(data[0].lat);
        const lng = parseFloat(data[0].lon);
        inlineSelectedLat = lat;
        inlineSelectedLng = lng;
        inlineMap.setView([lat, lng], 16);
        inlineMarker.setLatLng([lat, lng]);
        reverseGeocodeInline(lat, lng);
      } else {
        alert('No encontramos esa dirección en Armenia. Puedes tocar o arrastrar el marcador en el mapa.');
      }
    } catch (err) {
      console.error(err);
    } finally {
      if (btn) btn.textContent = 'Buscar';
    }
  }

  function toggleInlineMap(forceOpen?: boolean) {
    const wrapper = document.getElementById('inline-map-wrapper');
    const toggleIcon = document.getElementById('btn-toggle-map-icon');
    const toggleText = document.getElementById('btn-toggle-map-text');
    if (!wrapper) return;

    const shouldOpen = forceOpen !== undefined ? forceOpen : wrapper.style.display === 'none';

    if (shouldOpen) {
      wrapper.style.display = 'flex';
      if (toggleIcon) toggleIcon.textContent = '✕';
      if (toggleText) toggleText.textContent = 'Cerrar mapa';

      const latInput = document.getElementById('order-field-lat') as HTMLInputElement | null;
      const lngInput = document.getElementById('order-field-lng') as HTMLInputElement | null;
      const lat = latInput?.value ? parseFloat(latInput.value) : inlineSelectedLat;
      const lng = lngInput?.value ? parseFloat(lngInput.value) : inlineSelectedLng;

      initInlineMap(lat, lng);
    } else {
      wrapper.style.display = 'none';
      if (toggleIcon) toggleIcon.textContent = '🗺️';
      if (toggleText) toggleText.textContent = 'Fijar en mapa';
    }
  }

  function locateInlineGPS() {
    const btn = document.getElementById('btn-inline-gps');
    if (!navigator.geolocation) {
      alert('Tu navegador no soporta geolocalización GPS.');
      return;
    }

    if (btn) {
      btn.setAttribute('disabled', 'true');
      btn.innerHTML = '<span>Localizando...</span>';
    }

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        inlineSelectedLat = lat;
        inlineSelectedLng = lng;

        const latInput = document.getElementById('order-field-lat') as HTMLInputElement | null;
        const lngInput = document.getElementById('order-field-lng') as HTMLInputElement | null;
        const badge = document.getElementById('order-map-badge');
        const badgeCoords = document.getElementById('order-map-badge-coords');

        if (latInput) latInput.value = String(lat);
        if (lngInput) lngInput.value = String(lng);
        if (badgeCoords) badgeCoords.textContent = `(${lat.toFixed(4)}, ${lng.toFixed(4)})`;
        if (badge) badge.style.display = 'flex';

        if (inlineMap && inlineMarker) {
          inlineMap.setView([lat, lng], 17);
          inlineMarker.setLatLng([lat, lng]);
        }
        reverseGeocodeInline(lat, lng);

        const accStatus = document.getElementById('delivery-accordion-status');
        if (accStatus) {
          accStatus.textContent = `✓ GPS fijado (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
        }

        if (btn) {
          btn.removeAttribute('disabled');
          btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="22" y1="12" x2="18" y2="12"></line><line x1="6" y1="12" x2="2" y2="12"></line><line x1="12" y1="6" x2="12" y2="2"></line><line x1="12" y1="22" x2="12" y2="18"></line></svg><span>Mi GPS</span>`;
        }
      },
      (err) => {
        console.warn('GPS error', err);
        alert('No se pudo obtener la ubicación GPS. Por favor permite los permisos de ubicación o toca el mapa manualmente.');
        if (btn) {
          btn.removeAttribute('disabled');
          btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="22" y1="12" x2="18" y2="12"></line><line x1="6" y1="12" x2="2" y2="12"></line><line x1="12" y1="6" x2="12" y2="2"></line><line x1="12" y1="22" x2="12" y2="18"></line></svg><span>Mi GPS</span>`;
        }
      },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
    );
  }

  function confirmInlineLocation() {
    const dirInput = document.getElementById('order-field-direccion') as HTMLInputElement | null;
    const latInput = document.getElementById('order-field-lat') as HTMLInputElement | null;
    const lngInput = document.getElementById('order-field-lng') as HTMLInputElement | null;
    const badge = document.getElementById('order-map-badge');
    const badgeCoords = document.getElementById('order-map-badge-coords');
    const accStatus = document.getElementById('delivery-accordion-status');

    if (dirInput && (!dirInput.value.trim() || dirInput.value.startsWith('Ubicación'))) {
      dirInput.value = inlineSelectedAddress;
    }
    if (latInput) latInput.value = String(inlineSelectedLat);
    if (lngInput) lngInput.value = String(inlineSelectedLng);
    if (badgeCoords) badgeCoords.textContent = `(${inlineSelectedLat.toFixed(4)}, ${inlineSelectedLng.toFixed(4)})`;
    if (badge) badge.style.display = 'flex';
    if (accStatus) {
      accStatus.textContent = `✓ Ubicación fijada en Maps (${inlineSelectedLat.toFixed(4)}, ${inlineSelectedLng.toFixed(4)})`;
    }

    toggleInlineMap(false);
  }

  function sendWhatsAppOrder() {
    const cart = getCart();
    if (cart.length === 0) return;

    if (ENABLE_BUSINESS_HOURS_RESTRICTION && !isRestaurantOpen()) {
      alert('¡Hola! En este momento nuestro horario de atención para pedidos ha finalizado. Atendemos todos los días de 11:00 AM a 5:00 PM. ¡Te esperamos mañana!');
      return;
    }

    const sedeSelect = document.getElementById('order-field-sede') as HTMLSelectElement | null;
    const nombreInput = document.getElementById('order-field-nombre') as HTMLInputElement | null;
    const dirInput = document.getElementById('order-field-direccion') as HTMLInputElement | null;
    const notaInput = document.getElementById('order-field-nota') as HTMLInputElement | null;
    const latInput = document.getElementById('order-field-lat') as HTMLInputElement | null;
    const lngInput = document.getElementById('order-field-lng') as HTMLInputElement | null;

    const sede = sedeSelect?.value || 'Entrega a domicilio en Armenia';
    const nombre = nombreInput?.value.trim() || '';
    const direccion = dirInput?.value.trim() || '';
    const nota = notaInput?.value.trim() || '';
    const lat = latInput?.value.trim() || '';
    const lng = lngInput?.value.trim() || '';

    let msg = '*¡Hola! Quiero hacer el siguiente pedido en La Sabrosura del Mar:*\n\n';
    cart.forEach((it) => {
      msg += `- ${it.cantidad}x ${it.nombre}\n`;
    });
    msg += `\n*Destino:* ${sede}`;
    if (nombre) msg += `\n*Nombre:* ${nombre}`;
    if (direccion) msg += `\n*Dirección:* ${direccion}`;
    if (lat && lng) {
      msg += `\n*📍 Ubicación en Google Maps (Ruta GPS):*\nhttps://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
    }
    if (nota) msg += `\n*Observaciones:* ${nota}`;

    // Línea comercial oficial directa de La Sabrosura del Mar
    const phone = '573113093429';

    const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

    const win = window as any;
    if (win.dataLayer) {
      win.dataLayer.push({
        event: 'whatsapp_order_sent',
        itemCount: cart.reduce((acc, it) => acc + it.cantidad, 0),
        sedeDestino: sede,
        hasMapLocation: Boolean(lat && lng),
      });
    }

    window.open(waUrl, '_blank');
  }

  // -------------------------------------------------------------
  // REGISTRO DE EVENTOS GLOBAL Y ÚNICO
  // -------------------------------------------------------------
  if (!(window as any).__sabrosuraBagListenerAttached) {
    (window as any).__sabrosuraBagListenerAttached = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // 1. Agregar plato (+ Pedir)
      const addBtn = target.closest('[data-dish-add]') as HTMLElement | null;
      if (addBtn) {
        e.preventDefault();
        e.stopPropagation();
        const name = addBtn.getAttribute('data-dish-name') || '';
        const price = Number(addBtn.getAttribute('data-dish-price') || '0');
        if (name) {
          addToCart(name, price);

          // Microinteracción táctil y visual: Feedback interactivo moderno
          addBtn.classList.add('is-added');
          const textEl = addBtn.querySelector('.btn-text');
          if (textEl) {
            const prevText = textEl.textContent;
            textEl.textContent = '¡Añadido!';
            setTimeout(() => {
              addBtn.classList.remove('is-added');
              if (prevText) textEl.textContent = prevText;
            }, 1100);
          } else {
            setTimeout(() => {
              addBtn.classList.remove('is-added');
            }, 550);
          }
        }
        return;
      }

      // 2. Acciones del carrito (plus, minus, remove)
      const actionBtn = target.closest('[data-cart-action]');
      if (actionBtn) {
        e.preventDefault();
        const action = actionBtn.getAttribute('data-cart-action');
        const idx = Number(actionBtn.getAttribute('data-cart-index'));
        if (action === 'plus') updateQty(idx, 1);
        if (action === 'minus') updateQty(idx, -1);
        if (action === 'remove') removeItem(idx);
        return;
      }

      // 3. Abrir drawer
      if (target.closest('#open-order-btn') || target.closest('#order-bag-trigger-wrap')) {
        e.preventDefault();
        const backdrop = document.getElementById('order-drawer-backdrop');
        backdrop?.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        triggerAccordionSuggestTooltip();
        return;
      }

      // 4. Cerrar drawer
      if (target.closest('#close-order-btn') || target.id === 'order-drawer-backdrop') {
        e.preventDefault();
        const backdrop = document.getElementById('order-drawer-backdrop');
        backdrop?.classList.remove('is-open');
        document.body.style.overflow = '';
        return;
      }

      // 5. Enviar a WhatsApp
      if (target.closest('#send-whatsapp-order-btn')) {
        e.preventDefault();
        sendWhatsAppOrder();
        return;
      }

      // 5.5 Toggle Acordeón en el Encabezado de Subtotal
      if (target.closest('#summary-accordion-header')) {
        e.preventDefault();
        toggleSummaryAccordion();
        return;
      }

      // 6. Botones de mapa inline
      if (target.closest('#btn-toggle-inline-map')) {
        e.preventDefault();
        const fields = document.getElementById('order-drawer-fields');
        const header = document.getElementById('summary-accordion-header');
        if (fields && fields.style.display === 'none') {
          fields.style.display = 'flex';
          header?.classList.add('is-open');
          header?.setAttribute('aria-expanded', 'true');
        }
        toggleInlineMap();
        return;
      }

      if (target.closest('#order-map-reopen-btn')) {
        e.preventDefault();
        const fields = document.getElementById('order-drawer-fields');
        const header = document.getElementById('summary-accordion-header');
        if (fields && fields.style.display === 'none') {
          fields.style.display = 'flex';
          header?.classList.add('is-open');
          header?.setAttribute('aria-expanded', 'true');
        }
        toggleInlineMap(true);
        return;
      }

      if (target.closest('#btn-inline-gps')) {
        e.preventDefault();
        locateInlineGPS();
        return;
      }

      if (target.closest('#inline-map-confirm-btn')) {
        e.preventDefault();
        confirmInlineLocation();
        return;
      }

      if (target.closest('#inline-map-search-btn')) {
        e.preventDefault();
        const searchInput = document.getElementById('inline-map-search-input') as HTMLInputElement | null;
        if (searchInput?.value) searchInlineMap(searchInput.value);
        return;
      }

      // 7. Limpiar punto del mapa
      if (target.closest('#order-map-clear-btn')) {
        e.preventDefault();
        const latInput = document.getElementById('order-field-lat') as HTMLInputElement | null;
        const lngInput = document.getElementById('order-field-lng') as HTMLInputElement | null;
        const badge = document.getElementById('order-map-badge');
        if (latInput) latInput.value = '';
        if (lngInput) lngInput.value = '';
        if (badge) badge.style.display = 'none';
        toggleInlineMap(false);
        return;
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const searchInput = document.getElementById('inline-map-search-input') as HTMLInputElement | null;
        if (document.activeElement === searchInput && searchInput?.value) {
          e.preventDefault();
          searchInlineMap(searchInput.value);
          return;
        }
      }

      if (e.key === 'Escape') {
        const backdrop = document.getElementById('order-drawer-backdrop');
        if (backdrop?.classList.contains('is-open')) {
          backdrop.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      }
    });
  }

  renderCartUI();
  document.addEventListener('DOMContentLoaded', renderCartUI);
  document.addEventListener('astro:page-load', renderCartUI);
</script>
