---
import Icon from '../icons/Icon.astro';

interface Props {
  nombre: string;
  precio?: number;
  media?: number;
  precioAlt?: number;
  notaPrecio?: string;
  precioTexto?: string;
  descripcion?: string;
  destacado?: boolean;
  imagen?: string;
  index?: number;
}

const {
  nombre,
  precio,
  media,
  precioAlt,
  notaPrecio,
  precioTexto,
  descripcion,
  destacado,
  imagen,
  index = 0,
} = Astro.props;

const money = (n: number) => '$' + n.toLocaleString('es-CO');

// Mapeo automático de fotos reales existentes en el proyecto
const knownImages: Record<string, string> = {
  'pescado frito (mojarra)': '/assets/mojarra-frita-sq.jpg',
  'mojarra frita': '/assets/mojarra-frita-sq.jpg',
  'camarones apanados': '/assets/camarones-apanados-sq.jpg',
};

const dishKey = nombre.toLowerCase().trim();
const photoSrc = imagen || knownImages[dishKey] || null;
const dishSlug = dishKey.replace(/[^a-z0-9]/g, '-');
const itemDelay = ((index % 6) * 0.05).toFixed(2);
---

<li
  class="menu-item menu-dish-card"
  data-dish-name={nombre.toLowerCase()}
  data-dish-desc={descripcion ? descripcion.toLowerCase() : ''}
  data-sr
  data-sr-direction="up"
  data-sr-delay={itemDelay}
>
  <!-- Fila principal clickeable (Trigger de acordeón vertical) -->
  <div
    class="menu-dish-summary"
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-controls={`dish-desc-${dishSlug}`}
    title={`Toca para ver detalles de ${nombre}`}
  >
    <!-- 1. Foto / Miniatura a la izquierda -->
    <div class="menu-dish-thumb">
      {photoSrc ? (
        <img
          src={photoSrc}
          alt={nombre}
          width="54"
          height="54"
          loading="lazy"
          class="dish-thumb-img"
        />
      ) : (
        <div class="dish-thumb-placeholder" title="Foto en preparación">
          <Icon name="camera" size={16} />
        </div>
      )}
    </div>

    <!-- 2. Información del plato (Nombre y badge de favorito) -->
    <div class="menu-dish-info">
      <div class="menu-dish-title-wrap">
        <span class="menu-dish-name">{nombre}</span>
        {destacado && <span class="menu-item__badge">Favorito</span>}
      </div>
      <span class="menu-dish-hint">Toca para ver más</span>
    </div>

    <!-- 3. Columna fija y alineada para precio y botón (+) -->
    <div class="menu-dish-side">
      <div class="menu-dish-price">
        {precioTexto ? (
          <span class="price-main">{precioTexto}</span>
        ) : precioAlt && precio ? (
          <div class="price-stack">
            <span class="price-main">{money(precio)}</span>
            <small class="price-sub">/ {money(precioAlt)}</small>
          </div>
        ) : media && precio ? (
          <div class="price-stack">
            <span class="price-main">{money(precio)}</span>
            <small class="price-sub">media {money(media)}</small>
          </div>
        ) : precio ? (
          <span class="price-main">{money(precio)}</span>
        ) : (
          <span class="price-main price-main--quote">Por cotizar</span>
        )}
      </div>

      <span class="menu-dish-chevron" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </div>
  </div>

  <!-- Contenido desplegable vertical tipo acordeón con animación suave y visible -->
  <div class="menu-dish-accordion" id={`dish-desc-${dishSlug}`}>
    <div class="menu-dish-accordion__body">
      {photoSrc ? (
        <div class="accordion-photo-wrap">
          <img src={photoSrc} alt={nombre} width="320" height="200" loading="lazy" />
        </div>
      ) : (
        <div class="accordion-placeholder-wrap">
          <Icon name="camera" size={26} />
          <span>Foto disponible muy pronto</span>
        </div>
      )}

      <div class="accordion-info-wrap">
        <p class="accordion-desc">
          {descripcion || 'Preparado fresco al momento con la receta tradicional de la casa, porciones generosas y el auténtico toque marinero de Armenia.'}
        </p>

        {notaPrecio && (
          <p class="accordion-price-note">
            ℹ️ {notaPrecio}
          </p>
        )}
      </div>
    </div>
  </div>
</li>

<style>
  /* Contenedor tipo tarjeta / fila interactiva */
  .menu-dish-card {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-bottom: 1px dashed var(--line);
    padding: 0.6rem 0.35rem;
    border-radius: 12px;
    transition: background-color 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  }

  .menu-dish-card:hover {
    background: rgba(14, 90, 114, 0.03);
  }

  .menu-dish-card.is-expanded {
    background: rgba(14, 90, 114, 0.045);
    border-bottom-color: rgba(217, 154, 63, 0.45);
    box-shadow: 0 4px 18px rgba(5, 20, 35, 0.05);
  }

  /* Fila de cabecera que actúa como botón de acordeón */
  .menu-dish-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    padding: 0.15rem 0.1rem;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }

  .menu-dish-summary:focus-visible {
    outline: 2px solid var(--teal-600);
    outline-offset: 2px;
  }

  /* 1. Miniatura a la izquierda con micro-animación */
  .menu-dish-thumb {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--sand);
    border: 1.5px solid var(--line);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-thumb {
    transform: scale(1.06);
    border-color: var(--gold-500);
    box-shadow: 0 4px 14px rgba(217, 154, 63, 0.28);
  }

  .dish-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dish-thumb-placeholder {
    display: grid;
    place-items: center;
    color: var(--muted);
    opacity: 0.7;
  }

  /* 2. Información del plato */
  .menu-dish-info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
  }

  .menu-dish-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .menu-dish-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-name {
    color: var(--teal-800);
    font-weight: 700;
  }

  .menu-dish-hint {
    font-size: 0.7rem;
    color: var(--teal-600);
    font-weight: 500;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-hint {
    opacity: 0.5;
  }

  /* 3. Columna derecha fija de precio y botón (+) */
  .menu-dish-side {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  .menu-dish-price {
    text-align: right;
    min-width: 72px;
  }

  .price-main {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--teal-700);
    white-space: nowrap;
    display: block;
    line-height: 1.1;
  }

  .price-main--quote {
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
  }

  .price-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .price-sub {
    display: block;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    line-height: 1.1;
    margin-top: 0.15rem;
  }



  /* Indicador chevron de acordeón con rotación fluida */
  .menu-dish-chevron {
    color: var(--muted);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.25s ease;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
  }

  .menu-dish-card.is-expanded .menu-dish-chevron {
    transform: rotate(180deg);
    color: var(--teal-700);
  }

  /* -------------------------------------------------------------
     Contenedor de Acordeón con Transición Fluida Garantizada (Grid + Opacidad)
     ------------------------------------------------------------- */
  .menu-dish-accordion {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: 0;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-accordion {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* min-height: 0 es requisito obligatorio de la especificación CSS Grid para interpolar filas */
  .menu-dish-accordion__body {
    min-height: 0;
    overflow: hidden;
    padding: 0 0.4rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 0.65s ease,
                transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-dish-card.is-expanded .menu-dish-accordion__body {
    opacity: 1;
    transform: translateY(0);
    padding: 0.95rem 0.4rem 0.65rem 4rem;
  }

  /* Foto ampliada con zoom suave al abrirse (0.85s) */
  .accordion-photo-wrap {
    width: 100%;
    max-width: 280px;
    border-radius: 11px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 4px 16px rgba(5, 20, 35, 0.1);
    transform: scale(0.95);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
  }

  .menu-dish-card.is-expanded .accordion-photo-wrap {
    transform: scale(1);
  }

  .accordion-photo-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .accordion-placeholder-wrap {
    background: var(--sand);
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 0.85rem 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.82rem;
    width: fit-content;
    transform: scale(0.97);
    transition: transform 0.4s ease;
  }

  .menu-dish-card.is-expanded .accordion-placeholder-wrap {
    transform: scale(1);
  }

  .accordion-info-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.38s ease 0.06s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.06s;
  }

  .menu-dish-card.is-expanded .accordion-info-wrap {
    opacity: 1;
    transform: translateY(0);
  }

  .accordion-desc {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.52;
    margin: 0;
  }

  .accordion-price-note {
    font-size: 0.8rem;
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .menu-dish-thumb {
      width: 46px;
      height: 46px;
      min-width: 46px;
    }

    .menu-dish-name {
      font-size: 0.92rem;
    }

    .menu-dish-price {
      min-width: 64px;
    }

    .price-main {
      font-size: 0.92rem;
    }

    .menu-dish-accordion__body {
      padding: 0 0.2rem;
    }
    
    .menu-dish-card.is-expanded .menu-dish-accordion__body {
      padding: 0.85rem 0.25rem 0.6rem 0.25rem;
    }
  }
</style>

<script>
  function setupDishAccordions() {
    if ((window as any).__dishAccordionInitialized) return;
    (window as any).__dishAccordionInitialized = true;

    // Delegación de clics
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const summary = target.closest('.menu-dish-summary') as HTMLElement | null;
      if (summary) {
        const card = summary.closest('.menu-dish-card');
        if (card) {
          const isOpen = card.classList.toggle('is-expanded');
          summary.setAttribute('aria-expanded', String(isOpen));
        }
      }
    });

    // Accesibilidad mediante teclado (Enter o Barra Espaciadora)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const target = e.target as HTMLElement | null;
        if (target && target.classList.contains('menu-dish-summary')) {
          e.preventDefault();
          const card = target.closest('.menu-dish-card');
          if (card) {
            const isOpen = card.classList.toggle('is-expanded');
            target.setAttribute('aria-expanded', String(isOpen));
          }
        }
      }
    });
  }

  setupDishAccordions();
  document.addEventListener('DOMContentLoaded', setupDishAccordions);
  document.addEventListener('astro:page-load', setupDishAccordions);
</script>
