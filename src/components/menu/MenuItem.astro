---
import Icon from '../icons/Icon.astro';

interface Props {
  nombre: string;
  precio?: number;
  media?: number;
  precioAlt?: number;
  notaPrecio?: string;
  precioTexto?: string;
  descripcion?: string;
  destacado?: boolean;
  imagen?: string;
}

const {
  nombre,
  precio,
  media,
  precioAlt,
  notaPrecio,
  precioTexto,
  descripcion,
  destacado,
  imagen,
} = Astro.props;

const money = (n: number) => '$' + n.toLocaleString('es-CO');

// Mapeo automático de fotos reales existentes en el proyecto
const knownImages: Record<string, string> = {
  'pescado frito (mojarra)': '/assets/mojarra-frita-sq.jpg',
  'mojarra frita': '/assets/mojarra-frita-sq.jpg',
  'camarones apanados': '/assets/camarones-apanados-sq.jpg',
};

const dishKey = nombre.toLowerCase().trim();
const photoSrc = imagen || knownImages[dishKey] || null;
const dishSlug = dishKey.replace(/[^a-z0-9]/g, '-');
---

<li
  class="menu-item menu-dish-card"
  data-dish-name={nombre.toLowerCase()}
  data-dish-desc={descripcion ? descripcion.toLowerCase() : ''}
>
  <!-- Fila principal clickeable (Trigger de acordeón vertical) -->
  <div
    class="menu-dish-summary"
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-controls={`dish-desc-${dishSlug}`}
    title={`Toca para ver detalles de ${nombre}`}
  >
    <!-- 1. Foto / Miniatura a la izquierda -->
    <div class="menu-dish-thumb">
      {photoSrc ? (
        <img
          src={photoSrc}
          alt={nombre}
          width="54"
          height="54"
          loading="lazy"
          class="dish-thumb-img"
        />
      ) : (
        <div class="dish-thumb-placeholder" title="Foto en preparación">
          <Icon name="camera" size={16} />
        </div>
      )}
    </div>

    <!-- 2. Información del plato (Nombre y badge de favorito) -->
    <div class="menu-dish-info">
      <div class="menu-dish-title-wrap">
        <span class="menu-dish-name">{nombre}</span>
        {destacado && <span class="menu-item__badge">Favorito</span>}
      </div>
      <span class="menu-dish-hint">Toca para ver más</span>
    </div>

    <!-- 3. Columna fija y alineada para precio y botón (+) -->
    <div class="menu-dish-side">
      <div class="menu-dish-price">
        {precioTexto ? (
          <span class="price-main">{precioTexto}</span>
        ) : precioAlt && precio ? (
          <div class="price-stack">
            <span class="price-main">{money(precio)}</span>
            <small class="price-sub">/ {money(precioAlt)}</small>
          </div>
        ) : media && precio ? (
          <div class="price-stack">
            <span class="price-main">{money(precio)}</span>
            <small class="price-sub">media {money(media)}</small>
          </div>
        ) : precio ? (
          <span class="price-main">{money(precio)}</span>
        ) : (
          <span class="price-main price-main--quote">Por cotizar</span>
        )}
      </div>

      <button
        type="button"
        class="menu-item__add-btn"
        data-dish-add
        data-dish-name={nombre}
        data-dish-price={precio || 0}
        data-track-event="add_dish_to_bag"
        data-track-product={nombre}
        data-track-location="menu_item"
        title={`Añadir ${nombre} a mi pedido`}
        aria-label={`Añadir ${nombre} a mi pedido`}
      >
        <span aria-hidden="true">+</span>
        <span class="sr-only">Añadir a mi pedido</span>
      </button>

      <span class="menu-dish-chevron" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </div>
  </div>

  <!-- Contenido desplegable vertical tipo acordeón con animación suave y visible -->
  <div class="menu-dish-accordion" id={`dish-desc-${dishSlug}`}>
    <div class="menu-dish-accordion__body">
      {photoSrc ? (
        <div class="accordion-photo-wrap">
          <img src={photoSrc} alt={nombre} width="320" height="200" loading="lazy" />
        </div>
      ) : (
        <div class="accordion-placeholder-wrap">
          <Icon name="camera" size={26} />
          <span>Foto disponible muy pronto</span>
        </div>
      )}

      <div class="accordion-info-wrap">
        <p class="accordion-desc">
          {descripcion || 'Preparado fresco al momento con la receta tradicional de la casa, porciones generosas y el auténtico toque marinero de Armenia.'}
        </p>

        {notaPrecio && (
          <p class="accordion-price-note">
            ℹ️ {notaPrecio}
          </p>
        )}

        <button
          type="button"
          class="accordion-order-cta"
          data-dish-add
          data-dish-name={nombre}
          data-dish-price={precio || 0}
          title={`Añadir ${nombre} a mi pedido`}
          aria-label={`Añadir ${nombre} a mi pedido`}
        >
          <span class="btn-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </span>
          <span class="btn-text">Añadir a mi pedido {precio ? `(${money(precio)})` : ''}</span>
          <span class="btn-check-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </div>
</li>

<style>
  /* Contenedor tipo tarjeta / fila interactiva */
  .menu-dish-card {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-bottom: 1px dashed var(--line);
    padding: 0.6rem 0.35rem;
    border-radius: 12px;
    transition: background-color 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  }

  .menu-dish-card:hover {
    background: rgba(14, 90, 114, 0.03);
  }

  .menu-dish-card.is-expanded {
    background: rgba(14, 90, 114, 0.045);
    border-bottom-color: rgba(217, 154, 63, 0.45);
    box-shadow: 0 4px 18px rgba(5, 20, 35, 0.05);
  }

  /* Fila de cabecera que actúa como botón de acordeón */
  .menu-dish-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    padding: 0.15rem 0.1rem;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }

  .menu-dish-summary:focus-visible {
    outline: 2px solid var(--teal-600);
    outline-offset: 2px;
  }

  /* 1. Miniatura a la izquierda con micro-animación */
  .menu-dish-thumb {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--sand);
    border: 1.5px solid var(--line);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-thumb {
    transform: scale(1.06);
    border-color: var(--gold-500);
    box-shadow: 0 4px 14px rgba(217, 154, 63, 0.28);
  }

  .dish-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dish-thumb-placeholder {
    display: grid;
    place-items: center;
    color: var(--muted);
    opacity: 0.7;
  }

  /* 2. Información del plato */
  .menu-dish-info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
  }

  .menu-dish-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .menu-dish-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-name {
    color: var(--teal-800);
    font-weight: 700;
  }

  .menu-dish-hint {
    font-size: 0.7rem;
    color: var(--teal-600);
    font-weight: 500;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-hint {
    opacity: 0.5;
  }

  /* 3. Columna derecha fija de precio y botón (+) */
  .menu-dish-side {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  .menu-dish-price {
    text-align: right;
    min-width: 72px;
  }

  .price-main {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--teal-700);
    white-space: nowrap;
    display: block;
    line-height: 1.1;
  }

  .price-main--quote {
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
  }

  .price-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .price-sub {
    display: block;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    line-height: 1.1;
    margin-top: 0.15rem;
  }

  /* Botón (+) circular con medidas precisas e indeformables */
  .menu-item__add-btn {
    width: 30px !important;
    height: 30px !important;
    min-width: 30px !important;
    max-width: 30px !important;
    border-radius: 50% !important;
    border: 1.5px solid var(--teal-600) !important;
    background: #ffffff !important;
    color: var(--teal-700) !important;
    font-size: 1.15rem !important;
    font-weight: 750 !important;
    line-height: 1 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all 0.18s ease !important;
    padding: 0 !important;
    flex-shrink: 0 !important;
    box-sizing: border-box !important;
  }

  .menu-item__add-btn:hover {
    background: var(--teal-600) !important;
    color: #ffffff !important;
    transform: scale(1.1) !important;
  }

  .menu-item__add-btn:active {
    transform: scale(0.94) !important;
  }

  /* Indicador chevron de acordeón con rotación fluida */
  .menu-dish-chevron {
    color: var(--muted);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.25s ease;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
  }

  .menu-dish-card.is-expanded .menu-dish-chevron {
    transform: rotate(180deg);
    color: var(--teal-700);
  }

  /* -------------------------------------------------------------
     Contenedor de Acordeón con Transición Fluida Garantizada (Grid + Opacidad)
     ------------------------------------------------------------- */
  .menu-dish-accordion {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: 0;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-accordion {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* min-height: 0 es requisito obligatorio de la especificación CSS Grid para interpolar filas */
  .menu-dish-accordion__body {
    min-height: 0;
    overflow: hidden;
    padding: 0 0.4rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 0.38s ease,
                transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-dish-card.is-expanded .menu-dish-accordion__body {
    opacity: 1;
    transform: translateY(0);
    padding: 0.95rem 0.4rem 0.65rem 4rem;
  }

  /* Foto ampliada con zoom suave al abrirse */
  .accordion-photo-wrap {
    width: 100%;
    max-width: 280px;
    border-radius: 11px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 4px 16px rgba(5, 20, 35, 0.1);
    transform: scale(0.96);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .menu-dish-card.is-expanded .accordion-photo-wrap {
    transform: scale(1);
  }

  .accordion-photo-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .accordion-placeholder-wrap {
    background: var(--sand);
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 0.85rem 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.82rem;
    width: fit-content;
    transform: scale(0.97);
    transition: transform 0.4s ease;
  }

  .menu-dish-card.is-expanded .accordion-placeholder-wrap {
    transform: scale(1);
  }

  .accordion-info-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.38s ease 0.06s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.06s;
  }

  .menu-dish-card.is-expanded .accordion-info-wrap {
    opacity: 1;
    transform: translateY(0);
  }

  .accordion-desc {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.52;
    margin: 0;
  }

  .accordion-price-note {
    font-size: 0.8rem;
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  .accordion-order-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #071f38 0%, #0a2e52 48%, #0e5a72 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 750;
    padding: 0.52rem 1.2rem;
    border-radius: 999px;
    border: 1.5px solid rgba(226, 168, 66, 0.45);
    cursor: pointer;
    width: fit-content;
    margin-top: 0.35rem;
    box-shadow: 0 4px 14px rgba(5, 20, 35, 0.22), 0 0 10px rgba(226, 168, 66, 0.18);
    transform: scale(0.96);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .accordion-order-cta::before {
    content: "";
    position: absolute;
    top: 0;
    left: -80%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.25),
      transparent
    );
    transform: skewX(-20deg);
    transition: left 0.6s ease;
    pointer-events: none;
  }

  .menu-dish-card.is-expanded .accordion-order-cta {
    transform: scale(1);
  }

  .accordion-order-cta:hover {
    background: linear-gradient(135deg, #0a2e52 0%, #0e5a72 55%, #13718c 100%);
    border-color: var(--gold-300);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 18px rgba(5, 20, 35, 0.3), 0 0 14px rgba(226, 168, 66, 0.35);
  }

  .accordion-order-cta:hover::before {
    left: 130%;
  }

  .accordion-order-cta:active {
    transform: translateY(0) scale(0.96);
  }

  .accordion-order-cta .btn-icon {
    display: inline-flex;
    align-items: center;
    transition: transform 0.25s ease;
    color: var(--gold-400);
  }

  .accordion-order-cta:hover .btn-icon {
    transform: rotate(90deg);
    color: #ffffff;
  }

  .accordion-order-cta .btn-check-icon {
    display: none;
  }

  .accordion-order-cta.is-added {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
    border-color: #6ee7b7 !important;
    box-shadow: 0 0 18px rgba(16, 185, 129, 0.5) !important;
    transform: scale(1.03);
    color: #ffffff !important;
  }

  .accordion-order-cta.is-added .btn-icon {
    display: none;
  }

  .accordion-order-cta.is-added .btn-check-icon {
    display: inline-flex;
    color: #ffffff;
  }

  /* Resalte moderno exclusivo para platos con badge 'Favorito' */
  .menu-dish-card:has(.menu-item__badge) .menu-item__add-btn {
    border-color: var(--gold-500) !important;
    color: var(--gold-600) !important;
    background: #fffdf8 !important;
    box-shadow: 0 0 10px rgba(226, 168, 66, 0.3) !important;
  }

  .menu-dish-card:has(.menu-item__badge) .menu-item__add-btn:hover {
    background: var(--gold-500) !important;
    color: var(--navy-950) !important;
    border-color: var(--gold-400) !important;
    box-shadow: 0 4px 14px rgba(226, 168, 66, 0.45) !important;
  }

  .menu-dish-card:has(.menu-item__badge) .accordion-order-cta {
    border: 1.5px solid var(--gold-400);
    box-shadow: 0 4px 14px rgba(5, 20, 35, 0.25), 0 0 12px rgba(226, 168, 66, 0.26);
  }

  .menu-item__add-btn.is-added {
    background: #10b981 !important;
    border-color: #10b981 !important;
    color: #ffffff !important;
    transform: scale(1.15) !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .menu-dish-thumb {
      width: 46px;
      height: 46px;
      min-width: 46px;
    }

    .menu-dish-name {
      font-size: 0.92rem;
    }

    .menu-dish-price {
      min-width: 64px;
    }

    .price-main {
      font-size: 0.92rem;
    }

    .menu-item__add-btn {
      width: 28px !important;
      height: 28px !important;
      min-width: 28px !important;
      max-width: 28px !important;
      font-size: 1.05rem !important;
    }

    .menu-dish-accordion__body {
      padding: 0 0.2rem;
    }
    
    .menu-dish-card.is-expanded .menu-dish-accordion__body {
      padding: 0.85rem 0.25rem 0.6rem 0.25rem;
    }
  }
</style>

<script>
  function setupDishAccordions() {
    if ((window as any).__dishAccordionInitialized) return;
    (window as any).__dishAccordionInitialized = true;

    // Delegación de clics
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Si el usuario hace clic en añadir plato (+), no alternar el acordeón
      if (target.closest('[data-dish-add]')) {
        return;
      }

      const summary = target.closest('.menu-dish-summary') as HTMLElement | null;
      if (summary) {
        const card = summary.closest('.menu-dish-card');
        if (card) {
          const isOpen = card.classList.toggle('is-expanded');
          summary.setAttribute('aria-expanded', String(isOpen));
        }
      }
    });

    // Accesibilidad mediante teclado (Enter o Barra Espaciadora)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const target = e.target as HTMLElement | null;
        if (target && target.classList.contains('menu-dish-summary')) {
          e.preventDefault();
          const card = target.closest('.menu-dish-card');
          if (card) {
            const isOpen = card.classList.toggle('is-expanded');
            target.setAttribute('aria-expanded', String(isOpen));
          }
        }
      }
    });
  }

  setupDishAccordions();
  document.addEventListener('DOMContentLoaded', setupDishAccordions);
  document.addEventListener('astro:page-load', setupDishAccordions);
</script>
