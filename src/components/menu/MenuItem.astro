---
import { getDishGallery } from '../../utils/dishMatcher';

interface Props {
  nombre: string;
  precio?: number;
  media?: number;
  precioAlt?: number;
  notaPrecio?: string;
  precioTexto?: string;
  descripcion?: string;
  destacado?: boolean;
  imagen?: string;
  index?: number;
}

const {
  nombre,
  precio,
  media,
  precioAlt,
  notaPrecio,
  precioTexto,
  descripcion,
  destacado,
  imagen,
  index = 0,
} = Astro.props;

const money = (n: number) => '$' + n.toLocaleString('es-CO');

// Consulta de fotos reales en el catálogo generado por el script
const gallery = getDishGallery(nombre);
const hasGallery = !!(gallery && gallery.photos && gallery.photos.length > 0);

// Miniatura para la fila principal (usa thumbnail WebP ultra ligero si existe)
const photoThumbSrc = gallery?.coverThumb || gallery?.cover || imagen || null;
const photoFullSrc = gallery?.cover || imagen || null;
const hasAnyPhoto = hasGallery || !!photoFullSrc;

const dishKey = nombre.toLowerCase().trim();
const dishSlug = dishKey.replace(/[^a-z0-9]/g, '-');
const itemDelay = ((index % 6) * 0.05).toFixed(2);
---

<li
  class:list={[
    'menu-item menu-dish-card',
    { 'has-no-photo': !hasAnyPhoto }
  ]}
  data-dish-name={nombre.toLowerCase()}
  data-dish-desc={descripcion ? descripcion.toLowerCase() : ''}
  data-sr
  data-sr-direction="up"
  data-sr-delay={itemDelay}
>
  <!-- Fila principal (Interactivo solo si contiene fotos para desplegar) -->
  <div
    class:list={[
      'menu-dish-summary',
      { 'is-interactive': hasAnyPhoto }
    ]}
    role={hasAnyPhoto ? 'button' : undefined}
    tabindex={hasAnyPhoto ? 0 : undefined}
    aria-expanded={hasAnyPhoto ? 'false' : undefined}
    aria-controls={hasAnyPhoto ? `dish-desc-${dishSlug}` : undefined}
    title={hasAnyPhoto ? `Toca para ver fotos de ${nombre}` : undefined}
  >
    <!-- 1. Miniatura SOLO si tiene foto real -->
    {photoThumbSrc && (
      <div class="menu-dish-thumb">
        <img
          src={photoThumbSrc}
          alt={nombre}
          width="54"
          height="54"
          loading="lazy"
          decoding="async"
          class="dish-thumb-img"
        />
      </div>
    )}

    <!-- 2. Información del plato (Nombre, badge favorito y descripción visible debajo) -->
    <div class="menu-dish-info">
      <div class="menu-dish-title-wrap">
        <span class="menu-dish-name">{nombre}</span>
        {destacado && (
          <span
            class="favorite-badge-wrap"
            data-favorite-badge
            tabindex="0"
            role="button"
            aria-label="Plato favorito recomendado"
            title="Toca para ver información"
          >
            <img
              src="/assets/check-favorite-plate (1).svg"
              alt="Favorito"
              class="favorite-badge-icon"
              width="20"
              height="20"
              loading="lazy"
            />
            <span class="favorite-badge-tooltip" role="tooltip">Favorito</span>
          </span>
        )}
      </div>

      {descripcion && (
        <p class="menu-dish-desc">{descripcion}</p>
      )}
    </div>

    <!-- 3. Columna fija y alineada para precio y chevron (solo si tiene fotos) -->
    <div class="menu-dish-side">
      <div class="menu-dish-price">
        {precioTexto ? (
          <span class="price-main price-main--quote">{precioTexto}</span>
        ) : precioAlt && precio ? (
          <div class="price-stack">
            <span class="price-main">
              {money(precio)} <span class="price-slash">/</span> {money(precioAlt)}
            </span>
            <small class="price-sub">{notaPrecio || 'Normal / Súper'}</small>
          </div>
        ) : media && precio ? (
          <div class="price-stack">
            <span class="price-main">{money(precio)}</span>
            <small class="price-sub">media {money(media)}</small>
          </div>
        ) : precio ? (
          <span class="price-main">{money(precio)}</span>
        ) : (
          <span class="price-main price-main--quote">Por cotizar</span>
        )}
      </div>

      <span class:list={['menu-dish-chevron', { 'is-empty': !hasAnyPhoto }]} aria-hidden="true">
        {hasAnyPhoto && (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        )}
      </span>
    </div>
  </div>

  <!-- Contenido desplegable vertical tipo acordeón (solo revela fotos) -->
  {hasAnyPhoto && (
    <div class="menu-dish-accordion" id={`dish-desc-${dishSlug}`}>
      <div class="menu-dish-accordion__body">
        {hasGallery ? (
          <div class="dish-gallery-block">
            <div class="dish-gallery-strip">
              {gallery.photos.map((pUrl, pIdx) => {
                const thumbUrl = gallery.thumbs[pIdx] || pUrl;
                return (
                  <button
                    type="button"
                    class="dish-gallery-item"
                    data-open-gallery={JSON.stringify({
                      dishName: nombre,
                      photos: gallery.photos,
                      thumbs: gallery.thumbs,
                      startIndex: pIdx
                    })}
                    title={`Foto ${pIdx + 1} de ${nombre}`}
                    aria-label={`Ver foto ${pIdx + 1} de ${nombre}`}
                  >
                    <img
                      src={thumbUrl}
                      alt={`${nombre} ${pIdx + 1}`}
                      width="120"
                      height="80"
                      loading="lazy"
                      decoding="async"
                      class="dish-gallery-item__img"
                    />
                  </button>
                );
              })}
            </div>
          </div>
        ) : photoFullSrc ? (
          <div class="accordion-photo-wrap">
            <img src={photoFullSrc} alt={nombre} width="320" height="200" loading="lazy" decoding="async" />
          </div>
        ) : null}
      </div>
    </div>
  )}
</li>

<style>
  /* Fila interactiva con línea segmentada únicamente en la parte inferior */
  .menu-dish-card {
    list-style: none;
    display: block;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    padding: 0.75rem 0.2rem;
    margin-bottom: 0.1rem;
    border-radius: 0;
    border: none;
    border-bottom: 1px dashed rgba(10, 37, 64, 0.14);
    background: transparent;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .menu-dish-card:hover {
    border-bottom-color: var(--teal-600, #14738f);
    border-bottom-style: solid;
    background: rgba(14, 90, 114, 0.015);
    border-radius: 6px;
  }

  .menu-dish-card.is-expanded {
    border-bottom-color: var(--teal-600, #14738f);
    border-bottom-style: solid;
    background: rgba(14, 90, 114, 0.025);
    border-radius: 8px;
  }

  /* Fila de cabecera que actúa como botón de acordeón */
  .menu-dish-summary {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    width: 100%;
    cursor: default;
    user-select: text;
    padding: 0.1rem 0;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }

  .menu-dish-summary.is-interactive {
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .menu-dish-summary.is-interactive:focus-visible {
    outline: 2px solid var(--teal-600);
    outline-offset: 2px;
  }

  /* 1. Miniatura a la izquierda */
  .menu-dish-thumb {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-dish-card.is-expanded .menu-dish-thumb {
    transform: scale(1.05);
  }

  .dish-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 2. Información del plato */
  .menu-dish-info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.2rem;
  }

  .menu-dish-title-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: nowrap;
    max-width: 100%;
  }

  /* Insignia de plato Favorito / Recomendado */
  .favorite-badge-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    cursor: pointer;
    vertical-align: middle;
    outline: none;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .favorite-badge-icon {
    width: 20px;
    height: 20px;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 1px 3px rgba(10, 37, 64, 0.15));
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .favorite-badge-wrap:hover .favorite-badge-icon,
  .favorite-badge-wrap:focus-visible .favorite-badge-icon {
    transform: scale(1.18);
  }

  /* Tooltip con auto-desaparición a los 3 segundos o en hover */
  .favorite-badge-tooltip {
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: #071f38;
    color: #ffffff;
    font-family: var(--font-body, "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 4px 14px rgba(5, 20, 35, 0.28);
    border: 1px solid rgba(226, 168, 66, 0.4);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
    z-index: 30;
  }

  .favorite-badge-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 4px;
    border-style: solid;
    border-color: #071f38 transparent transparent transparent;
  }

  .favorite-badge-wrap.is-tooltip-visible .favorite-badge-tooltip,
  .favorite-badge-wrap:hover .favorite-badge-tooltip,
  .favorite-badge-wrap:focus-visible .favorite-badge-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .menu-dish-name {
    font-family: var(--font-display, serif);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink, #0f172a);
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-name {
    color: var(--teal-800, #0a3d4d);
    font-weight: 700;
  }

  /* Descripción visible directamente debajo del plato */
  .menu-dish-desc {
    font-family: var(--font-body, "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: 0.835rem;
    color: var(--ink-soft, #475569);
    line-height: 1.44;
    margin: 0.15rem 0 0;
    padding-right: 0.4rem;
    letter-spacing: -0.005em;
  }

  /* 3. Columna derecha fija de precio y chevron */
  .menu-dish-side {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    margin-left: auto;
    margin-top: 0.1rem;
  }

  .menu-dish-price {
    text-align: right;
    min-width: 72px;
  }

  .price-main {
    font-family: var(--font-display, serif);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--teal-700, #0e5a72);
    white-space: nowrap;
    display: block;
    line-height: 1.1;
  }

  .price-slash {
    font-size: 0.85em;
    font-weight: 400;
    color: var(--muted, #64748b);
    opacity: 0.65;
    margin: 0 0.05rem;
  }

  .price-main--quote {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.78rem;
    color: var(--teal-700, #0e5a72);
    font-weight: 600;
    white-space: normal;
    text-align: right;
    max-width: 125px;
    line-height: 1.25;
    display: inline-block;
  }

  .price-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .price-sub {
    display: block;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--muted, #64748b);
    letter-spacing: 0.02em;
    white-space: nowrap;
    line-height: 1.1;
    margin-top: 0.2rem;
  }

  /* Indicador chevron */
  .menu-dish-chevron {
    color: var(--muted, #64748b);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.25s ease;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .menu-dish-chevron.is-empty {
    visibility: hidden;
    pointer-events: none;
  }

  .menu-dish-card.is-expanded .menu-dish-chevron {
    transform: rotate(180deg);
    color: var(--teal-700, #0e5a72);
  }

  /* Acordeón para revelar fotos */
  .menu-dish-accordion {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: 0;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease;
  }

  .menu-dish-card.is-expanded .menu-dish-accordion {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .menu-dish-accordion__body {
    min-height: 0;
    overflow: hidden;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.5s ease,
                transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-dish-card.is-expanded .menu-dish-accordion__body {
    opacity: 1;
    transform: translateY(0);
    padding: 0.85rem 0.2rem 0.45rem 0;
  }

  /* Bloque de Galería */
  .dish-gallery-block {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 0;
  }

  /* Tira fotográfica horizontal limpia con arrastre para PC y táctil en móviles */
  .dish-gallery-strip {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0.2rem 0.05rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    cursor: -webkit-grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .dish-gallery-strip::-webkit-scrollbar {
    display: none;
  }

  .dish-gallery-strip.is-dragging {
    cursor: grabbing !important;
    cursor: -webkit-grabbing !important;
    scroll-snap-type: none !important;
    scroll-behavior: auto !important;
  }

  .dish-gallery-strip.is-dragging .dish-gallery-item {
    cursor: grabbing !important;
    cursor: -webkit-grabbing !important;
    pointer-events: none;
    transform: none !important;
  }

  .dish-gallery-item {
    position: relative;
    flex: 0 0 115px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--line, #e2e8f0);
    padding: 0;
    background: var(--sand, #f8f6f0);
    cursor: pointer;
    scroll-snap-align: start;
    box-shadow: 0 2px 6px rgba(5, 20, 35, 0.05);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease;
    user-select: none;
    -webkit-user-select: none;
  }

  .dish-gallery-item:hover {
    transform: scale(1.04);
    border-color: var(--gold-500, #d99a3f);
  }

  .dish-gallery-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }

  /* Foto individual previa (fallback) */
  .accordion-photo-wrap {
    width: 100%;
    max-width: 260px;
    border-radius: 11px;
    overflow: hidden;
    border: 1px solid var(--line, #e2e8f0);
    box-shadow: 0 4px 16px rgba(5, 20, 35, 0.1);
  }

  .accordion-photo-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .menu-dish-thumb {
      width: 46px;
      height: 46px;
      min-width: 46px;
    }

    .menu-dish-name {
      font-size: 0.92rem;
    }

    .menu-dish-desc {
      font-size: 0.785rem;
      line-height: 1.38;
    }

    .menu-dish-price {
      min-width: 64px;
    }

    .price-main {
      font-size: 0.92rem;
    }

    .dish-gallery-item {
      flex: 0 0 135px;
      height: 95px;
    }
  }
</style>

<script>
  function setupDishAccordions() {
    if ((window as any).__dishAccordionInitialized) return;
    (window as any).__dishAccordionInitialized = true;

    // --- Arrastre horizontal con clic de ratón (Drag-to-scroll para PC) ---
    let activeDragStrip: HTMLElement | null = null;
    let startX = 0;
    let scrollLeftStart = 0;
    let hasDragged = false;
    let suppressClickUntil = 0;

    // Iniciar arrastre con botón izquierdo del ratón
    document.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return; // Solo clic principal
      const strip = (e.target as HTMLElement)?.closest('.dish-gallery-strip') as HTMLElement | null;
      if (!strip) return;

      activeDragStrip = strip;
      startX = e.pageX;
      scrollLeftStart = strip.scrollLeft;
      hasDragged = false;
    });

    // Desplazamiento dinámico al mover el ratón
    window.addEventListener('mousemove', (e) => {
      if (!activeDragStrip) return;
      const dx = e.pageX - startX;
      if (!hasDragged && Math.abs(dx) > 4) {
        hasDragged = true;
        activeDragStrip.classList.add('is-dragging');
        activeDragStrip.style.scrollSnapType = 'none';
      }
      if (hasDragged) {
        e.preventDefault();
        activeDragStrip.scrollLeft = scrollLeftStart - dx;
      }
    });

    function finishDrag() {
      if (!activeDragStrip) return;
      const strip = activeDragStrip;
      activeDragStrip = null;

      if (hasDragged) {
        suppressClickUntil = Date.now() + 150;
      }

      strip.classList.remove('is-dragging');
      setTimeout(() => {
        if (strip) strip.style.scrollSnapType = '';
      }, 50);
    }

    window.addEventListener('mouseup', finishDrag);
    window.addEventListener('blur', finishDrag);

    // Evitar arrastre fantasma de imágenes nativo
    document.addEventListener('dragstart', (e) => {
      if ((e.target as HTMLElement)?.closest('.dish-gallery-strip')) {
        e.preventDefault();
      }
    });

    // Soporte de rueda de ratón (Mouse wheel horizontal en PC)
    document.addEventListener(
      'wheel',
      (e) => {
        const strip = (e.target as HTMLElement)?.closest('.dish-gallery-strip') as HTMLElement | null;
        if (!strip) return;
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          const maxScroll = strip.scrollWidth - strip.clientWidth;
          if (maxScroll > 0) {
            const canLeft = strip.scrollLeft > 0 && e.deltaY < 0;
            const canRight = strip.scrollLeft < maxScroll - 1 && e.deltaY > 0;
            if (canLeft || canRight) {
              e.preventDefault();
              strip.scrollLeft += e.deltaY;
            }
          }
        }
      },
      { passive: false }
    );

    // Interceptar clics si se estaba arrastrando para evitar abrir el modal por error
    document.addEventListener(
      'click',
      (e) => {
        if (Date.now() < suppressClickUntil) {
          e.stopPropagation();
          e.preventDefault();
          suppressClickUntil = 0;
        }
      },
      true // Captura prioritaria antes de disparar la galería
    );

    // Delegación de clics para acordeón y botón de apertura de galería
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Apertura de galería modal (evita colapsar el acordeón)
      const galleryBtn = target.closest('[data-open-gallery]') as HTMLElement | null;
      if (galleryBtn) {
        e.stopPropagation();
        e.preventDefault();
        const payloadStr = galleryBtn.getAttribute('data-open-gallery');
        if (payloadStr) {
          try {
            const data = JSON.parse(payloadStr);
            if ((window as any).openDishGallery) {
              (window as any).openDishGallery(data);
            } else {
              window.dispatchEvent(new CustomEvent('open-dish-gallery', { detail: data }));
            }
          } catch (err) {
            console.error('Error al abrir la galería:', err);
          }
        }
        return;
      }

      // Despliegue de acordeón (solo para elementos interactivos con fotos)
      const summary = target.closest('.menu-dish-summary.is-interactive') as HTMLElement | null;
      if (summary) {
        const card = summary.closest('.menu-dish-card');
        if (card) {
          const isOpen = card.classList.toggle('is-expanded');
          summary.setAttribute('aria-expanded', String(isOpen));
        }
      }
    });

    // Accesibilidad mediante teclado
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const target = e.target as HTMLElement | null;
        if (target && target.classList.contains('menu-dish-summary') && target.classList.contains('is-interactive')) {
          e.preventDefault();
          const card = target.closest('.menu-dish-card');
          if (card) {
            const isOpen = card.classList.toggle('is-expanded');
            target.setAttribute('aria-expanded', String(isOpen));
          }
        }
      }
    });

    // Controlador de tooltips de favoritos (aparece 3 segundos y luego se oculta automáticamente)
    function initFavoriteBadges() {
      const badges = document.querySelectorAll<HTMLElement>('[data-favorite-badge]');
      if (!badges.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const badge = entry.target as HTMLElement;
              if (!badge.dataset.tooltipShown) {
                badge.dataset.tooltipShown = 'true';
                badge.classList.add('is-tooltip-visible');
                setTimeout(() => {
                  badge.classList.remove('is-tooltip-visible');
                }, 3000);
              }
            }
          });
        },
        { threshold: 0.3 }
      );

      badges.forEach((badge) => {
        observer.observe(badge);

        badge.addEventListener('click', (e) => {
          e.stopPropagation();
          badge.classList.add('is-tooltip-visible');
          if ((badge as any)._timeout) clearTimeout((badge as any)._timeout);
          (badge as any)._timeout = setTimeout(() => {
            badge.classList.remove('is-tooltip-visible');
          }, 3000);
        });
      });
    }

    initFavoriteBadges();
  }

  setupDishAccordions();
  document.addEventListener('DOMContentLoaded', setupDishAccordions);
  document.addEventListener('astro:page-load', setupDishAccordions);
</script>
