---
interface Props {
  categorias: Array<{ id: string; nombre: string }>;
}

const { categorias } = Astro.props;
---

<nav class="interactive-menu-nav" id="interactive-menu-nav" aria-label="Búsqueda y filtros de la carta">
  <div class="container">
    <div class="interactive-menu-nav__wrapper">
      <!-- Fila 1: Barra de búsqueda en tiempo real + Contador de resultados -->
      <div class="interactive-search-row">
        <div class="search-input-container">
          <input
            type="search"
            id="menu-live-search"
            class="search-live-input"
            placeholder="Buscar por plato o ingrediente..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Buscar plato en la carta"
          />
          <button
            type="button"
            id="clear-search-btn"
            class="clear-search-btn"
            aria-label="Borrar búsqueda"
            title="Borrar búsqueda"
          >
            &times;
          </button>
        </div>

        <div class="filter-results-badge" id="filter-results-badge" aria-live="polite">
          <span id="results-count-text">Cargando carta...</span>
        </div>
      </div>

      <!-- Fila 2: Selector interactivo de categorías (Filtros por texto y espacio negativo) -->
      <div class="category-filter-strip-container">
        <div
          class="category-filter-strip"
          id="category-filter-strip"
          role="tablist"
          aria-label="Filtrar por categoría"
        >
          <button
            type="button"
            class="cat-pill is-active"
            data-category-filter="all"
            role="tab"
            aria-selected="true"
          >
            <span>Todos</span>
          </button>
          {categorias.map((cat) => (
            <button
              type="button"
              class="cat-pill"
              data-category-filter={cat.id}
              role="tab"
              aria-selected="false"
            >
              <span>{cat.nombre}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .interactive-menu-nav {
    position: sticky;
    top: var(--header-main-h, 70px);
    z-index: 55;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(10, 37, 64, 0.07);
    box-shadow: 0 4px 18px rgba(5, 20, 35, 0.04);
    padding-block: 0.85rem 0.5rem;
  }

  .interactive-menu-nav__wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  /* -------------------------------------------------------------
     Fila de búsqueda (Limpia, sin íconos redundantes)
     ------------------------------------------------------------- */
  .interactive-search-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    width: 100%;
  }

  .search-input-container {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .search-live-input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.92rem;
    padding: 0.65rem 2.2rem 0.65rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.035);
    color: var(--navy-950);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-live-input:focus {
    outline: none;
    background: #ffffff;
    border-color: rgba(10, 37, 64, 0.15);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .clear-search-btn {
    position: absolute;
    right: 0.75rem;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1;
    display: none;
    place-items: center;
    cursor: pointer;
    transition: color 0.15s ease;
    padding: 0;
  }

  .clear-search-btn:hover {
    color: var(--navy-950);
  }

  .clear-search-btn.is-visible {
    display: grid;
  }

  .filter-results-badge {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  /* -------------------------------------------------------------
     Fila de categorías (Filtros por texto separados por espacio negativo)
     ------------------------------------------------------------- */
  .category-filter-strip-container {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .category-filter-strip {
    display: flex;
    gap: 1.6rem;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.35rem;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    cursor: grab;
    cursor: -webkit-grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .category-filter-strip::-webkit-scrollbar {
    display: none;
  }

  .category-filter-strip.is-dragging {
    cursor: grabbing !important;
    cursor: -webkit-grabbing !important;
    scroll-behavior: auto !important;
  }

  .category-filter-strip.is-dragging .cat-pill {
    cursor: grabbing !important;
    cursor: -webkit-grabbing !important;
    pointer-events: none;
  }

  .cat-pill {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--muted);
    background: transparent;
    border: none;
    padding: 0.25rem 0;
    cursor: pointer;
    transition: color 0.2s ease, opacity 0.2s ease;
    white-space: nowrap;
    position: relative;
    -webkit-user-select: none;
    user-select: none;
  }

  .cat-pill:hover {
    color: var(--navy-950);
  }

  .cat-pill.is-active {
    color: var(--navy-950);
    font-weight: 700;
  }

  .cat-pill.is-active::after {
    content: "";
    position: absolute;
    bottom: -0.35rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--navy-950);
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .interactive-menu-nav {
      padding-block: 0.65rem 0.4rem;
    }

    .interactive-menu-nav__wrapper {
      gap: 0.75rem;
    }

    .interactive-search-row {
      gap: 0.75rem;
    }

    .search-live-input {
      font-size: 0.86rem;
      padding: 0.55rem 2rem 0.55rem 0.9rem;
    }

    .filter-results-badge {
      font-size: 0.75rem;
    }

    .category-filter-strip {
      gap: 1.25rem;
    }

    .cat-pill {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  function setupInteractiveMenu() {
    const searchInput = document.getElementById('menu-live-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const countBadge = document.getElementById('results-count-text');
    const pills = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
    const sections = document.querySelectorAll<HTMLElement>('.menu-section');
    const emptyState = document.getElementById('menu-empty');
    const emptyTitle = emptyState?.querySelector('.menu-empty__title');
    const emptyDesc = emptyState?.querySelector('.menu-empty__desc');
    const resetBtn = document.getElementById('reset-carta-filter');

    if (!sections.length) return;

    // Conteo total de platos en la carta
    const allMenuItems = document.querySelectorAll<HTMLElement>('.menu-item');
    const totalDishes = allMenuItems.length;

    let activeCategory = 'all';
    let searchQuery = '';

    // Normalizador de texto para búsquedas en español (elimina acentos y tildes)
    function normalize(str: string): string {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    function filterDishes() {
      let matchedCount = 0;
      const q = normalize(searchQuery);

      sections.forEach((section) => {
        const sectionId = section.id;
        const isCategoryMatch = activeCategory === 'all' || sectionId === activeCategory;

        if (!isCategoryMatch) {
          section.classList.add('is-hidden');
          return;
        }

        let sectionMatchedItems = 0;

        // Platos individuales de la sección
        const items = section.querySelectorAll<HTMLElement>('.menu-item');
        items.forEach((item) => {
          const name = normalize(item.getAttribute('data-dish-name') || '');
          const desc = normalize(item.getAttribute('data-dish-desc') || '');

          const matchesQuery = q === '' || name.includes(q) || desc.includes(q);

          if (matchesQuery) {
            item.classList.remove('is-hidden');
            sectionMatchedItems++;
            matchedCount++;
          } else {
            item.classList.add('is-hidden');
          }
        });

        // Plato destacado con foto dentro de la sección (si existe)
        const feature = section.querySelector<HTMLElement>('.menu-feature');
        if (feature) {
          const fName = normalize(feature.getAttribute('data-dish-name') || '');
          const fDesc = normalize(feature.getAttribute('data-dish-desc') || '');
          const featureMatches = q === '' || fName.includes(q) || fDesc.includes(q);

          if (featureMatches) {
            feature.classList.remove('is-hidden');
            sectionMatchedItems++;
            if (q !== '') matchedCount++;
          } else {
            feature.classList.add('is-hidden');
          }
        }

        // Subgrupos de platos (ej: pescados específicos o acompañamientos)
        const subgroups = section.querySelectorAll<HTMLElement>('.menu-subgroup');
        subgroups.forEach((sg) => {
          const hasVisible = sg.querySelectorAll('.menu-item:not(.is-hidden)').length > 0;
          if (hasVisible) {
            sg.classList.remove('is-hidden');
          } else {
            sg.classList.add('is-hidden');
          }
        });

        // Mostrar u ocultar la sección completa según sus resultados
        if (sectionMatchedItems > 0) {
          section.classList.remove('is-hidden');
          section.querySelectorAll<HTMLElement>('.menu-item:not(.is-hidden)').forEach((el) => {
            el.classList.add('is-in-view', 'is-visible');
          });
        } else {
          section.classList.add('is-hidden');
        }
      });

      // Actualizar el contador en vivo
      if (countBadge) {
        if (activeCategory === 'all' && q === '') {
          countBadge.textContent = `${totalDishes} platos disponibles`;
        } else if (q !== '') {
          countBadge.textContent = `${matchedCount} resultado${matchedCount === 1 ? '' : 's'}`;
        } else {
          countBadge.textContent = `${matchedCount} plato${matchedCount === 1 ? '' : 's'}`;
        }
      }

      // Estado vacío
      if (emptyState) {
        if (matchedCount === 0) {
          emptyState.classList.add('is-visible');
          if (emptyTitle) {
            emptyTitle.textContent = q !== '' 
              ? `No encontramos platos con "${searchQuery}"`
              : 'No hay platos disponibles en esta categoría';
          }
          if (emptyDesc) {
            emptyDesc.textContent = q !== ''
              ? 'Verifica la ortografía o intenta con palabras como camarón, arroz, cazuela o pescado.'
              : 'Puedes seleccionar "Todos los platos" para explorar el resto de nuestra carta.';
          }
        } else {
          emptyState.classList.remove('is-visible');
        }
      }
    }

    // Calcula la posición de scroll exacta donde header + barra de categorías quedan perfectamente acoplados en el top
    function getDockScrollY(): number {
      const hero = document.querySelector('.page-hero') as HTMLElement | null;
      const header = document.getElementById('site-header');
      if (!hero) return 0;
      const headerH = header ? header.getBoundingClientRect().height : 70;
      const heroRect = hero.getBoundingClientRect();
      const heroBottomDoc = heroRect.top + window.scrollY + hero.offsetHeight;
      return Math.max(0, Math.round(heroBottomDoc - headerH));
    }

    // Mantiene o acopla la vista en el top sin saltos bruscos
    function alignToStickyNav() {
      const dockY = getDockScrollY();
      // Si el usuario ya está con el header y barra de categorías en el top (tolerancia +-16px),
      // no forzamos scroll para que el contenido cambie 100% en sitio sin movimientos ni subidas al hero
      const isAlreadyDocked = Math.abs(window.scrollY - dockY) <= 16;
      if (!isAlreadyDocked) {
        window.scrollTo({
          top: dockY,
          behavior: 'smooth',
        });
      }
    }

    // Listener para los botones de píldoras de categoría
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category-filter') || 'all';
        activeCategory = cat;

        pills.forEach((p) => {
          const isActive = p === pill;
          p.classList.toggle('is-active', isActive);
          p.setAttribute('aria-selected', String(isActive));
        });

        // Desplazamiento horizontal suave exclusivamente dentro de la tira de categorías
        const strip = document.getElementById('category-filter-strip');
        if (strip) {
          const pillLeft = pill.offsetLeft;
          const pillWidth = pill.offsetWidth;
          const stripWidth = strip.offsetWidth;
          strip.scrollTo({
            left: Math.max(0, pillLeft - (stripWidth / 2) + (pillWidth / 2)),
            behavior: 'smooth',
          });
        }

        filterDishes();
        alignToStickyNav();
      });
    });

    // Soporte de arrastre con clic (drag-to-scroll) y rueda para PC en la barra de categorías
    const catStrip = document.getElementById('category-filter-strip');
    if (catStrip && !(catStrip as any).__dragBound) {
      (catStrip as any).__dragBound = true;
      let isDragging = false;
      let startX = 0;
      let scrollLeft = 0;
      let hasDragged = false;
      let suppressClickUntil = 0;

      catStrip.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        isDragging = true;
        startX = e.pageX;
        scrollLeft = catStrip.scrollLeft;
        hasDragged = false;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.pageX - startX;
        if (!hasDragged && Math.abs(dx) > 4) {
          hasDragged = true;
          catStrip.classList.add('is-dragging');
        }
        if (hasDragged) {
          e.preventDefault();
          catStrip.scrollLeft = scrollLeft - dx;
        }
      });

      function endCatDrag() {
        if (!isDragging) return;
        isDragging = false;
        if (hasDragged) {
          suppressClickUntil = Date.now() + 150;
        }
        catStrip?.classList.remove('is-dragging');
      }

      window.addEventListener('mouseup', endCatDrag);
      window.addEventListener('blur', endCatDrag);

      catStrip.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          const maxScroll = catStrip.scrollWidth - catStrip.clientWidth;
          if (maxScroll > 0) {
            const canLeft = catStrip.scrollLeft > 0 && e.deltaY < 0;
            const canRight = catStrip.scrollLeft < maxScroll - 1 && e.deltaY > 0;
            if (canLeft || canRight) {
              e.preventDefault();
              catStrip.scrollLeft += e.deltaY;
            }
          }
        }
      }, { passive: false });

      catStrip.addEventListener('click', (e) => {
        if (Date.now() < suppressClickUntil) {
          e.stopPropagation();
          e.preventDefault();
          suppressClickUntil = 0;
        }
      }, true);
    }

    // Listener para el buscador en tiempo real
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        if (clearBtn) {
          clearBtn.classList.toggle('is-visible', searchQuery.trim().length > 0);
        }
        filterDishes();
      });
    }

    // Botón para limpiar búsqueda
    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.classList.remove('is-visible');
        searchInput.focus();
        filterDishes();
      });
    }

    // Botón de restablecer desde el estado vacío
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
        }
        if (clearBtn) {
          clearBtn.classList.remove('is-visible');
        }
        activeCategory = 'all';
        pills.forEach((p) => {
          const isAll = p.getAttribute('data-category-filter') === 'all';
          p.classList.toggle('is-active', isAll);
          p.setAttribute('aria-selected', String(isAll));
        });
        filterDishes();
        alignToStickyNav();
      });
    }

    // Inicializar carta
    filterDishes();
  }

  // Soporte para carga normal y ClientRouter de Astro
  document.addEventListener('DOMContentLoaded', setupInteractiveMenu);
  document.addEventListener('astro:page-load', setupInteractiveMenu);
</script>
