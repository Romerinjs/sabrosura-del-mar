---
// Componente Modal Lightbox Ultra Mínimo
// Al hacer clic en una foto: se muestra ÚNICAMENTE la imagen en pantalla completa,
// el botón flotante de cerrar (X) en la esquina superior derecha y la tira de imágenes debajo.
// Sin tarjetas, sin encabezados, sin contadores ni cuadros de texto.
---

<div
  id="dish-lightbox-modal"
  class="dish-lightbox"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <!-- Telón de fondo con desenfoque de cristal -->
  <div class="dish-lightbox__backdrop" id="dish-lightbox-backdrop"></div>

  <!-- Botón flotante único de cerrar (X) -->
  <button
    type="button"
    id="dish-lightbox-close"
    class="dish-lightbox__close-btn"
    aria-label="Cerrar (Escape)"
    title="Cerrar (Esc)"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Escenario principal sin contenedor ni tarjeta -->
  <div class="dish-lightbox__content">
    <div class="dish-lightbox__stage">
      <!-- Botón Anterior discreto -->
      <button
        type="button"
        id="dish-lightbox-prev"
        class="dish-lightbox__nav-btn dish-lightbox__nav-btn--prev"
        aria-label="Foto anterior"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Fotografía principal libre -->
      <div class="dish-lightbox__image-frame" id="dish-lightbox-frame">
        <img
          id="dish-lightbox-img"
          src=""
          alt=""
          decoding="async"
          class="dish-lightbox__image"
        />
        <div id="dish-lightbox-spinner" class="dish-lightbox__spinner" aria-hidden="true"></div>
      </div>

      <!-- Botón Siguiente discreto -->
      <button
        type="button"
        id="dish-lightbox-next"
        class="dish-lightbox__nav-btn dish-lightbox__nav-btn--next"
        aria-label="Foto siguiente"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Las demás imágenes directamente debajo -->
    <div class="dish-lightbox__thumbs-wrap">
      <div class="dish-lightbox__thumbs" id="dish-lightbox-thumbs-container"></div>
    </div>
  </div>
</div>

<style>
  .dish-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: grid;
    place-items: center;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .dish-lightbox.is-active {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .dish-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 10, 18, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Botón flotante limpio de cerrar en la esquina superior derecha */
  .dish-lightbox__close-btn {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 100;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background-color 0.2s, transform 0.2s, color 0.2s;
  }

  .dish-lightbox__close-btn:hover {
    background: #ffffff;
    color: #000000;
    transform: scale(1.08);
  }

  /* Contenido sin tarjetas ni marcos */
  .dish-lightbox__content {
    position: relative;
    z-index: 10;
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: clamp(1rem, 3vw, 2.5rem);
    box-sizing: border-box;
  }

  .dish-lightbox__stage {
    position: relative;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dish-lightbox__image-frame {
    position: relative;
    max-width: min(92vw, 1200px);
    max-height: min(78vh, 850px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dish-lightbox__image {
    max-width: 100%;
    max-height: min(78vh, 850px);
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
    transition: opacity 0.2s ease;
  }

  .dish-lightbox__image.is-switching {
    opacity: 0.25;
  }

  .dish-lightbox__spinner {
    position: absolute;
    width: 36px;
    height: 36px;
    border: 3px solid rgba(255, 255, 255, 0.2);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: lightbox-spin 0.75s linear infinite;
    display: none;
  }

  .dish-lightbox__image-frame.is-loading .dish-lightbox__spinner {
    display: block;
  }

  @keyframes lightbox-spin {
    to { transform: rotate(360deg); }
  }

  /* Botones de navegación discretos */
  .dish-lightbox__nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 15;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color 0.2s, transform 0.2s;
  }

  .dish-lightbox__nav-btn:hover {
    background: rgba(255, 255, 255, 0.9);
    color: #000000;
    transform: translateY(-50%) scale(1.08);
  }

  .dish-lightbox__nav-btn--prev { left: clamp(0.5rem, 2vw, 2rem); }
  .dish-lightbox__nav-btn--next { right: clamp(0.5rem, 2vw, 2rem); }

  /* Tira inferior de miniaturas justo debajo de la imagen */
  .dish-lightbox__thumbs-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
    padding-top: 0.5rem;
    flex-shrink: 0;
  }

  .dish-lightbox__thumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    max-width: 90vw;
    padding: 0.2rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .dish-lightbox__thumbs::-webkit-scrollbar {
    display: none;
  }

  :global(.dish-lightbox-thumb-btn) {
    flex: 0 0 52px;
    height: 42px;
    border-radius: 6px;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    background: rgba(0, 0, 0, 0.4);
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.2s, border-color 0.2s, transform 0.2s;
  }

  :global(.dish-lightbox-thumb-btn:hover) {
    opacity: 0.85;
    transform: scale(1.05);
  }

  :global(.dish-lightbox-thumb-btn.is-active) {
    opacity: 1;
    border-color: #ffffff;
    transform: scale(1.08);
  }

  :global(.dish-lightbox-thumb-btn img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 640px) {
    .dish-lightbox__close-btn {
      top: 0.85rem;
      right: 0.85rem;
      width: 38px;
      height: 38px;
    }
    .dish-lightbox__nav-btn {
      width: 38px;
      height: 38px;
    }
    :global(.dish-lightbox-thumb-btn) {
      flex: 0 0 44px;
      height: 36px;
    }
  }
</style>

<script>
  interface GalleryPayload {
    dishName?: string;
    photos: string[];
    thumbs?: string[];
    startIndex?: number;
  }

  let activePhotos: string[] = [];
  let activeThumbs: string[] = [];
  let currentIndex = 0;

  const modal = document.getElementById('dish-lightbox-modal') as HTMLElement | null;
  const backdrop = document.getElementById('dish-lightbox-backdrop');
  const closeBtn = document.getElementById('dish-lightbox-close');
  const prevBtn = document.getElementById('dish-lightbox-prev');
  const nextBtn = document.getElementById('dish-lightbox-next');
  const imgEl = document.getElementById('dish-lightbox-img') as HTMLImageElement | null;
  const frameEl = document.getElementById('dish-lightbox-frame');
  const thumbsContainer = document.getElementById('dish-lightbox-thumbs-container');

  function updateImage() {
    if (!imgEl || activePhotos.length === 0) return;

    imgEl.classList.add('is-switching');
    frameEl?.classList.add('is-loading');

    const targetSrc = activePhotos[currentIndex];

    const tempImg = new Image();
    tempImg.src = targetSrc;
    tempImg.onload = () => {
      if (imgEl) {
        imgEl.src = targetSrc;
        imgEl.classList.remove('is-switching');
        frameEl?.classList.remove('is-loading');
      }
    };
    tempImg.onerror = () => {
      if (imgEl) {
        imgEl.src = targetSrc;
        imgEl.classList.remove('is-switching');
        frameEl?.classList.remove('is-loading');
      }
    };

    if (thumbsContainer) {
      const allThumbBtns = thumbsContainer.querySelectorAll('.dish-lightbox-thumb-btn');
      allThumbBtns.forEach((btn, idx) => {
        if (idx === currentIndex) {
          btn.classList.add('is-active');
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          btn.classList.remove('is-active');
        }
      });
    }
  }

  function renderThumbs() {
    if (!thumbsContainer) return;
    thumbsContainer.innerHTML = '';

    if (activePhotos.length <= 1) {
      thumbsContainer.style.display = 'none';
      return;
    }
    thumbsContainer.style.display = 'flex';

    activePhotos.forEach((photoUrl, idx) => {
      const thumbUrl = (activeThumbs && activeThumbs[idx]) ? activeThumbs[idx] : photoUrl;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `dish-lightbox-thumb-btn ${idx === currentIndex ? 'is-active' : ''}`;

      const thumbImg = document.createElement('img');
      thumbImg.src = thumbUrl;
      thumbImg.alt = '';
      thumbImg.loading = 'lazy';
      thumbImg.decoding = 'async';

      btn.appendChild(thumbImg);
      btn.addEventListener('click', () => {
        currentIndex = idx;
        updateImage();
      });

      thumbsContainer.appendChild(btn);
    });
  }

  function openGallery(data: GalleryPayload) {
    if (!modal || !data.photos || data.photos.length === 0) return;

    activePhotos = data.photos;
    activeThumbs = data.thumbs || [];
    currentIndex = data.startIndex || 0;

    renderThumbs();
    updateImage();

    modal.classList.add('is-active');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeGallery() {
    if (!modal) return;
    modal.classList.remove('is-active');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function nextPhoto() {
    if (activePhotos.length <= 1) return;
    currentIndex = (currentIndex + 1) % activePhotos.length;
    updateImage();
  }

  function prevPhoto() {
    if (activePhotos.length <= 1) return;
    currentIndex = (currentIndex - 1 + activePhotos.length) % activePhotos.length;
    updateImage();
  }

  closeBtn?.addEventListener('click', closeGallery);
  backdrop?.addEventListener('click', closeGallery);
  nextBtn?.addEventListener('click', nextPhoto);
  prevBtn?.addEventListener('click', prevPhoto);

  document.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('is-active')) return;
    if (e.key === 'Escape') closeGallery();
    else if (e.key === 'ArrowRight') nextPhoto();
    else if (e.key === 'ArrowLeft') prevPhoto();
  });

  let touchStartX = 0;
  let touchEndX = 0;

  frameEl?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  frameEl?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 45) {
      if (diff > 0) nextPhoto();
      else prevPhoto();
    }
  }, { passive: true });

  (window as any).openDishGallery = openGallery;
  window.addEventListener('open-dish-gallery', ((e: CustomEvent<GalleryPayload>) => {
    if (e.detail) openGallery(e.detail);
  }) as EventListener);
</script>
