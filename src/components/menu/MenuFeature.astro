---
import Icon from '../icons/Icon.astro';

interface Props {
  feature: {
    nombre: string;
    descripcion: string;
    precio: number;
    precioNota?: string;
    imagen?: string | null;
    alt?: string;
    pendienteFoto?: boolean;
  };
}

const { feature: f } = Astro.props;
const money = (n: number) => '$' + n.toLocaleString('es-CO');
---

<div class="menu-feature" data-dish-name={f.nombre} data-dish-desc={f.descripcion}>
  {f.imagen ? (
    <div class="menu-feature__media">
      <img src={f.imagen} alt={f.alt || f.nombre} width="480" height="320" loading="lazy" />
      <span class="menu-feature__img-tag">Recomendado</span>
    </div>
  ) : (
    <div class="dish__media dish__media--placeholder" style="min-height:180px">
      <div class="ph-inner">
        <Icon name="camera" size={30} />
        <b>{f.nombre}</b>
        <small>Foto pendiente</small>
      </div>
    </div>
  )}

  <div class="menu-feature__body">
    <div class="menu-feature__tag-wrap">
      <span class="menu-feature__chef-tag">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        Recomendado del chef
      </span>
    </div>
    <h3>{f.nombre}</h3>
    <p>{f.descripcion}</p>

    <div class="menu-feature__bottom-row">
      <div class="menu-feature__price">
        <span class="menu-feature__price-amount">{money(f.precio)}</span>
        {f.precioNota && (
          <span class="menu-feature__price-note">
            · {f.precioNota}
          </span>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .menu-feature__media {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 190px;
  }

  .menu-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .menu-feature:hover .menu-feature__media img {
    transform: scale(1.06);
    filter: brightness(1.025);
  }

  .menu-feature__img-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(7, 31, 56, 0.88);
    color: var(--gold-400, #e2a842);
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.22rem 0.62rem;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    border: 1px solid rgba(226, 168, 66, 0.4);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    z-index: 2;
  }

  .menu-feature__tag-wrap {
    margin-bottom: 0.45rem;
  }

  .menu-feature__chef-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(226, 168, 66, 0.15);
    color: #9a6500;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(226, 168, 66, 0.35);
  }

  .menu-feature__chef-tag svg {
    color: var(--gold-500, #d97706);
  }

  .menu-feature__bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line, #e2e8f0);
    flex-wrap: wrap;
  }

  .menu-feature__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .menu-feature__price-amount {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--teal-700, #0e5a72);
    letter-spacing: -0.01em;
  }

  .menu-feature__price-note {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted, #64748b);
  }

</style>

