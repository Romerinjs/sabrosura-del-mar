---
import Icon from '../icons/Icon.astro';

interface Props {
  feature: {
    nombre: string;
    descripcion: string;
    precio: number;
    precioNota?: string;
    imagen?: string | null;
    alt?: string;
    pendienteFoto?: boolean;
  };
}

const { feature: f } = Astro.props;
const money = (n: number) => '$' + n.toLocaleString('es-CO');
---

<div class="menu-feature" data-dish-name={f.nombre} data-dish-desc={f.descripcion}>
  {f.imagen ? (
    <div class="menu-feature__media">
      <img src={f.imagen} alt={f.alt || f.nombre} width="480" height="320" loading="lazy" />
      <span class="menu-feature__img-tag">Recomendado</span>
    </div>
  ) : (
    <div class="dish__media dish__media--placeholder" style="min-height:180px">
      <div class="ph-inner">
        <Icon name="camera" size={30} />
        <b>{f.nombre}</b>
        <small>Foto pendiente</small>
      </div>
    </div>
  )}

  <div class="menu-feature__body">
    <div class="menu-feature__tag-wrap">
      <span class="menu-feature__chef-tag">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        Recomendado del chef
      </span>
    </div>
    <h3>{f.nombre}</h3>
    <p>{f.descripcion}</p>

    <div class="menu-feature__bottom-row">
      <div class="menu-feature__price">
        <span class="menu-feature__price-amount">{money(f.precio)}</span>
        {f.precioNota && (
          <span class="menu-feature__price-note">
            · {f.precioNota}
          </span>
        )}
      </div>

      <button
        type="button"
        class="menu-feature__order-btn"
        data-dish-add
        data-dish-name={f.nombre}
        data-dish-price={f.precio || 0}
        data-track-event="add_dish_to_bag"
        data-track-product={f.nombre}
        data-track-location="menu_feature"
        title={`Añadir ${f.nombre} a mi pedido`}
        aria-label={`Añadir ${f.nombre} a mi pedido`}
      >
        <span class="btn-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </span>
        <span class="btn-text">Añadir a mi pedido</span>
        <span class="btn-check-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
      </button>
    </div>
  </div>
</div>

<style>
  .menu-feature__media {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 190px;
  }

  .menu-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .menu-feature:hover .menu-feature__media img {
    transform: scale(1.03);
  }

  .menu-feature__img-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(7, 31, 56, 0.88);
    color: var(--gold-400, #e2a842);
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.22rem 0.62rem;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    border: 1px solid rgba(226, 168, 66, 0.4);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    z-index: 2;
  }

  .menu-feature__tag-wrap {
    margin-bottom: 0.45rem;
  }

  .menu-feature__chef-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(226, 168, 66, 0.15);
    color: #9a6500;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(226, 168, 66, 0.35);
  }

  .menu-feature__chef-tag svg {
    color: var(--gold-500, #d97706);
  }

  .menu-feature__bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line, #e2e8f0);
    flex-wrap: wrap;
  }

  .menu-feature__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .menu-feature__price-amount {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--teal-700, #0e5a72);
    letter-spacing: -0.01em;
  }

  .menu-feature__price-note {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted, #64748b);
  }

  /* -------------------------------------------------------------
     Botón Moderno Interactivo para Plato Recomendado
     ------------------------------------------------------------- */
  .menu-feature__order-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.56rem 1.25rem;
    background: linear-gradient(135deg, #071f38 0%, #0a2e52 48%, #0e5a72 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 750;
    border: 1.5px solid var(--gold-400, #e2a842);
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(5, 20, 35, 0.25), 0 0 10px rgba(226, 168, 66, 0.22);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.22s ease,
                background-color 0.22s ease,
                border-color 0.22s ease;
    white-space: nowrap;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    text-decoration: none;
  }

  /* Reflejo / Destello deslizante suave al pasar el cursor */
  .menu-feature__order-btn::before {
    content: "";
    position: absolute;
    top: 0;
    left: -80%;
    width: 55%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.28),
      transparent
    );
    transform: skewX(-22deg);
    transition: left 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .menu-feature__order-btn:hover {
    background: linear-gradient(135deg, #0a2e52 0%, #0e5a72 55%, #13718c 100%);
    border-color: var(--gold-300, #f6c86a);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 22px rgba(5, 20, 35, 0.32), 0 0 16px rgba(226, 168, 66, 0.42);
    color: #ffffff;
  }

  .menu-feature__order-btn:hover::before {
    left: 135%;
  }

  .menu-feature__order-btn:active {
    transform: translateY(0) scale(0.96);
    box-shadow: 0 2px 6px rgba(5, 20, 35, 0.25);
  }

  .menu-feature__order-btn .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.26s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    color: var(--gold-400, #e2a842);
  }

  .menu-feature__order-btn:hover .btn-icon {
    transform: rotate(90deg) scale(1.15);
    color: #ffffff;
  }

  .menu-feature__order-btn .btn-check-icon {
    display: none;
  }

  /* Estado dinámico ¡Añadido! con feedback táctil y checkmark */
  .menu-feature__order-btn.is-added {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
    border-color: #6ee7b7 !important;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.5) !important;
    transform: scale(1.03);
    color: #ffffff !important;
  }

  .menu-feature__order-btn.is-added .btn-icon {
    display: none;
  }

  .menu-feature__order-btn.is-added .btn-check-icon {
    display: inline-flex;
    animation: checkPop 0.28s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    color: #ffffff;
  }

  @keyframes checkPop {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }

  @media (max-width: 520px) {
    .menu-feature__bottom-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.65rem;
    }

    .menu-feature__order-btn {
      width: 100%;
      padding: 0.58rem 1rem;
      font-size: 0.83rem;
    }
  }
</style>

