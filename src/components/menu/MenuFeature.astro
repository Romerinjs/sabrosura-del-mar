---
import Icon from '../icons/Icon.astro';
import { getDishGallery } from '../../utils/dishMatcher';

interface Props {
  feature: {
    nombre: string;
    descripcion: string;
    precio: number;
    precioNota?: string;
    imagen?: string | null;
    alt?: string;
    pendienteFoto?: boolean;
  };
}

const { feature: f } = Astro.props;
const gallery = getDishGallery(f.nombre);
const photoSrc = gallery?.cover || f.imagen || null;
const hasGallery = !!(gallery && gallery.photos.length > 0);
const money = (n: number) => '$' + n.toLocaleString('es-CO');
---

<div class="menu-feature" data-dish-name={f.nombre} data-dish-desc={f.descripcion}>
  {photoSrc ? (
    <div
      class={`menu-feature__media ${hasGallery ? 'is-clickable' : ''}`}
      data-open-gallery={hasGallery ? JSON.stringify({
        dishName: f.nombre,
        photos: gallery.photos,
        thumbs: gallery.thumbs,
        startIndex: 0
      }) : undefined}
      title={hasGallery ? `Toca para ver galería de ${f.nombre}` : f.nombre}
      role={hasGallery ? 'button' : undefined}
      tabindex={hasGallery ? 0 : undefined}
    >
      <img
        src={photoSrc}
        alt={f.alt || f.nombre}
        width="480"
        height="320"
        loading="lazy"
        decoding="async"
      />
      {hasGallery && (
        <span class="menu-feature__gallery-pill">
          {gallery.totalPhotos} fotos
        </span>
      )}
    </div>
  ) : (
    <div class="dish__media dish__media--placeholder" style="min-height:180px">
      <div class="ph-inner">
        <b>{f.nombre}</b>
      </div>
    </div>
  )}

  <div class="menu-feature__body">
    <div class="menu-feature__tag-wrap">
      <span class="menu-feature__chef-tag">
        Especialidad recomendada
      </span>
    </div>
    <h3>{f.nombre}</h3>
    <p>{f.descripcion}</p>

    <div class="menu-feature__bottom-row">
      <div class="menu-feature__price">
        <span class="menu-feature__price-amount">{money(f.precio)}</span>
        {f.precioNota && (
          <span class="menu-feature__price-note">
            · {f.precioNota}
          </span>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .menu-feature__media {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 190px;
    border-radius: 12px;
  }

  .menu-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .menu-feature:hover .menu-feature__media img {
    transform: scale(1.04);
  }

  .menu-feature__media.is-clickable {
    cursor: pointer;
  }

  .menu-feature__gallery-pill {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(7, 31, 56, 0.85);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    z-index: 2;
    transition: background-color 0.25s, color 0.25s;
  }

  .menu-feature__tag-wrap {
    margin-bottom: 0.45rem;
  }

  .menu-feature__chef-tag {
    display: inline-block;
    color: var(--gold-600, #b45309);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .menu-feature__bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-top: 1.2rem;
    flex-wrap: wrap;
  }

  .menu-feature__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .menu-feature__price-amount {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--teal-700, #0e5a72);
    letter-spacing: -0.01em;
  }

  .menu-feature__price-note {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted, #64748b);
  }

</style>

