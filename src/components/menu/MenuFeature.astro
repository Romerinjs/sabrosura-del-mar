---
import Icon from '../icons/Icon.astro';
import { getDishGallery } from '../../utils/dishMatcher';

interface Props {
  feature: {
    nombre: string;
    descripcion: string;
    precio: number;
    precioNota?: string;
    imagen?: string | null;
    alt?: string;
    pendienteFoto?: boolean;
  };
}

const { feature: f } = Astro.props;
const gallery = getDishGallery(f.nombre);
const photoSrc = gallery?.cover || f.imagen || null;
const hasGallery = !!(gallery && gallery.photos.length > 0);
const money = (n: number) => '$' + n.toLocaleString('es-CO');
---

<div class="menu-feature" data-dish-name={f.nombre} data-dish-desc={f.descripcion}>
  {photoSrc ? (
    <div
      class={`menu-feature__media ${hasGallery ? 'is-clickable' : ''}`}
      data-open-gallery={hasGallery ? JSON.stringify({
        dishName: f.nombre,
        photos: gallery.photos,
        thumbs: gallery.thumbs,
        startIndex: 0
      }) : undefined}
      title={hasGallery ? `Toca para ver galería de ${f.nombre}` : f.nombre}
      role={hasGallery ? 'button' : undefined}
      tabindex={hasGallery ? 0 : undefined}
    >
      <img
        src={photoSrc}
        alt={f.alt || f.nombre}
        width="480"
        height="320"
        loading="lazy"
        decoding="async"
      />
      <div class="menu-feature__badge-pill" aria-label="Plato 5 estrellas">
        <span class="menu-feature__stars" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </span>
      </div>
    </div>
  ) : (
    <div class="menu-feature__placeholder dish__media--placeholder">
      <div class="ph-inner">
        <b>{f.nombre}</b>
      </div>
    </div>
  )}

  <div class="menu-feature__body">
    <div class="menu-feature__tag-wrap">
      <span class="menu-feature__chef-tag">
        Especialidad recomendada
      </span>
    </div>
    <h3>{f.nombre}</h3>
    <p>{f.descripcion}</p>

    <div class="menu-feature__bottom-row">
      <div class="menu-feature__price">
        <span class="menu-feature__price-amount">{money(f.precio)}</span>
        {f.precioNota && (
          <span class="menu-feature__price-note">
            · {f.precioNota}
          </span>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .menu-feature {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 1.25rem 0 1.5rem;
    border-radius: var(--radius, 14px);
    overflow: hidden;
    border: 1px solid var(--line, #e2e8f0);
    box-shadow: 0 4px 16px -2px rgba(10, 37, 64, 0.06);
    background: #ffffff;
    max-width: 100%;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .menu-feature:hover {
    box-shadow: 0 8px 24px -4px rgba(10, 37, 64, 0.1);
  }

  @media (min-width: 640px) {
    .menu-feature {
      grid-template-columns: 240px 1fr;
      height: 180px;
      max-height: 180px;
      align-items: stretch;
    }
  }

  .menu-feature__media {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 220px;
    background: var(--sand, #f8f6f0);
    isolation: isolate;
  }

  @media (min-width: 640px) {
    .menu-feature__media {
      aspect-ratio: auto;
      width: 240px;
      height: 100%;
      min-height: 180px;
      max-height: 180px;
    }
  }

  .menu-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1);
    transition: transform 2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .menu-feature:hover .menu-feature__media img {
    transform: scale(1.05);
  }

  .menu-feature__media.is-clickable {
    cursor: pointer;
  }

  .menu-feature__badge-pill {
    position: absolute;
    bottom: 0.65rem;
    right: 0.65rem;
    background: rgba(7, 31, 56, 0.52);
    border: 1px solid rgba(255, 215, 0, 0.4);
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 2;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.22);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: none;
  }

  .menu-feature__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: #ffc700;
  }

  .menu-feature__stars svg {
    display: block;
    filter: drop-shadow(0 0 3.5px rgba(255, 199, 0, 0.8)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
  }

  .menu-feature__body {
    padding: 1.1rem 1.25rem 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  @media (min-width: 640px) {
    .menu-feature__body {
      padding: 1.15rem 1.4rem;
      height: 100%;
      justify-content: space-between;
      overflow: hidden;
    }

    .menu-feature__body p {
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  .menu-feature__tag-wrap {
    margin-bottom: 0.35rem;
  }

  .menu-feature__chef-tag {
    display: inline-block;
    color: var(--gold-600, #b45309);
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .menu-feature__body h3 {
    font-family: var(--font-display, serif);
    font-size: 1.22rem;
    font-weight: 700;
    color: var(--navy-900, #071f38);
    margin: 0 0 0.35rem;
    line-height: 1.25;
  }

  .menu-feature__body p {
    font-family: var(--font-body, sans-serif);
    font-size: 0.88rem;
    color: var(--muted, #64748b);
    line-height: 1.45;
    margin: 0 0 0.85rem;
  }

  .menu-feature__bottom-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: auto;
    flex-wrap: wrap;
  }

  .menu-feature__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .menu-feature__price-amount {
    font-family: var(--font-display, serif);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--teal-700, #0e5a72);
    letter-spacing: -0.01em;
  }

  .menu-feature__price-note {
    font-family: var(--font-body, sans-serif);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted, #64748b);
  }

  .menu-feature__placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 220px;
    background: var(--sand, #f8f6f0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted, #64748b);
  }

  @media (min-width: 640px) {
    .menu-feature__placeholder {
      aspect-ratio: auto;
      width: 240px;
      height: 100%;
      min-height: 180px;
      max-height: 180px;
    }
  }
</style>

